---
// The four ideas of Moonkale, from its vault's "Getting started — Moonkale for VS Code and
// Obsidian users", each with a small looping drawing. The drawings start when the step scrolls
// into view (the page's .reveal → .in).
---

<ol class="hiw">
  <li class="step reveal">
    <div class="art" aria-hidden="true">
      <svg viewBox="0 0 220 150">
        <!-- a folder, a database, a remote folder: one graph -->
        <path class="shape" d="M14 22 h20 l5 6 h28 v30 h-53 z"></path>
        <text x="40" y="74" class="tag">folder</text>
        <ellipse class="shape" cx="40" cy="96" rx="22" ry="6"></ellipse>
        <path class="shape open" d="M18 96 v22 a22 6 0 0 0 44 0 v-22"></path>
        <text x="40" y="140" class="tag">database</text>
        <path class="shape dashy" d="M156 22 h20 l5 6 h28 v30 h-53 z"></path>
        <text x="182" y="74" class="tag">over SSH</text>
        <path class="flow" d="M68 42 C 96 42, 98 72, 112 76"></path>
        <path class="flow" d="M64 106 C 92 106, 98 84, 112 80"></path>
        <path class="flow" d="M154 44 C 140 46, 136 70, 128 76"></path>
        <circle class="hub" cx="120" cy="78" r="9"></circle>
        <circle class="dot" cx="104" cy="108" r="3.5"></circle>
        <circle class="dot" cx="140" cy="106" r="3.5"></circle>
        <circle class="dot" cx="122" cy="122" r="3.5"></circle>
        <line class="thin" x1="120" y1="87" x2="104" y2="105"></line>
        <line class="thin" x1="120" y1="87" x2="140" y2="103"></line>
        <line class="thin" x1="120" y1="87" x2="122" y2="118"></line>
      </svg>
    </div>
    <span class="num mono">01</span>
    <h3>Folders and databases are the same kind of thing</h3>
    <p>
      You open <em>sources</em>: a folder, a vault, a SQLite or DuckDB file, a directory of CSVs, a
      graph database, a folder on another machine over SSH. Several at once, side by side, all
      feeding the same graph.
    </p>
  </li>

  <li class="step reveal" style="--d:.06s">
    <div class="art" aria-hidden="true">
      <svg viewBox="0 0 220 150">
        <line class="thin" x1="110" y1="75" x2="60" y2="44"></line>
        <line class="thin" x1="110" y1="75" x2="160" y2="40"></line>
        <line class="thin" x1="110" y1="75" x2="66" y2="114"></line>
        <line class="thin" x1="110" y1="75" x2="164" y2="110"></line>
        <line class="thin" x1="60" y1="44" x2="22" y2="30"></line>
        <line class="thin" x1="160" y1="40" x2="198" y2="22"></line>
        <line class="thin" x1="164" y1="110" x2="202" y2="128"></line>
        <line class="thin" x1="66" y1="114" x2="26" y2="128"></line>
        <rect class="shape" x="50" y="35" width="20" height="18" rx="3"></rect>
        <circle class="shape filled" cx="160" cy="40" r="6"></circle>
        <circle class="shape" cx="66" cy="114" r="9"></circle>
        <path class="shape" d="M152 102 h24 v16 h-24 z M152 110 h24"></path>
        <circle class="shape filled small" cx="22" cy="30" r="3.5"></circle>
        <circle class="shape filled small" cx="198" cy="22" r="3.5"></circle>
        <circle class="shape filled small" cx="202" cy="128" r="3.5"></circle>
        <circle class="shape filled small" cx="26" cy="128" r="3.5"></circle>
        <circle class="ring" cx="110" cy="75" r="12"></circle>
        <circle class="shape filled" cx="110" cy="75" r="8"></circle>
      </svg>
    </div>
    <span class="num mono">02</span>
    <h3>The graph is the point, not a feature</h3>
    <p>
      Files, the functions and structs inside them, wiki-links between notes, tables of a
      database: one connected graph, GPU-drawn, fine at 100 000 nodes. <em>Local</em> shows two hops
      around the file you are in. Click a node and it opens.
    </p>
  </li>

  <li class="step reveal" style="--d:.12s">
    <div class="art" aria-hidden="true">
      <svg viewBox="0 0 220 150">
        <path class="shape" d="M40 14 h70 l16 16 v104 h-86 z"></path>
        <path class="thin" d="M110 14 v16 h16"></path>
        <line class="txt" x1="52" y1="46" x2="104" y2="46"></line>
        <line class="txt" x1="52" y1="60" x2="114" y2="60"></line>
        <text x="52" y="80" class="mono-s">[[link]]</text>
        <line class="txt" x1="52" y1="94" x2="108" y2="94"></line>
        <text x="52" y="114" class="mono-s">$∫ f$</text>
        <g class="extra">
          <path class="shape dashy" d="M146 70 h18 l5 6 h28 v34 h-51 z"></path>
          <text x="172" y="124" class="tag">.moonkale/</text>
          <text x="172" y="138" class="tag">safe to delete</text>
        </g>
      </svg>
    </div>
    <span class="num mono">03</span>
    <h3>Your vault stays your vault</h3>
    <p>
      Notes are plain Markdown with Obsidian's <code>[[wiki-links]]</code>, front matter and KaTeX.
      Open the folder in Obsidian tomorrow; nothing changed behind your back. What Moonkale adds
      lives in one hidden folder you can delete.
    </p>
  </li>

  <li class="step reveal" style="--d:.18s">
    <div class="art" aria-hidden="true">
      <svg viewBox="0 0 220 150">
        <rect class="shape" x="16" y="16" width="188" height="118" rx="10"></rect>
        <g class="ext e1"><rect class="shape" x="28" y="30" width="50" height="24" rx="5"></rect><text x="53" y="46" class="tag dark">code</text></g>
        <g class="ext e2"><rect class="shape" x="85" y="30" width="50" height="24" rx="5"></rect><text x="110" y="46" class="tag dark">notes</text></g>
        <g class="ext e3"><rect class="shape" x="142" y="30" width="50" height="24" rx="5"></rect><text x="167" y="46" class="tag dark">graph</text></g>
        <g class="ext e4"><rect class="shape" x="28" y="62" width="50" height="24" rx="5"></rect><text x="53" y="78" class="tag dark">terminal</text></g>
        <g class="ext e5"><rect class="shape" x="85" y="62" width="50" height="24" rx="5"></rect><text x="110" y="78" class="tag dark">git</text></g>
        <g class="ext e6"><rect class="shape" x="142" y="62" width="50" height="24" rx="5"></rect><text x="167" y="78" class="tag dark">table</text></g>
        <rect class="shape" x="28" y="96" width="164" height="26" rx="5"></rect>
        <text x="40" y="113" class="tag dark left">agent: edit?</text>
        <g class="allow">
          <rect x="140" y="100" width="44" height="18" rx="9"></rect>
          <text x="162" y="112" class="tag inv">Allow</text>
        </g>
      </svg>
    </div>
    <span class="num mono">04</span>
    <h3>Everything is an extension; the agent is part of the app</h3>
    <p>
      The editors, the terminal, git and the graph are extensions without privileged access, each
      one can be switched off. The agent uses your sources through the same interface as you, and
      edits only after you click <em>Allow</em>.
    </p>
  </li>
</ol>

<style>
  .hiw {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 760px) {
    .hiw {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1120px) {
    .hiw {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .step {
    background: var(--bg);
    padding: 24px 24px 32px;
    display: flex;
    flex-direction: column;
  }
  .art {
    height: 150px;
    margin: 0 -8px 18px;
    color: var(--fg);
  }
  .art svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .num {
    font-size: 12px;
    color: var(--muted);
  }
  .step h3 {
    margin-top: 10px;
    font-size: 20px;
    line-height: 1.2;
  }
  .step p {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 15px;
  }
  .step em {
    font-family: var(--font-serif);
    font-size: 1.1em;
    color: var(--fg);
  }
  .step code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--fg-2);
  }

  /* shared drawing styles */
  .shape {
    fill: var(--bg);
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .shape.open {
    fill: none;
  }
  .shape.filled {
    fill: currentColor;
  }
  .dashy {
    stroke-dasharray: 4 3;
  }
  .thin {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }
  .txt {
    stroke: var(--line-strong);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .dot,
  .hub {
    fill: currentColor;
  }
  .tag,
  .mono-s {
    font-family: var(--font-mono);
    stroke: none;
  }
  .tag {
    font-size: 9.5px;
    letter-spacing: 0.04em;
    fill: var(--muted);
    text-anchor: middle;
  }
  .tag.dark {
    fill: currentColor;
    font-size: 8.5px;
  }
  .tag.left {
    text-anchor: start;
  }
  .tag.inv {
    fill: var(--bg);
  }
  .mono-s {
    font-size: 11px;
    fill: currentColor;
  }

  /* every animation waits until the step is in view */
  .step :is(path, line, rect, circle, text, g) {
    animation-play-state: paused;
  }
  .step.in :is(path, line, rect, circle, text, g) {
    animation-play-state: running;
  }

  /* 01: the sources flow into one graph */
  .flow {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-dasharray: 4 4;
    animation: flow 1.4s linear infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -16;
    }
  }

  /* 02: "Local": a ring reaches out from the open file */
  .ring {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    transform-box: fill-box;
    transform-origin: center;
    animation: ring 2.8s var(--ease) infinite;
  }
  @keyframes ring {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(5.2);
      opacity: 0;
    }
  }

  /* 03: Moonkale's folder comes and goes; the note stays */
  .extra {
    animation: extra 4.4s var(--ease) infinite;
  }
  @keyframes extra {
    0%,
    55% {
      opacity: 1;
    }
    70%,
    90% {
      opacity: 0.12;
    }
    100% {
      opacity: 1;
    }
  }

  /* 04: extensions switch on one by one; Allow waits for a click */
  .ext {
    animation: ext 5s steps(1) infinite;
  }
  .e2 {
    animation-delay: 0.3s;
  }
  .e3 {
    animation-delay: 0.6s;
  }
  .e4 {
    animation-delay: 0.9s;
  }
  .e5 {
    animation-delay: 1.2s;
  }
  .e6 {
    animation-delay: 1.5s;
  }
  @keyframes ext {
    0% {
      opacity: 0.25;
    }
    8%,
    100% {
      opacity: 1;
    }
  }
  .allow rect {
    fill: currentColor;
    stroke: none;
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 1.8s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step :is(path, line, rect, circle, text, g) {
      animation: none !important;
    }
    .ring {
      display: none;
    }
  }
</style>
