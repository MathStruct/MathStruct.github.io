---
import ThemeToggle from "./ThemeToggle.astro"
import Logo from "./Logo.astro"

const links = [
  { href: "#projects", label: "Projects" },
  { href: "#approach", label: "Approach" },
  { href: "/blog/", label: "Blog" },
  { href: "/about", label: "About" },
  { href: "/people/", label: "People" },
]
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href="/" class="brand" aria-label="MathStruct, home">
      <Logo height={26} />
      <span>MathStruct</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="gh" href="https://github.com/MathStruct" aria-label="MathStruct on GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
      <ThemeToggle />
      <details class="menu">
        <summary aria-label="Menu">
          <span></span><span></span>
        </summary>
        <ul class="menu-panel">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href="https://github.com/MathStruct">GitHub</a></li>
        </ul>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease);
  }
  :global(.scrolled) .nav {
    border-bottom-color: var(--line);
  }
  .nav-inner {
    height: 68px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.02em;
  }
  nav {
    margin-left: auto;
  }
  ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 15px;
    color: var(--muted);
    transition:
      color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }
  ul a:hover {
    color: var(--fg);
    background: var(--bg-sunken);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .gh {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    color: var(--fg);
    border: 1px solid var(--line);
    transition: border-color 0.2s var(--ease);
  }
  .gh:hover {
    border-color: var(--line-strong);
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    display: grid;
    place-content: center;
    gap: 5px;
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--fg);
    transition: transform 0.3s var(--ease);
  }
  .menu[open] summary span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .menu[open] summary span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }
  .menu-panel {
    position: absolute;
    right: 0;
    top: 50px;
    min-width: 200px;
    flex-direction: column;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-raised);
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.35);
  }
  .menu-panel a {
    color: var(--fg);
    border-radius: 8px;
  }
  @media (max-width: 760px) {
    nav {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
    .menu {
      display: block;
    }
  }
</style>

<script>
  const set = () => document.documentElement.classList.toggle("scrolled", scrollY > 8)
  addEventListener("scroll", set, { passive: true })
  set()
  // close the mobile menu after following one of its links
  document.querySelectorAll<HTMLAnchorElement>(".menu-panel a").forEach((a) =>
    a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")),
  )
</script>
