---
// The circle example of Lenticulum.jl's README, live: a relation learned from points on a circle,
// queried in any direction. The model drawn here is the closed form the README's example uses
// (a Gaussian mixture on 48 points of the unit circle); its score field points towards the
// circle, and a query clamps some coordinates and follows the field in the others until it
// reaches a stable root. Here that is mean-shift (gradient ascent on the log-density with step
// σ²), which is what the field's stable roots are; Lenticulum itself solves for them with
// Newton's method.
//
//   mode="sweep"        the clamp line sweeps across x on its own (the page's opening picture)
//   mode="interactive"  buttons for the three queries, a draggable clamp line, click to start
interface Props {
  mode?: "sweep" | "interactive"
  label?: string
}
const { mode = "interactive", label } = Astro.props
// The Chinese page (/zh/projects/lenticulum-jl) passes its own label; the remaining strings
// switch with the page (Nav.astro tells the two languages apart the same way).
const zh = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "").startsWith("/zh")
const aria = label ?? (zh ? "从圆上的点习得的关系，可向任意方向查询" : "A relation learned from points on a circle, queried in any direction")
---

<div class:list={["rx", `rx--${mode}`]} data-mode={mode}>
  {
    mode === "interactive" && (
      <div class="rx-controls" role="group" aria-label={zh ? "查询" : "Query"}>
        <button type="button" class="rx-q is-on" data-q="x">
          <span class="mono">x</span> {zh ? "已知，求" : "given, find"} <span class="mono">y</span>
        </button>
        <button type="button" class="rx-q" data-q="y">
          <span class="mono">y</span> {zh ? "已知，求" : "given, find"} <span class="mono">x</span>
        </button>
        <button type="button" class="rx-q" data-q="none">
          {zh ? "什么都不给定，找最近的点" : "nothing given, find the nearest point"}
        </button>
      </div>
    )
  }
  <div class="rx-stage">
    <canvas class="rx-canvas" role="img" aria-label={aria}></canvas>
    {
      mode === "interactive" && (
        <p class="rx-hint mono" aria-hidden="true">
          {zh ? "拖动直线 · 点一下在此发起查询" : "drag the line · click to start a query there"}
        </p>
      )
    }
  </div>
  {
    mode === "interactive" && (
      <div class="rx-readout" aria-live="polite">
        <div class="rx-row">
          <span class="rx-k mono">{zh ? "钉住（精度 ∞）" : "clamped (precision ∞)"}</span>
          <span class="rx-v rx-clamped">x = 0.60</span>
        </div>
        <div class="rx-row">
          <span class="rx-k mono">{zh ? "自由（精度 0）" : "free (precision 0)"}</span>
          <span class="rx-v rx-free">y</span>
        </div>
        <div class="rx-row rx-row--answers">
          <span class="rx-k mono">{zh ? "答案" : "answers"}</span>
          <span class="rx-v rx-answers">…</span>
        </div>
        <p class="rx-note" />
      </div>
    )
  }
</div>

<script>
  // ---------------------------------------------------------------- the model
  const N = 48
  const S = 0.12 // smoothing of the mixture; the README's example uses s = 0.05 at its noise level
  const PTS = Array.from({ length: N }, (_, k) => {
    const t = (2 * Math.PI * k) / N
    return [Math.cos(t), Math.sin(t)]
  })
  const R = 1.5 // the canvas shows [-R, R]²

  // mean-shift step: the weighted mean of the circle points, i.e. z + σ² ∇log p(z)
  function shift(x: number, y: number): [number, number, number] {
    let wsum = 0
    let mx = 0
    let my = 0
    for (const [cx, cy] of PTS) {
      const w = Math.exp(-((x - cx) ** 2 + (y - cy) ** 2) / (2 * S * S))
      wsum += w
      mx += w * cx
      my += w * cy
    }
    return wsum < 1e-300 ? [x, y, 0] : [mx / wsum, my / wsum, wsum]
  }
  function logp(x: number, y: number) {
    let s = 0
    for (const [cx, cy] of PTS) s += Math.exp(-((x - cx) ** 2 + (y - cy) ** 2) / (2 * S * S))
    return Math.log(s + 1e-300)
  }

  type Query = "x" | "y" | "none"
  // one step of a query: clamped coordinates stay, free ones move along the field
  function step(q: Query, z: [number, number]): [number, number] {
    const [sx, sy] = shift(z[0], z[1])
    if (q === "x") return [z[0], sy]
    if (q === "y") return [sx, z[1]]
    return [sx, sy]
  }

  // a run is animated along its path's length over a fixed time, however many steps it took
  type Run = { path: [number, number][]; cum: number[]; start: number; done: boolean }
  const DURATION = 1100
  function solve(q: Query, z0: [number, number]): [number, number][] {
    const path: [number, number][] = [z0]
    let z = z0
    for (let i = 0; i < 400; i++) {
      const n = step(q, z)
      path.push(n)
      if (Math.hypot(n[0] - z[0], n[1] - z[1]) < 1e-5) break
      z = n
    }
    return path
  }

  // ---------------------------------------------------------------- drawing
  const css = (el: Element, v: string) => getComputedStyle(el).getPropertyValue(v).trim()
  // "#rgb", "#rrggbb" or "rgb(r, g, b)" → [r, g, b]
  function toRgb(c: string): number[] {
    const h = c.match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i)?.[1]
    if (h) {
      const full = h.length === 3 ? [...h].map((x) => x + x).join("") : h
      return [0, 2, 4].map((i) => parseInt(full.slice(i, i + 2), 16))
    }
    return c.match(/\d+(\.\d+)?/g)?.slice(0, 3).map(Number) ?? [0, 0, 0]
  }
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches

  function setup(root: HTMLElement) {
    const mode = root.dataset.mode as "sweep" | "interactive"
    const canvas = root.querySelector<HTMLCanvasElement>(".rx-canvas")!
    const ctx = canvas.getContext("2d")!
    let W = 0
    let dpr = 1
    let field: HTMLCanvasElement | null = null
    let fieldTheme = ""

    let q: Query = "x"
    let clamp = 0.6
    let runs: Run[] = []
    let dragging = false

    const toPx = (v: number) => ((v + R) / (2 * R)) * W
    const toPy = (v: number) => ((R - v) / (2 * R)) * W
    const fromPx = (p: number) => (p / W) * 2 * R - R
    const fromPy = (p: number) => R - (p / W) * 2 * R

    function resize() {
      dpr = Math.min(2, window.devicePixelRatio || 1)
      W = canvas.clientWidth
      canvas.width = Math.round(W * dpr)
      canvas.height = Math.round(W * dpr)
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      field = null
    }

    // the density as shading, and the score field as arrows; cached per size and theme
    function drawField() {
      const theme = document.documentElement.dataset.theme ?? ""
      if (field && fieldTheme === theme) return field
      fieldTheme = theme
      const fg = css(root, "--fg") || "#000"
      const off = document.createElement("canvas")
      off.width = canvas.width
      off.height = canvas.height
      const o = off.getContext("2d")!
      o.setTransform(dpr, 0, 0, dpr, 0, 0)
      // shading: the density, darkest on the circle, computed on a coarse grid and scaled up
      // smoothly (drawing translucent cells one by one leaves seams between them)
      const G = 96
      const img = new ImageData(G, G)
      const rgb = toRgb(fg)
      let hi = -Infinity
      const vals: number[] = []
      for (let j = 0; j < G; j++)
        for (let i = 0; i < G; i++) {
          const v = logp(-R + ((i + 0.5) / G) * 2 * R, R - ((j + 0.5) / G) * 2 * R)
          vals.push(v)
          hi = Math.max(hi, v)
        }
      for (let k = 0; k < G * G; k++) {
        img.data[4 * k] = rgb[0]
        img.data[4 * k + 1] = rgb[1]
        img.data[4 * k + 2] = rgb[2]
        img.data[4 * k + 3] = Math.round(255 * 0.22 * Math.exp((vals[k] - hi) * 0.5))
      }
      const small = document.createElement("canvas")
      small.width = G
      small.height = G
      small.getContext("2d")!.putImageData(img, 0, 0)
      o.imageSmoothingEnabled = true
      o.imageSmoothingQuality = "high"
      o.drawImage(small, 0, 0, W, W)
      // arrows: the direction of the field (towards the circle)
      o.globalAlpha = 0.32
      o.strokeStyle = fg
      o.lineWidth = 1
      const A = 13
      for (let j = 0; j < A; j++)
        for (let i = 0; i < A; i++) {
          const x = -R + ((i + 0.5) / A) * 2 * R
          const y = -R + ((j + 0.5) / A) * 2 * R
          const [sx, sy] = shift(x, y)
          let dx = sx - x
          let dy = sy - y
          const len = Math.hypot(dx, dy)
          if (len < 0.02) continue
          dx /= len
          dy /= len
          const L = Math.min(1, len * 3) * (W / A) * 0.32
          const px = toPx(x)
          const py = toPy(y)
          const ex = px + dx * L
          const ey = py - dy * L
          o.beginPath()
          o.moveTo(px - dx * L * 0.2, py + dy * L * 0.2)
          o.lineTo(ex, ey)
          const h = 3.2
          o.moveTo(ex, ey)
          o.lineTo(ex - dx * h + dy * h * 0.6, ey + dy * h + dx * h * 0.6)
          o.moveTo(ex, ey)
          o.lineTo(ex - dx * h - dy * h * 0.6, ey + dy * h - dx * h * 0.6)
          o.stroke()
        }
      // the data: points on the circle
      o.globalAlpha = 0.55
      for (const [cx, cy] of PTS) {
        o.beginPath()
        o.arc(toPx(cx), toPy(cy), 1.6, 0, 2 * Math.PI)
        o.fill()
      }
      field = off
      return off
    }

    function startQuery() {
      runs = []
      if (q === "x") {
        runs.push(mk([clamp, 0.5]), mk([clamp, -0.5]))
      } else if (q === "y") {
        runs.push(mk([0.5, clamp]), mk([-0.5, clamp]))
      } else {
        runs.push(mk([0.25, 0.35]), mk([-1.25, -0.2]))
      }
      readout()
    }
    function mk(z0: [number, number], instant = reduce): Run {
      const path = solve(q, z0)
      const cum = [0]
      for (let i = 1; i < path.length; i++)
        cum.push(cum[i - 1] + Math.hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]))
      return { path, cum, start: performance.now(), done: instant }
    }
    // the point at a fraction of the path's length, and the index of the last vertex before it
    function along(r: Run, f: number): [[number, number], number] {
      const total = r.cum[r.cum.length - 1]
      const d = f * total
      let i = 0
      while (i < r.cum.length - 2 && r.cum[i + 1] < d) i++
      const seg = r.cum[i + 1] - r.cum[i]
      const u = seg > 0 ? Math.min(1, (d - r.cum[i]) / seg) : 1
      const a = r.path[i]
      const b = r.path[Math.min(i + 1, r.path.length - 1)]
      return [[a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u], i]
    }

    function answers() {
      const pts = runs.map((r) => r.path[r.path.length - 1])
      const uniq: [number, number][] = []
      for (const p of pts) if (!uniq.some((u) => Math.hypot(u[0] - p[0], u[1] - p[1]) < 0.02)) uniq.push(p)
      return uniq
    }

    function readout() {
      if (mode !== "interactive") return
      const $ = (s: string) => root.querySelector<HTMLElement>(s)!
      const f = (v: number) => (Math.abs(v) < 0.005 ? "0.00" : v.toFixed(2))
      const ans = answers()
      const zh = location.pathname.startsWith("/zh")
      $(".rx-clamped").textContent = q === "x" ? `x = ${f(clamp)}` : q === "y" ? `y = ${f(clamp)}` : zh ? "无" : "nothing"
      $(".rx-free").textContent = q === "x" ? "y" : q === "y" ? "x" : zh ? "x 与 y" : "x and y"
      $(".rx-answers").textContent = ans
        .map((p) => (q === "x" ? `y ≈ ${f(p[1])}` : q === "y" ? `x ≈ ${f(p[0])}` : `(${f(p[0])}, ${f(p[1])})`))
        .join("   ·   ")
      const off = Math.abs(clamp) > 1
      const notes = zh
        ? {
            none: "什么都不钉住时，每个起点都流向关系上最近的点。",
            off: "圆外也有答案：平滑后关系的峰上的点，而不是报错。",
            many: "一个问题两个答案：起点选定分支。函数只能给一个。",
            one: "这里只有一个答案：两个起点到达了同一个根。",
          }
        : {
            none: "With nothing clamped, every start flows to the nearest point of the relation.",
            off: "Off the circle there is still an answer: the point on the smoothed relation's ridge, not an error.",
            many: "Two answers to one question: the starting guess picks the branch. A function could only give one.",
            one: "One answer here: both starts reached the same root.",
          }
      $(".rx-note").textContent =
        q === "none" ? notes.none : off ? notes.off : ans.length > 1 ? notes.many : notes.one
    }

    function draw(now: number) {
      ctx.clearRect(0, 0, W, W)
      ctx.drawImage(drawField(), 0, 0, W, W)
      const fg = css(root, "--fg") || "#000"
      const bg = css(root, "--bg") || "#fff"
      ctx.globalAlpha = 1
      ctx.strokeStyle = fg
      ctx.fillStyle = fg

      // the clamp: a dashed line at the clamped value
      if (q !== "none") {
        ctx.save()
        ctx.setLineDash([5, 5])
        ctx.lineWidth = 1.2
        ctx.globalAlpha = 0.8
        ctx.beginPath()
        if (q === "x") {
          ctx.moveTo(toPx(clamp), 0)
          ctx.lineTo(toPx(clamp), W)
        } else {
          ctx.moveTo(0, toPy(clamp))
          ctx.lineTo(W, toPy(clamp))
        }
        ctx.stroke()
        ctx.restore()
        // label of the clamp
        ctx.font = `500 12px ${css(root, "--font-mono") || "monospace"}`
        ctx.globalAlpha = 0.85
        const txt = `${q} = ${clamp.toFixed(2)}`
        if (q === "x") ctx.fillText(txt, Math.min(toPx(clamp) + 8, W - 70), 18)
        else ctx.fillText(txt, 10, Math.max(toPy(clamp) - 8, 14))
        ctx.globalAlpha = 1
      }

      // the queries: trails from the start to the root, the root as a filled point
      for (const r of runs) {
        const f = r.done ? 1 : Math.min(1, (now - r.start) / DURATION)
        if (f >= 1) r.done = true
        const [head, k] = along(r, 1 - (1 - f) ** 3)
        ctx.lineWidth = 1.5
        ctx.beginPath()
        ctx.moveTo(toPx(r.path[0][0]), toPy(r.path[0][1]))
        for (let i = 1; i <= k; i++) ctx.lineTo(toPx(r.path[i][0]), toPy(r.path[i][1]))
        ctx.lineTo(toPx(head[0]), toPy(head[1]))
        ctx.stroke()
        // start: hollow
        ctx.beginPath()
        ctx.arc(toPx(r.path[0][0]), toPy(r.path[0][1]), 3.5, 0, 2 * Math.PI)
        ctx.fillStyle = bg
        ctx.fill()
        ctx.stroke()
        ctx.fillStyle = fg
        // head or answer
        ctx.beginPath()
        ctx.arc(toPx(head[0]), toPy(head[1]), r.done ? 6 : 4, 0, 2 * Math.PI)
        ctx.fill()
        if (r.done) {
          const pulse = reduce ? 0 : (Math.sin(now / 400) + 1) / 2
          ctx.globalAlpha = 0.25 * (1 - pulse)
          ctx.beginPath()
          ctx.arc(toPx(head[0]), toPy(head[1]), 6 + 8 * pulse, 0, 2 * Math.PI)
          ctx.stroke()
          ctx.globalAlpha = 1
        }
      }
    }

    // sweep mode: the clamp line travels across x and back; the answers follow it
    let sweepT = 0
    function sweep() {
      sweepT += 0.0035
      clamp = Math.sin(sweepT) * 1.25
      runs = [mk([clamp, 0.5], true), mk([clamp, -0.5], true)]
    }

    let visible = true
    let raf = 0
    function loop(now: number) {
      if (mode === "sweep" && !reduce) sweep()
      draw(now)
      raf = visible ? requestAnimationFrame(loop) : 0
    }

    resize()
    if (mode === "sweep") {
      clamp = 0.6
      runs = [mk([clamp, 0.5], true), mk([clamp, -0.5], true)]
    } else startQuery()
    new ResizeObserver(() => {
      resize()
      draw(performance.now())
    }).observe(canvas)
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting
      if (visible && !raf) raf = requestAnimationFrame(loop)
    }).observe(canvas)
    new MutationObserver(() => draw(performance.now())).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    })

    if (mode !== "interactive") return

    // ---------------------------------------------------------- interaction
    root.querySelectorAll<HTMLButtonElement>(".rx-q").forEach((b) =>
      b.addEventListener("click", () => {
        root.querySelectorAll(".rx-q").forEach((o) => o.classList.toggle("is-on", o === b))
        q = b.dataset.q as Query
        clamp = 0.6
        startQuery()
      }),
    )
    const pos = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect()
      return [fromPx(e.clientX - r.left), fromPy(e.clientY - r.top)] as [number, number]
    }
    const near = (z: [number, number]) =>
      (q === "x" && Math.abs(toPx(z[0]) - toPx(clamp)) < 14) || (q === "y" && Math.abs(toPy(z[1]) - toPy(clamp)) < 14)
    canvas.addEventListener("pointerdown", (e) => {
      const z = pos(e)
      if (near(z)) {
        dragging = true
        canvas.setPointerCapture(e.pointerId)
        return
      }
      // a click starts a query there: on the clamp line, or anywhere when nothing is clamped
      const z0: [number, number] = q === "x" ? [clamp, z[1]] : q === "y" ? [z[0], clamp] : z
      runs = [...runs.slice(-5), mk(z0)]
      readout()
    })
    canvas.addEventListener("pointermove", (e) => {
      const z = pos(e)
      canvas.style.cursor = q !== "none" && (dragging || near(z)) ? (q === "x" ? "ew-resize" : "ns-resize") : "crosshair"
      if (!dragging) return
      clamp = Math.max(-1.4, Math.min(1.4, q === "x" ? z[0] : z[1]))
      startQuery()
      runs.forEach((r) => (r.done = true))
    })
    const end = () => {
      if (dragging) {
        dragging = false
        startQuery()
      }
    }
    canvas.addEventListener("pointerup", end)
    canvas.addEventListener("pointercancel", end)
  }

  document.querySelectorAll<HTMLElement>(".rx").forEach(setup)
</script>

<style>
  .rx {
    --rx-max: 560px;
  }
  .rx--interactive {
    display: grid;
    gap: 20px;
  }
  .rx-stage {
    position: relative;
    width: 100%;
    max-width: var(--rx-max);
  }
  .rx-canvas {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    touch-action: none;
  }
  .rx--interactive .rx-canvas {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    cursor: crosshair;
  }
  .rx-hint {
    margin: 8px 0 0;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .rx-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .rx-q {
    height: 38px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  .rx-q:hover {
    border-color: var(--fg);
  }
  .rx-q.is-on {
    background: var(--invert-bg);
    color: var(--invert-fg);
    border-color: var(--invert-bg);
  }
  .rx-readout {
    display: grid;
    gap: 2px;
    border-top: 1px solid var(--line-strong);
  }
  .rx-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .rx-k {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .rx-v {
    font-family: var(--font-mono);
    font-size: 14px;
    text-align: right;
    white-space: pre-wrap;
  }
  .rx-note {
    margin: 12px 0 0;
    color: var(--fg-2);
    font-size: 15px;
    min-height: 3em;
  }
</style>
