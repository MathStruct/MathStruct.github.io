---
// "Free energy" on /projects/lenticulum-jl: two small labs that run in the browser, and three notes.
// Lab 1 runs loopy Gaussian belief propagation on a ring and plots its Bethe free energy per sweep
// against the exact -log p(y). Lab 2 tracks a moving target with a belief over position only and with
// one that also carries a velocity (generalised coordinates of order 1). The maths is in
// src/lib/free-energy.ts. The claims in the notes come from Lenticulum.jl's vault (Gaussian Graphs/
// Bethe Free Energy, Gaussian Graphs/Composing Optimisers, Design/Time as a Base), as of 2026-11-24
// (MathStruct/Lenticulum.jl@7037623); the labs reproduce them qualitatively, not the vault's numbers.
const vault = "https://mathstruct.org/Lenticulum.jl/"
const notes = {
  bethe: vault + "Gaussian-Graphs/Bethe-Free-Energy",
  compose: vault + "Gaussian-Graphs/Composing-Optimisers",
  time: vault + "Design/Time-as-a-Base",
  factor: vault + "Gaussian-Graphs/Everything-is-a-Factor",
}
const N = 6
const C = 170
const RV = 108 // variables
const RF = 108 * Math.cos(Math.PI / N) // couplings, between them
const RO = 158 // observations, outside
const ang = (k: number) => -Math.PI / 2 + (2 * Math.PI * k) / N
const vars = Array.from({ length: N }, (_, i) => ({ i, x: C + RV * Math.cos(ang(i)), y: C + RV * Math.sin(ang(i)) }))
const cps = Array.from({ length: N }, (_, i) => ({ i, x: C + RF * Math.cos(ang(i + 0.5)), y: C + RF * Math.sin(ang(i + 0.5)) }))
const obs = Array.from({ length: N }, (_, i) => ({ i, x: C + RO * Math.cos(ang(i)), y: C + RO * Math.sin(ang(i)) }))
const f = (n: number) => +n.toFixed(1)
// The Chinese page (/zh/projects/lenticulum-jl) shows the same labs in Chinese (Nav.astro tells
// the two languages apart the same way).
const zh = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "").startsWith("/zh")
const t = zh
  ? {
      loopTitle: "环上的六个信念",
      legend: "变量",
      legend2: "因子",
      cut: "剪断",
      sched: "调度表",
      flood: "泛洪",
      roundLoop: "沿环一周",
      mod: "修正项",
      none: "无",
      damp: "阻尼 ½",
      mom: "动量 0.3",
      coupling: "耦合",
      cutOne: "剪断一根连线（成为树）",
      run: "运行",
      step: "单步",
      ready: "就绪",
      plotTitle: "自由能，逐轮扫描",
      sweeps: "轮数",
      betheF: "Bethe F",
      exact: "精确 −log p(y)",
      change: "上一轮的变化",
      sweepsAxis: "轮数 →",
      hint: "试试：λ = 5 时泛洪，然后改为<em>沿环一周</em>。再把 λ 推到 30 并加动量，两种调度表各试一次。然后剪断一根连线，看曲线与虚线的差距合拢。",
      note1: { title: "Bethe 自由能", body: "能量在因子上相加。熵的相加要加一个修正：被 <i>d</i> 个因子看见的变量出现在 <i>d</i> 个因子信念里，所以要减去 <i>d</i> − 1 份它的熵。在树上、在不动点处，它恰好是 −log <i>p</i>(<i>y</i>)：剪断一根连线，曲线就落在虚线上。在有环的图上它是近似，而信念传播的不动点恰好是它的驻点。但信念传播<em>不是</em>沿它做梯度下降：在泛洪之下，曲线先上后下。" },
      note2: { title: "推断器与优化器可以组合，收敛不能。", body: "一轮消息是一个推断器，参数上的一步是一个优化器，阻尼、动量或 Anderson 加速是包在两者之上的修正项。在 Lenticulum.jl 里，优化器本身就是图中的节点，紧邻数据与先验。任何这样的叠加都保持同样的不动点，所以只要它到达，就到达同一个答案。它是否到达取决于叠加：上面，泛洪一轮上的动量在强耦合下发散，而在沿环一周的扫描上收敛。笔记库中的测量：正确的调度表把一个环从 326 轮降到 38 轮，再加 Anderson 加速，把 297 000 次消息求值变成 414 次。" },
      note3: { title: "更高阶：自带运动的信念", body: "只关于位置的自由能，会被一个总是落在运动世界之后的信念最小化：朴素下降以固定的滞后（速度 ÷ 增益）跟随匀速运动。给信念一个速度——主动推断的运动广义坐标——并在随它运动的参考系中下降，滞后就消失了。往上一层同样成立：动量是参数上的一个速度，它帮忙与否取决于它遇到的谱。" },
      inVault: (n: string) => `笔记库中的 ${n} ↗`,
      track: "一个移动的目标",
      trackTitle: "慢一步，还是正落在其上",
      trackBody: "目标以匀速运动，观测带噪声。两个信念以同样的增益下降同一个预测误差。只关于位置的那个与每段斜率保持固定的差距；同时携带速度的那个能追上，只在运动拐弯处过头。",
      posOnly: "仅位置 · RMS 误差",
      withVel: "带速度 · RMS 误差",
      replay: "重放",
      target: "目标",
      observations: "观测",
      posOnlyKey: "仅位置",
      posVel: "位置与速度",
      fine: "什么在哪里运行：Bethe 自由能、带泛洪的信念传播、顺序与生成树调度表、阻尼、动量与 Anderson 加加速都在 Lenticulum.jl（Mycelium.jl）里，与解析形式核对。携带导数的通道（jet）还是一篇设计笔记，不是代码。本页两个实验室是运行在你浏览器里的小型重实现。",
      converged: (n: number) => `已收敛 · ${n} 轮`,
      pause: "暂停",
    }
  : {
      loopTitle: "Six beliefs on a loop",
      legend: "variable",
      legend2: "factor",
      cut: "cut",
      sched: "Schedule",
      flood: "Flooding",
      roundLoop: "Round the loop",
      mod: "Modifier",
      none: "None",
      damp: "Damping ½",
      mom: "Momentum 0.3",
      coupling: "Coupling",
      cutOne: "Cut one wire (a tree)",
      run: "Run",
      step: "Step",
      ready: "ready",
      plotTitle: "Free energy, sweep by sweep",
      sweeps: "sweeps",
      betheF: "Bethe F",
      exact: "exact −log p(y)",
      change: "change in last sweep",
      sweepsAxis: "sweeps →",
      hint: "Try: flooding at λ = 5, then <em>round the loop</em>. Then push λ to 30 and add momentum, once with each schedule. Then cut a wire and watch the gap to the dashed line close.",
      note1: { title: "The Bethe free energy", body: "Energies add over the factors. Entropies add with a correction: a variable seen by <i>d</i> factors appears in <i>d</i> factor beliefs, so <i>d</i> − 1 copies of its entropy come off. On a tree, at the fixed point, this is exactly −log <i>p</i>(<i>y</i>): cut a wire and the curve lands on the dashed line. On a loop it is an approximation, and the fixed points of belief propagation are exactly its stationary points. Belief propagation is <em>not</em> gradient descent on it, though: under flooding the curve goes up before it comes down." },
      note2: { title: "Inferencers and optimisers compose. Convergence does not.", body: "A sweep of messages is an inferencer, a step on the parameters is an optimiser, and damping, momentum or Anderson acceleration are modifiers wrapped round either. In Lenticulum.jl the optimisers are themselves nodes in the graph, next to the data and the priors. Every such stack keeps the same fixed points, so if it arrives, it arrives at the same answer. Whether it arrives depends on the composite: above, momentum on a flooding sweep diverges at strong coupling and converges on a sweep that goes round the loop. Measured in the vault: the right schedule takes a loop from 326 sweeps to 38, and Anderson acceleration on top of it turns 297 000 message evaluations into 414." },
      note3: { title: "Higher orders: beliefs that carry their own motion", body: "A free energy over positions alone is minimised by a belief that is always behind a moving world: plain descent follows a steady motion at a constant lag (speed ÷ gain). Give the belief a velocity, the generalised coordinates of motion of active inference, and descend in a frame that moves with it, and the lag goes away. The same holds one level up: momentum is a velocity on the parameters, and it helps or hurts depending on the spectrum it meets." },
      inVault: (n: string) => `${n}, in the vault ↗`,
      track: "A moving target",
      trackTitle: "One step behind, or on it",
      trackBody: "A target moves at steady speeds and is seen with noise. Both beliefs descend the same prediction error with the same gain. The one over position only trails each slope by a constant gap; the one that also carries a velocity catches up, and overshoots only where the motion turns.",
      posOnly: "position only · RMS error",
      withVel: "with velocity · RMS error",
      replay: "Replay",
      target: "target",
      observations: "observations",
      posOnlyKey: "position only",
      posVel: "position and velocity",
      fine: "What runs where: the Bethe free energy, belief propagation with flooding, sequential and spanning-tree schedules, damping, momentum and Anderson acceleration are in Lenticulum.jl (Mycelium.jl), tested against closed forms. Channels that carry derivatives (jets) are a design note, not code yet. Both labs on this page are small re-implementations that run in your browser.",
      converged: (n: number) => `converged · ${n} sweeps`,
      pause: "Pause",
    }
---

<div class="fe">
  <!-- -------------------------------------------------------------- lab 1 -->
  <div class="lab reveal" data-fe-lab>
    <div class="lab-graph">
      <div class="lab-bar mono">
        <span>{t.loopTitle}</span>
        <span class="lab-legend"><i class="lg-v"></i>{t.legend} <i class="lg-f"></i>{t.legend2}</span>
      </div>
      <svg viewBox="0 0 340 340" role="img" aria-label="A ring of six variables joined by coupling factors, each with an observation factor. Messages light up the wires as they are sent; the halo of each variable shows how uncertain its belief is.">
        {obs.map((o) => (
          <line class="w w-obs" x1={f(o.x)} y1={f(o.y)} x2={f(vars[o.i].x)} y2={f(vars[o.i].y)} />
        ))}
        {cps.map((c) => (
          <g class={`cp${c.i === N - 1 ? " cp-last" : ""}`} data-cp={c.i}>
            <line class="w" data-w={`bwd-${c.i}`} x1={f(c.x)} y1={f(c.y)} x2={f(vars[c.i].x)} y2={f(vars[c.i].y)} />
            <line class="w" data-w={`fwd-${c.i}`} x1={f(c.x)} y1={f(c.y)} x2={f(vars[(c.i + 1) % N].x)} y2={f(vars[(c.i + 1) % N].y)} />
            <rect class="fac" x={f(c.x - 8)} y={f(c.y - 8)} width="16" height="16" rx="2" />
          </g>
        ))}
        {obs.map((o) => (
          <rect class="fac fac-obs" x={f(o.x - 6)} y={f(o.y - 6)} width="12" height="12" rx="2" />
        ))}
        {vars.map((v) => (
          <g>
            <circle class="halo" data-halo={v.i} cx={f(v.x)} cy={f(v.y)} r="26" />
            <circle class="var" cx={f(v.x)} cy={f(v.y)} r="15" />
            <text class="vl" x={f(v.x)} y={f(v.y + 4.5)}>x<tspan dy="3" font-size="9">{v.i + 1}</tspan></text>
          </g>
        ))}
        <text class="cut-x" x={f(cps[N - 1].x)} y={f(cps[N - 1].y - 14)}>{t.cut}</text>
      </svg>
      <div class="controls">
        <div class="ctl">
          <span class="ctl-k mono">{t.sched}</span>
          <div class="seg" role="group" aria-label={t.sched}>
            <button type="button" data-sched="flood" aria-pressed="true">{t.flood}</button>
            <button type="button" data-sched="loop" aria-pressed="false">{t.roundLoop}</button>
          </div>
        </div>
        <div class="ctl">
          <span class="ctl-k mono">{t.mod}</span>
          <div class="seg" role="group" aria-label={t.mod}>
            <button type="button" data-mod="none" aria-pressed="true">{t.none}</button>
            <button type="button" data-mod="damp" aria-pressed="false">{t.damp}</button>
            <button type="button" data-mod="mom" aria-pressed="false">{t.mom}</button>
          </div>
        </div>
        <div class="ctl">
          <label class="ctl-k mono" for="fe-lam">{t.coupling} λ = <span data-lam-out>5</span></label>
          <input id="fe-lam" type="range" min="0" max="100" value="47" data-lam />
        </div>
        <div class="ctl ctl-row">
          <label class="check"><input type="checkbox" data-cut /> {t.cutOne}</label>
          <div class="btns">
            <button type="button" class="btn btn--solid btn-sm" data-run>{t.run} <span class="arrow">→</span></button>
            <button type="button" class="btn btn-sm" data-step>{t.step}</button>
          </div>
        </div>
      </div>
    </div>

    <div class="lab-plot">
      <div class="lab-bar mono">
        <span>{t.plotTitle}</span>
        <span class="status" data-status>{t.ready}</span>
      </div>
      <svg class="plot" viewBox="0 0 520 300" preserveAspectRatio="none" data-plot aria-hidden="true">
        <g data-grid></g>
        <line class="exact" data-exact x1="0" x2="520" y1="0" y2="0" />
        <path class="curve" data-curve d="" />
      </svg>
      <div class="plot-axis mono"><span data-ylab>F</span><span>{t.sweepsAxis}</span></div>
      <dl class="readout">
        <div><dt>{t.sweeps}</dt><dd data-k>0</dd></div>
        <div><dt>{t.betheF}</dt><dd data-f>–</dd></div>
        <div><dt>{t.exact}</dt><dd data-ex>–</dd></div>
        <div><dt>{t.change}</dt><dd data-res>–</dd></div>
      </dl>
      <p class="formula">
        <i>F</i><sub>Bethe</sub> = Σ<sub><i>f</i></sub> ( 𝔼<sub><i>b<sub>f</sub></i></sub>[−log <i>f</i>] − <i>H</i>[<i>b<sub>f</sub></i>] )
        + Σ<sub><i>v</i></sub> (<i>d<sub>v</sub></i> − 1) <i>H</i>[<i>b<sub>v</sub></i>]
      </p>
      <p class="hint" set:html={t.hint} />
    </div>
  </div>

  <!-- -------------------------------------------------------------- notes -->
  <ol class="fe-notes">
    <li class="reveal">
      <span class="n mono">01</span>
      <h3>{t.note1.title}</h3>
      <p set:html={t.note1.body} />
      <a class="more mono" href={notes.bethe}>{t.inVault("Bethe Free Energy")}</a>
    </li>
    <li class="reveal" style="--d:.06s">
      <span class="n mono">02</span>
      <h3>{t.note2.title}</h3>
      <p>{t.note2.body}</p>
      <a class="more mono" href={notes.compose}>{t.inVault("Composing Optimisers")}</a>
    </li>
    <li class="reveal" style="--d:.12s">
      <span class="n mono">03</span>
      <h3>{t.note3.title}</h3>
      <p>{t.note3.body}</p>
      <a class="more mono" href={notes.time}>{t.inVault("Time as a Base")}</a>
    </li>
  </ol>

  <!-- -------------------------------------------------------------- lab 2 -->
  <div class="lab lab2 reveal" data-track>
    <div class="lab2-text">
      <span class="ctl-k mono">{t.track}</span>
      <h3>{t.trackTitle}</h3>
      <p>{t.trackBody}</p>
      <dl class="readout readout--2">
        <div><dt>{t.posOnly}</dt><dd data-rms0>–</dd></div>
        <div><dt>{t.withVel}</dt><dd data-rms1>–</dd></div>
      </dl>
      <button type="button" class="btn btn-sm" data-replay>{t.replay}</button>
    </div>
    <div class="lab2-plot">
      <svg class="plot" viewBox="0 0 640 260" preserveAspectRatio="none" aria-hidden="true">
        <path class="t-obs" data-tobs d="" />
        <path class="t-true" data-ttrue d="" />
        <path class="t-o0" data-to0 d="" />
        <path class="t-o1" data-to1 d="" />
      </svg>
      <div class="key mono">
        <span><i class="k-true"></i>{t.target}</span>
        <span><i class="k-obs"></i>{t.observations}</span>
        <span><i class="k-o0"></i>{t.posOnlyKey}</span>
        <span><i class="k-o1"></i>{t.posVel}</span>
      </div>
    </div>
  </div>

  <p class="fe-fine mono">{t.fine}</p>
</div>

<script>
  import { init, sweep, bethe, beliefs, exact, track, type Model, type State, type Schedule } from "../../lib/free-energy"

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches

  // ------------------------------------------------------------------ lab 1
  for (const root of document.querySelectorAll<HTMLElement>("[data-fe-lab]")) {
    const Y = [1.2, -0.4, 0.8, 2.0, -1.1, 0.3]
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!
    const lamIn = $<HTMLInputElement>("[data-lam]")
    const cutIn = $<HTMLInputElement>("[data-cut]")
    const curve = $<SVGPathElement>("[data-curve]")
    const exLine = $<SVGLineElement>("[data-exact]")
    const grid = $<SVGGElement>("[data-grid]")
    const status = $<HTMLElement>("[data-status]")
    const zh = location.pathname.startsWith("/zh")
    const runBtn = $<HTMLButtonElement>("[data-run]")
    let sched: Schedule = "flood"
    let mod: "none" | "damp" | "mom" = "none"
    let M: Model, S: State, prev: State | null, Fs: number[], res: number, ex: number, timer = 0, state: "ready" | "running" | "done" | "diverged" | "paused" = "ready"

    const lam = () => +(Math.exp(Math.log(1) + (Math.log(30) / 100) * +lamIn.value)).toFixed(1)
    const fmt = (x: number) => (isFinite(x) && Math.abs(x) < 1e6 ? x.toFixed(3) : "∞")

    function reset() {
      clearInterval(timer)
      M = { n: 6, lam: lam(), tau: 1, y: Y, cut: cutIn.checked }
      S = init(M)
      prev = null
      Fs = [bethe(M, S)]
      res = NaN
      ex = exact(M)
      root.classList.toggle("is-cut", M.cut)
      $("[data-lam-out]").textContent = String(M.lam)
      setState("ready")
      draw()
    }
    function setState(s: typeof state) {
      state = s
      const zhState: Record<string, string> = { ready: "就绪", running: "运行中", diverged: "发散", paused: "已暂停" }
      status.textContent = s === "done" ? (zh ? `已收敛 · ${Fs.length - 1} 轮` : `converged · ${Fs.length - 1} sweeps`) : zh ? zhState[s] : s
      status.dataset.s = s
      runBtn.innerHTML = s === "running" ? (zh ? "暂停" : "Pause") : zh ? '运行 <span class="arrow">→</span>' : 'Run <span class="arrow">→</span>'
    }
    function step() {
      const o = sweep(M, S, sched, mod === "damp" ? 0.5 : 0, mod === "mom" ? 0.3 : 0, prev)
      S = o.S
      prev = o.prev
      res = o.res
      Fs.push(bethe(M, S))
      flash(o.order)
      if (!isFinite(res) || !isFinite(Fs[Fs.length - 1]) || res > 1e8 || Fs.length > 600) {
        clearInterval(timer)
        setState(res > 1e8 || !isFinite(res) ? "diverged" : "paused")
      } else if (res < 1e-9) {
        clearInterval(timer)
        setState("done")
      }
      draw()
    }
    function flash(order: [string, number][]) {
      if (reduced) return
      const per = sched === "loop" ? 22 : 0
      order.forEach(([k, i], j) => {
        const w = root.querySelector(`[data-w="${k}-${i}"]`)
        if (!w) return
        setTimeout(() => {
          w.classList.remove("hot")
          void (w as SVGElement).getBoundingClientRect()
          w.classList.add("hot")
        }, j * per)
      })
    }
    function draw() {
      const W = 520, H = 300, pad = 18
      const ok = Fs.filter((v) => isFinite(v) && Math.abs(v) < 1e6)
      const tail = ok.slice(Math.min(2, ok.length - 1))
      let lo = Math.min(ex, ...tail), hi = Math.max(ex, ...tail)
      if (hi - lo < 0.5) { const m = (hi + lo) / 2; lo = m - 0.25; hi = m + 0.25 }
      const span = hi - lo
      lo -= span * 0.15; hi += span * 0.15
      const nx = Math.max(40, Fs.length - 1)
      const X = (k: number) => (k / nx) * W
      const Yp = (v: number) => pad + (1 - (Math.min(Math.max(v, lo - span), hi + span) - lo) / (hi - lo)) * (H - 2 * pad)
      curve.setAttribute("d", Fs.map((v, k) => (isFinite(v) ? `${k === 0 ? "M" : "L"}${X(k).toFixed(1)},${Yp(v).toFixed(1)}` : "")).join(""))
      const ey = Yp(ex).toFixed(1)
      exLine.setAttribute("y1", ey)
      exLine.setAttribute("y2", ey)
      grid.innerHTML = [0.25, 0.5, 0.75].map((q) => `<line x1="0" x2="${W}" y1="${q * H}" y2="${q * H}"/>`).join("")
      const last = Fs[Fs.length - 1]
      $("[data-k]").textContent = String(Fs.length - 1)
      $("[data-f]").textContent = Fs.length > 1 ? fmt(last) : "–"
      $("[data-ex]").textContent = fmt(ex)
      $("[data-res]").textContent = isFinite(res) ? res.toExponential(1) : state === "diverged" ? "∞" : "–"
      const b = Fs.length > 1 && state !== "diverged" ? beliefs(M, S) : null
      root.querySelectorAll<SVGCircleElement>("[data-halo]").forEach((h, i) => {
        const v = b ? b[i].v : 1
        h.setAttribute("r", (15 + 26 * Math.sqrt(Math.min(Math.max(v, 0), 1))).toFixed(1))
      })
    }
    function run() {
      if (state === "running") { clearInterval(timer); setState("paused"); return }
      if (state === "done" || state === "diverged") reset()
      setState("running")
      const tick = () => { step(); if (state === "running" && Fs.length > 40) { clearInterval(timer); timer = window.setInterval(() => { for (let r = 0; r < 4 && state === "running"; r++) step() }, 60) } }
      timer = window.setInterval(tick, reduced ? 30 : sched === "loop" ? 330 : 180)
    }

    root.querySelectorAll<HTMLButtonElement>("[data-sched]").forEach((b) =>
      b.addEventListener("click", () => {
        sched = b.dataset.sched as Schedule
        root.querySelectorAll("[data-sched]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)))
        reset()
      }),
    )
    root.querySelectorAll<HTMLButtonElement>("[data-mod]").forEach((b) =>
      b.addEventListener("click", () => {
        mod = b.dataset.mod as typeof mod
        root.querySelectorAll("[data-mod]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)))
        reset()
      }),
    )
    lamIn.addEventListener("input", reset)
    cutIn.addEventListener("change", reset)
    runBtn.addEventListener("click", run)
    $("[data-step]").addEventListener("click", () => {
      if (state === "running") { clearInterval(timer); setState("paused") }
      if (state === "done" || state === "diverged") reset()
      step()
      if (state === "ready") setState("paused")
    })
    reset()
  }

  // ------------------------------------------------------------------ lab 2
  for (const root of document.querySelectorAll<HTMLElement>("[data-track]")) {
    const T = track(14)
    const W = 640, H = 260, pad = 16
    const X = (t: number) => (t / T.t[T.t.length - 1]) * W
    const Yp = (v: number) => pad + (1 - (v + 2.2) / 4.4) * (H - 2 * pad)
    const line = (vs: number[], upto: number) => vs.slice(0, upto).map((v, k) => `${k ? "L" : "M"}${X(T.t[k]).toFixed(1)},${Yp(v).toFixed(1)}`).join("")
    const dots = (upto: number) => T.y.slice(0, upto).map((v, k) => `M${X(T.t[k]).toFixed(1)},${Yp(v).toFixed(1)}h0.01`).join("")
    const el = (s: string) => root.querySelector(s)!
    let raf = 0
    const draw = (n: number) => {
      el("[data-ttrue]").setAttribute("d", line(T.x, n))
      el("[data-tobs]").setAttribute("d", dots(n))
      el("[data-to0]").setAttribute("d", line(T.o0, n))
      el("[data-to1]").setAttribute("d", line(T.o1, n))
    }
    el("[data-rms0]").textContent = T.rms0.toFixed(2)
    el("[data-rms1]").textContent = T.rms1.toFixed(2)
    const play = () => {
      cancelAnimationFrame(raf)
      if (reduced) return draw(T.t.length)
      const t0 = performance.now(), dur = 6000
      const frame = (now: number) => {
        const n = Math.min(T.t.length, Math.ceil(((now - t0) / dur) * T.t.length))
        draw(n)
        if (n < T.t.length) raf = requestAnimationFrame(frame)
      }
      raf = requestAnimationFrame(frame)
    }
    el("[data-replay]").addEventListener("click", play)
    draw(T.t.length)
    new IntersectionObserver((es, io) => {
      if (es.some((e) => e.isIntersecting)) { play(); io.disconnect() }
    }, { threshold: 0.3 }).observe(root)
  }
</script>

