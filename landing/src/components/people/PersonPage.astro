---
// /people/<slug> and /zh/people/<slug>: one person's page, built from their entry in lib/people.ts.
// Sections without data (no background, no own work) are left out, so a short entry makes a short
// page rather than an empty one.
import Layout from "../../layouts/Layout.astro"
import Nav from "../Nav.astro"
import Footer from "../Footer.astro"
import Avatar from "./Avatar.astro"
import type { Person } from "../../lib/people"
import { projects } from "../../lib/projects"
import { zhProjects } from "../../lib/projects.zh"

interface Props {
  person: Person
  lang: "en" | "zh"
}
const { person: p, lang } = Astro.props
const zh = lang === "zh"
const pre = zh ? "/zh" : ""
const L = <A, B>(en: A, zhs: B) => (zh ? zhs : en)
const t = (x: { en: string; zh: string }) => (zh ? x.zh : x.en)

const [first, ...restNames] = p.name.split(" ")
const rest = restNames.join(" ")
const maintained = p.maintains.flatMap((name) => {
  const i = projects.findIndex((x) => x.name === name)
  return i < 0 ? [] : [(zh ? zhProjects : projects)[i]]
})
// a relative "more" link (about#origins) points into this site, in the page's language
const local = (href: string) => (/^https?:/.test(href) ? href : `${pre}/${href}`)
---

<Layout
  title={`${p.name} · ${L("People", "成员")} · MathStruct`}
  description={`${p.name}: ${t(p.role)}. ${t(p.bio)}`}
  lang={lang}
  path={`${pre}/people/${p.slug}`}
>
  <Nav />

  <main>
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <a class="crumb mono reveal" href={`${pre}/people/`}>← {L("People", "成员")}</a>
          <div class="who reveal" style="--d:.03s">
            <Avatar person={p} size={72} />
            <span class="role mono">{t(p.role)}</span>
          </div>
          <h1 class="reveal" style="--d:.05s">
            {first}{rest && <><br /><span class="serif">{rest}.</span></>}
          </h1>
          <p class="lede reveal" style="--d:.1s">{t(p.bio)}</p>
          <div class="cta reveal" style="--d:.16s">
            {p.links.map((l, i) => (
              <a class:list={["btn", { "btn--solid": i === 0 }]} href={l.href}>
                {l.label} {i === 0 && <span class="arrow">→</span>}
              </a>
            ))}
          </div>
        </div>

        <aside class="profile reveal" style="--d:.1s" aria-label={L("At a glance", "概览")}>
          <div class="pf-row">
            <h2 class="pf-h mono">{L("Areas", "领域")}</h2>
            <ul class="tags">{p.areas.map((a) => <li>{t(a)}</li>)}</ul>
          </div>
          {maintained.length > 0 && (
            <div class="pf-row">
              <h2 class="pf-h mono">{L("Maintains", "维护")}</h2>
              <ul class="pf-list">
                {maintained.map((m) => (
                  <li>
                    <a href={m.page}>
                      <span>{m.name}</span>
                      <span class="pf-tag">{m.tagline}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {p.background && p.background.length > 0 && (
            <div class="pf-row">
              <h2 class="pf-h mono">{L("Tools", "工具")}</h2>
              <p class="pf-tools mono">{[...new Set(p.background.flatMap((b) => b.tools))].join(" · ")}</p>
            </div>
          )}
        </aside>
      </div>
    </section>

    {maintained.length > 0 && (
      <section class="section" id="projects">
        <div class="wrap">
          <div class="section-head">
            <div>
              <span class="eyebrow reveal">{L("At MathStruct", "在 MathStruct")}</span>
              <h2 class="reveal" style="--d:.05s">{L("Maintains", "维护")}{zh ? "" : " "}<span class="serif">{L("these.", "这些项目。")}</span></h2>
            </div>
            <p class="lede reveal" style="--d:.1s">
              {L(
                "The projects this person answers for: reviews, releases, and the vault that says what works and what does not.",
                "由其负责的项目：审查、发布，以及说明哪些可行、哪些不可行的知识库。",
              )}
            </p>
          </div>
          <ul class="projects">
            {maintained.map((m, i) => (
              <li class="reveal" style={`--d:${i * 0.06}s`}>
                <a href={m.page}>
                  <span class="k mono">{m.stack} · {m.status}</span>
                  <h3>{m.name}</h3>
                  <p class="tagline serif">{m.tagline}</p>
                  <p>{m.description}</p>
                  <span class="go mono">{L("Project page", "项目页")} <span class="arrow">→</span></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {p.background && p.background.length > 0 && (
      <section class="section" id="background">
        <div class="wrap">
          <div class="section-head">
            <div>
              <span class="eyebrow reveal">{L("Background", "背景")}</span>
              <h2 class="reveal" style="--d:.05s">{L("Before the", "在结构")}{zh ? "" : " "}<span class="serif">{L("structure.", "之前。")}</span></h2>
            </div>
            <p class="lede reveal" style="--d:.1s">
              {L("Earlier work, and the tools it was done with.", "早先的工作，以及所用的工具。")}
            </p>
          </div>
          <ol class="bg">
            {p.background.map((b, i) => (
              <li class="reveal" style={`--d:${i * 0.06}s`}>
                <span class="k mono">{t(b.k)}</span>
                <div>
                  <h3>{t(b.t)}</h3>
                  <p>{t(b.d)}</p>
                  <ul class="tags">{b.tools.map((x) => <li class="mono">{x}</li>)}</ul>
                  {b.more && (
                    <a class="il more" href={local(b.more.href)}>
                      {t(b.more.label)} →
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {p.work && p.work.length > 0 && (
      <section class="section" id="work">
        <div class="wrap">
          <div class="section-head">
            <div>
              <span class="eyebrow reveal">{L("Own work", "个人作品")}</span>
              <h2 class="reveal" style="--d:.05s">{L("Other", "其他")}{zh ? "" : " "}<span class="serif">{L("projects.", "项目。")}</span></h2>
            </div>
            <p class="lede reveal" style="--d:.1s">
              {L("Outside MathStruct, under their own name.", "MathStruct 之外，以个人名义发布的项目。")}
            </p>
          </div>
          <div class="work">
            {p.work.map((w) => (
              <article class:list={["w reveal", { "w--fig": w.figure }]}>
                <div class="w-copy">
                  <h3><a class="il" href={w.href}>{w.name}</a></h3>
                  <p>{t(w.d)}</p>
                  {w.points && (
                    <ul class="points">{(zh ? w.points.zh : w.points.en).map((x) => <li>{x}</li>)}</ul>
                  )}
                  <p class="w-links mono">
                    <a href={w.href}>{L("Source", "源码")}</a>
                    {w.links?.map((l) => <a href={l.href}>{t(l.label)}</a>)}
                  </p>
                </div>
                {w.figure && (
                  <figure>
                    <img src={w.figure.src} alt={t(w.figure.alt)} loading="lazy" />
                    <figcaption>{t(w.figure.caption)}</figcaption>
                  </figure>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="band">
      <div class="wrap band-inner">
        <h2 class="reveal">
          {L("Work with", "与")} {first}<span class="serif">{L(".", " 合作。")}</span>
        </h2>
        <div class="cta">
          <a class="btn btn--solid" href={p.links[0]?.href ?? "https://github.com/MathStruct"}>
            {p.links[0]?.label ?? "GitHub"} <span class="arrow">→</span>
          </a>
          <a class="btn" href={`${pre}/people/`}>{L("Everyone", "全部成员")}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero {
    padding: clamp(32px, 6vw, 72px) 0 clamp(56px, 8vw, 96px);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: -68px 0 0 0;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 65% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 65% 40%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.25fr 1fr;
    }
  }
  .hero-copy {
    min-width: 0;
  }
  .crumb {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }
  .crumb:hover {
    color: var(--fg);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
  }
  .role {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 {
    margin-top: 22px;
    font-size: clamp(52px, 8vw, 104px);
    letter-spacing: -0.05em;
    line-height: 0.94;
  }
  .hero-copy .lede {
    margin-top: 26px;
    font-size: clamp(17px, 1.7vw, 20px);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .profile {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: 0 30px 60px -40px rgba(0, 0, 0, 0.35);
    min-width: 0;
  }
  .pf-row {
    padding: 22px 24px;
  }
  .pf-row + .pf-row {
    border-top: 1px solid var(--line);
  }
  .pf-h {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .pf-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pf-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
  }
  .pf-list li:last-child a {
    border-bottom: 0;
  }
  .pf-tag {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--muted);
    text-align: right;
  }
  .pf-list a:hover .pf-tag {
    color: var(--fg);
  }
  .pf-tools {
    margin: 0;
    font-size: 13px;
    color: var(--fg-2);
  }
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    font-size: 12px;
    color: var(--fg-2);
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--bg-sunken);
    border: 1px solid var(--line);
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
  .projects a {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 26px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    transition:
      border-color 0.2s var(--ease),
      transform 0.25s var(--ease);
  }
  .projects a:hover {
    border-color: var(--fg);
    transform: translateY(-2px);
  }
  .k {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tagline {
    margin: 0;
    font-size: 22px;
    line-height: 1.2;
  }
  .projects p:not(.tagline) {
    margin: 0;
    font-size: 15px;
    color: var(--fg-2);
    flex: 1;
  }
  .go {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .projects a:hover .go {
    color: var(--fg);
  }

  .bg {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }
  .bg > li {
    display: grid;
    gap: 12px;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .bg > li {
      grid-template-columns: 5fr 6fr;
      gap: 64px;
    }
  }
  .bg .k {
    padding-top: 6px;
  }
  .bg h3 {
    font-size: clamp(24px, 2.6vw, 32px);
  }
  .bg p {
    margin: 12px 0 16px;
    color: var(--fg-2);
    max-width: 60ch;
  }
  .more {
    display: inline-block;
    margin-top: 16px;
    font-size: 15px;
  }

  .work {
    display: grid;
    gap: 20px;
  }
  .w {
    display: grid;
    gap: 28px;
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }
  @media (min-width: 960px) {
    .w--fig {
      grid-template-columns: 1fr 1.15fr;
      align-items: start;
    }
  }
  .w h3 {
    font-size: 26px;
  }
  .w-copy > p {
    margin: 12px 0 0;
    color: var(--fg-2);
    font-size: 16px;
  }
  .points {
    margin: 16px 0 0;
    padding-left: 1.1em;
    color: var(--fg-2);
    font-size: 15px;
  }
  .points li + li {
    margin-top: 4px;
  }
  .w-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .w-links a {
    color: var(--muted);
    border-bottom: 1px solid var(--line-strong);
  }
  .w-links a:hover {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }
  .w figure {
    margin: 0;
    min-width: 0;
  }
  .w img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: #fff;
  }
  .w figcaption {
    margin-top: 12px;
    font-size: 13px;
    font-style: italic;
    color: var(--muted);
  }

  .band {
    padding: clamp(64px, 9vw, 110px) 0;
    border-top: 1px solid var(--line);
    background: var(--bg-sunken);
  }
  .band-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .band h2 {
    font-size: clamp(36px, 5vw, 60px);
  }
  .band .cta {
    margin-top: 0;
  }
</style>
