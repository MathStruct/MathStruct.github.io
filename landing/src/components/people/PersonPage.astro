---
// /people/<slug> and /zh/people/<slug>: one person's page, built from their entry in lib/people.ts.
// Deliberately compact, one column: who they are, their background, their own work. What the
// people index already shows (projects maintained, area tags) is not repeated here, and sections
// without data are left out.
import Layout from "../../layouts/Layout.astro"
import Nav from "../Nav.astro"
import Footer from "../Footer.astro"
import Avatar from "./Avatar.astro"
import type { Person } from "../../lib/people"

interface Props {
  person: Person
  lang: "en" | "zh"
}
const { person: p, lang } = Astro.props
const zh = lang === "zh"
const pre = zh ? "/zh" : ""
const L = <A, B>(en: A, zhs: B) => (zh ? zhs : en)
const t = (x: { en: string; zh: string }) => (zh ? x.zh : x.en)
// a relative "more" link (about#origins) points into this site, in the page's language
const local = (href: string) => (/^https?:/.test(href) ? href : `${pre}/${href}`)
---

<Layout
  title={`${p.name} · ${L("People", "成员")} · MathStruct`}
  description={`${p.name}: ${t(p.role)}. ${t(p.bio)}`}
  lang={lang}
  path={`${pre}/people/${p.slug}`}
>
  <Nav />

  <main class="wrap page">
    <a class="crumb mono" href={`${pre}/people/`}>← {L("People", "成员")}</a>

    <header class="head">
      <Avatar person={p} size={76} />
      <div>
        <h1>{p.name}</h1>
        <p class="role mono">{t(p.role)}</p>
      </div>
    </header>
    <p class="bio">{t(p.bio)}</p>
    {p.links.length > 0 && (
      <p class="links mono">{p.links.map((l) => <a href={l.href}>{l.label} ↗</a>)}</p>
    )}

    {p.background && p.background.length > 0 && (
      <section class="block" aria-labelledby="bg-h">
        <h2 id="bg-h" class="eyebrow">{L("Background", "背景")}</h2>
        <dl class="bg">
          {p.background.map((b) => (
            <div>
              <dt>{t(b.k)}</dt>
              <dd>
                {t(b.d)}
                {b.more && <> <a class="il" href={local(b.more.href)}>{t(b.more.label)} →</a></>}
                <span class="tools mono">{b.tools.join(" · ")}</span>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {p.work && p.work.length > 0 && (
      <section class="block" aria-labelledby="work-h">
        <h2 id="work-h" class="eyebrow">{L("Own work", "个人作品")}</h2>
        {p.work.map((w) => (
          <article class="w">
            <h3><a class="il" href={w.href}>{w.name}</a></h3>
            <p>{t(w.d)}</p>
            {w.points && <p class="points">{(zh ? w.points.zh : w.points.en).join(" · ")}</p>}
            {w.links && w.links.length > 0 && (
              <p class="links mono">{w.links.map((l) => <a href={l.href}>{t(l.label)} ↗</a>)}</p>
            )}
            {w.figure && (
              <figure>
                <img src={w.figure.src} alt={t(w.figure.alt)} loading="lazy" />
                <figcaption>{t(w.figure.caption)}</figcaption>
              </figure>
            )}
          </article>
        ))}
      </section>
    )}
  </main>

  <Footer />
</Layout>

<style>
  .page {
    max-width: 820px;
    padding-top: clamp(32px, 6vw, 64px);
    padding-bottom: clamp(64px, 9vw, 112px);
  }
  .crumb {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }
  .crumb:hover {
    color: var(--fg);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 28px;
  }
  h1 {
    font-size: clamp(38px, 5.5vw, 60px);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .role {
    margin: 8px 0 0;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bio {
    margin: 24px 0 0;
    font-size: clamp(17px, 1.7vw, 19px);
    color: var(--fg-2);
    max-width: 62ch;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 14px 0 0;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .links a {
    color: var(--muted);
    border-bottom: 1px solid var(--line-strong);
    transition: color 0.2s var(--ease);
  }
  .links a:hover {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }

  .block {
    margin-top: clamp(40px, 6vw, 56px);
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .block h2.eyebrow {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.6;
    margin-bottom: 8px;
  }

  .bg {
    margin: 0;
  }
  .bg > div {
    display: grid;
    gap: 4px 32px;
    padding: 14px 0;
  }
  .bg > div + div {
    border-top: 1px solid var(--line);
  }
  @media (min-width: 700px) {
    .bg > div {
      grid-template-columns: 160px 1fr;
    }
  }
  .bg dt {
    font-weight: 500;
  }
  .bg dd {
    margin: 0;
    color: var(--fg-2);
    font-size: 15px;
  }
  .tools {
    display: block;
    margin-top: 6px;
    font-size: 12px;
    color: var(--muted);
  }

  .w {
    padding: 16px 0 20px;
  }
  .w + .w {
    border-top: 1px solid var(--line);
  }
  .w h3 {
    font-size: 20px;
  }
  .w p {
    margin: 8px 0 0;
    color: var(--fg-2);
    font-size: 15px;
  }
  .w .points {
    font-size: 13px;
    color: var(--muted);
  }
  .w .links {
    margin-top: 10px;
  }
  figure {
    margin: 18px 0 0;
  }
  figure img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: #fff;
  }
  figcaption {
    margin-top: 10px;
    font-size: 13px;
    font-style: italic;
    color: var(--muted);
  }
</style>
