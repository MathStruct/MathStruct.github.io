---
// A person's photo, or their initials when there is none: the people pages draw every member the
// same way, so a page without a photo does not look unfinished next to one with.
import { initials, type Person } from "../../lib/people"

interface Props {
  person: Person
  size?: number
}
const { person, size = 64 } = Astro.props
---

<span class="avatar" style={`--s:${size}px`} aria-hidden="true">
  {person.photo ? <img src={person.photo} alt="" width={size} height={size} loading="lazy" /> : <span class="serif">{initials(person.name)}</span>}
</span>

<style>
  .avatar {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(circle at 30% 25%, var(--glow), transparent 60%),
      var(--bg-raised);
    color: var(--fg);
    overflow: hidden;
  }
  .avatar span {
    font-size: calc(var(--s) * 0.42);
    line-height: 1;
    transform: translateY(2%);
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
