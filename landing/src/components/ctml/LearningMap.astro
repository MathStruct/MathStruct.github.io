    tags: "definition · theorem · example · program",
    sum: "A get and a put: look at a part of a structure, and update it. A forward pass and a backward pass, in one shape.",
    src: "DaoFP §16.3, §17.9, §18 · Cruttwell et al., arXiv:2103.01931",
    lean: "structure Lens (s a : Type) where",
    used: [35, 0], href: n("Lens"), pre: ["monoidal"],
  },
  {
    id: "plens", label: ["Parametric", "lens"], x: 500, y: 50, track: "ml", title: "Parametric lens",
    tags: "definition · example",
    sum: "A lens with parameters, from the Para construction: a layer of a neural network together with its gradient.",
    src: "Cruttwell, Gavranović, Ghani, Wilson & Zanasi, arXiv:2103.01931",
    lean: "structure PLens (P P' A A' B B' : Type) where",
    used: [19, 0], href: n("Parametric-Lens"), pre: ["lens"],
