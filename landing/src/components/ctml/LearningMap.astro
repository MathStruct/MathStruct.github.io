---
// The learning map on /projects/category-theory-ml-wiki: 22 notes of the Category Theory & ML Wiki
// and the two projects that rest on them, as a prerequisite graph. The reader marks notes as known;
// a note whose prerequisites are all known is "ready"; choosing a goal draws the route to it.
//
// Facts come from the vault as of 2026-11-26 (MathStruct/CategoryTheory-ML-Wiki, default branch):
// - which notes and the prerequisite edges: the study order of "Start Here" (Stages 2–4,
//   Track E, Track F); every edge is also a wiki-link between the two notes;
// - "src": each note's "> Sources:" line, shortened;
// - "lean": the first line of each note's Lean tab;
// - "used": how many notes of Lenticulum.jl's vault (vault/) and Sophia's vault (vault/) link to
//   the note's page on mathstruct.org/CategoryTheory-ML-Wiki/.
// The summaries are written for this page. Progress is kept in this browser only (localStorage).
const wiki = "https://mathstruct.org/CategoryTheory-ML-Wiki/"

type Node = {
  id: string
  label: string[]
  x: number
  y: number
  track: "core" | "ml" | "db" | "project"
  title: string
  tags?: string
  sum: string
  src?: string
  lean?: string
  used?: [number, number]
  href: string
  pre: string[]
  bow?: Record<string, number>
}

const n = (slug: string) => wiki + slug

const nodes: Node[] = [
  {
    id: "category", label: ["Category"], x: 60, y: 270, track: "core", title: "Category",
    tags: "definition · example",
    sum: "Objects, arrows between them, and a composition that is associative and has identities. The vault calls it the template for every other note.",
    src: "7 Sketches Def. 3.6 · Kittenlab Lecture 3 · DaoFP §1–2, §8.1",
    lean: "class Category (C : Type u) extends CategoryStruct C",
    used: [0, 15], href: n("Category"), pre: [],
  },
  {
    id: "functor", label: ["Functor"], x: 170, y: 270, track: "core", title: "Functor",
    tags: "definition · theorem · proof · program",
    sum: "A map between categories: objects to objects, arrows to arrows, identities and composition preserved.",
    src: "7 Sketches Def. 3.35 · Kittenlab Lectures 4–6 · DaoFP §8.2",
    lean: "#check CategoryTheory.Functor    -- notation C ⥤ D",
    used: [3, 2], href: n("Functor"), pre: ["category"],
  },
  {
    id: "nat", label: ["Natural", "transformation"], x: 280, y: 270, track: "core", title: "Natural transformation",
    tags: "definition · theorem · proof · program",
    sum: "One arrow F(c) → G(c) for every object c, such that every naturality square commutes: a map between functors.",
    src: "7 Sketches Def. 3.49 · Kittenlab Lecture 7 · DaoFP §3",
    lean: "#check CategoryTheory.NatTrans",
    used: [0, 2], href: n("Natural-Transformation"), pre: ["functor"],
  },
  {
    id: "adj", label: ["Adjunction"], x: 390, y: 270, track: "core", title: "Adjunction",
    tags: "definition · example · theorem · proof",
    sum: "L ⊣ R: arrows L(c) → d correspond, naturally, to arrows c → R(d). Free and forgetful, currying, Σ ⊣ Δ ⊣ Π.",
    src: "7 Sketches §3.4 (Def. 3.70) · DaoFP Ch. 10 · CTfS §5.1",
    lean: "#check CategoryTheory.Adjunction    -- notation F ⊣ G",
    used: [0, 0], href: n("Adjunction"), pre: ["nat"],
  },
  {
    id: "monad", label: ["Monad"], x: 500, y: 270, track: "core", title: "Monad",
    tags: "definition · theorem · example · program",
    sum: "An endofunctor T with a unit η and a multiplication μ: a monoid of endofunctors, and the shape of side effects. Every adjunction gives one.",
    src: "DaoFP Ch. 14–15",
    lean: "#check @CategoryTheory.Monad",
    used: [3, 2], href: n("Monad"), pre: ["adj"],
  },
  {
    id: "kleisli", label: ["Kleisli", "category"], x: 610, y: 270, track: "core", title: "Kleisli category",
    tags: "definition · theorem · example",
    sum: "Arrows a → T b, composed with the “fish”; the monad laws are exactly its category laws. Probabilistic kernels live in one.",
    src: "DaoFP §14.2–14.3, §15.5",
    lean: "#check @CategoryTheory.Kleisli",
