---
// /about: who MathStruct is, where the projects came from, how we work and how we use AI. It
// replaces the Quartz page built from content/about.md, which stays for the site's search, graph and
// link previews: keep the two in step.
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"

const links = {
  lenticulum: "/projects/lenticulum-jl",
  sophia: "/projects/sophia",
  sophiaVault: "https://mathstruct.org/Sophia/",
  moonkale: "/projects/moonkale",
  wiki: "/projects/category-theory-ml-wiki",
  projects: "/#projects",
  blog: "/blog/",
  people: "/people/",
  authoring: "/guides/authoring",
  discussions: "https://github.com/MathStruct/MathStruct.github.io/discussions",
  github: "https://github.com/MathStruct",
  contributing: "https://github.com/MathStruct/Lenticulum.jl/blob/master/CONTRIBUTING.md",
  finiteFields: "https://github.com/MathStruct/FiniteFields",
  zenodo: "https://doi.org/10.5281/zenodo.23314723",
}

// the hero: one kind of structure, three projects
const graphs = [
  { what: "A statistical model", is: "a graph of factors", project: "Lenticulum.jl", href: links.lenticulum, does: "queried in any direction, not run one way" },
  { what: "A program", is: "a graph of definitions", project: "Sophia", href: links.sophia, does: "proofs and tests attached to what they are about" },
  { what: "A body of knowledge", is: "a graph of notes", project: "Moonkale", href: links.moonkale, does: "code, notes and data in one graph" },
]

// the 2025 pitch: what was missing
const gaps = [
  { k: "Distribution", t: "Papers are sealed", d: "Results travel through publishers and a slow round of peer review, as documents that cannot be linked into, corrected in place or built on directly." },
  { k: "The web", t: "Hyperlinks and wikis, unused", d: "Linked, collectively maintained knowledge became normal almost everywhere else. In mathematics it was used half-heartedly, ignored, or looked down on." },
  { k: "Certainty", t: "Lean, overlooked", d: "A machine-checked guarantee that a statement holds is something no journal can offer. For years most of the community paid it little attention." },
  { k: "Learning", t: "No personal paths", d: "Given what you know and where you want to go, the route through a knowledge graph is a computation. Nobody was computing it." },
  { k: "Data", t: "Nothing to train on", d: "There was no good data for autoformalisation, or for its reverse. A graph that keeps each informal statement next to its formal one is exactly that data." },
]

// how Lenticulum.jl came together
const pieces = [
  { k: "The question", t: "Learnable factor graphs", d: "Working on a sensor-fusion problem with GTSAM: factor graphs combine measurements beautifully, but they are Gaussian, linearised and built by hand. What if they were non-Gaussian, non-linear and learned? At the time, there was no obvious way.", href: "https://gtsam.org", src: "GTSAM" },
  { k: "Piece 1", t: "Implicit layers and adjoints", d: "Differentiating through the solution of an equation instead of through the steps of a solver.", href: "http://implicit-layers-tutorial.org", src: "Implicit layers tutorial" },
  { k: "Piece 2", t: "Energy-based models", d: "Models that score configurations instead of computing outputs, which is what a factor is.", href: "https://yann.lecun.com/exdb/publis/pdf/lecun-06.pdf", src: "LeCun et al., A tutorial on energy-based learning" },
  { k: "Piece 3", t: "Parametric lenses", d: "Curiosity led to category theory, and there to a compositional account of forward-and-backward computation with parameters.", href: "https://arxiv.org/abs/2103.01931", src: "Cruttwell et al., Categorical foundations of gradient-based learning" },
  { k: "Piece 4", t: "Diffusion models as priors", d: "Regularising an inverse problem with conditional sampling (DiffPIR, RED-Diff, proximal diffusion methods), then the theory behind it: how a learned prior and a data term are combined, step by step." },
  { k: "Piece 5", t: "Statistical games", d: "The category the rest had been pointing at: Bayesian lenses with a loss attached.", href: "https://arxiv.org/abs/2503.18608", src: "St Clere Smithe & Perin, AutoBayes" },
]

const principles = [
  { t: "Open by default", d: "Code, notes, design decisions and negative results are public. The software is MIT-licensed." },
  { t: "Every project is a vault", d: "An Obsidian vault published with Quartz: concepts, derivations and design notes link to each other and to the code, including what it does not do and what went wrong on the way." },
  { t: "Tested against what is known", d: "Where a closed form exists, the code is tested against it. Approximations say so, and status pages say what is unfinished." },
  { t: "Asynchronous, on GitHub", d: "Issues, pull requests and discussions. Comments on any page of any vault go straight into GitHub Discussions." },
  { t: "AI in the open", d: "We use AI coding agents, and say so. Each repository has an AGENTS.md with the same rules for agents and people." },
]

const stance = [
  { n: "01", t: "We are not in academia", d: "A vault of ours may contain a mistake, and that is fine. We would rather publish early and be corrected than polish in private. Found an error? Comment on the page, or better, fix it in a pull request." },
  { n: "02", t: "We have no staff to delegate to", d: "A professorship has doctoral students, a company has employees; we have neither, yet. We have agents that run experiments, check derivations and chase failing tests. Making that reliable is part of the research." },
  { n: "03", t: "The creative temperament has the edge", d: "Research long rewarded the industrious: whoever could grind through the implementation and the hundredth experiment. AI tilts the balance towards the person with more ideas than hands, many people with ADHD among them. Something of a great reversal." },
  { n: "04", t: "Build the moonshot now", d: "A project of MathStruct's scope would have been unthinkable for a group our size a year ago. If you have a moonshot in a drawer, now is the time to take it out." },
  { n: "05", t: "A different research format", d: "Open vaults instead of sealed papers, negative results written down instead of dropped. Some projects will fail, and Sophia's own risk list says it might. When one does, the vault will say why, so whoever tries next starts further along." },
]

const slop = [
  { t: "Human research code was never the gold standard", d: "The usual fate of a paper's code is a repository abandoned the day the paper is accepted, and a review of it rarely makes pleasant reading. Current models have learned established engineering practice, and much of what they write is cleaner than what most of us wrote by hand." },
  { t: "We work on the process, not just the prompts", d: "We follow and try out what is emerging as good practice for AI-written code: spec-driven development, careful harness design, chains of independent reviewers. The code is tested, benchmarked and profiled." },
  { t: "Correctness can be proved, not only tested", d: "Formal software verification shows that an implementation meets its specification. We intend to use it, and FiniteFields is a first step.", href: links.finiteFields, link: "FiniteFields on GitHub" },
  { t: "We read the code", d: "We wrote Julia, C++, Rust, Pascal and JavaScript long before any of this, and we still review what the agents produce. The gain in productivity is simply too large to leave on the table." },
]
const languages = ["Julia", "C++", "Rust", "Pascal", "JavaScript"]

const applications = ["Simulation", "Trading", "Omics", "Language models", "Robotics", "Your problem"]

const bibtex = `@software{lenticulum,
  author    = {{MathStruct}},
  title     = {Lenticulum.jl},
  publisher = {Zenodo},
  doi       = {10.5281/zenodo.23314723},
  url       = {https://mathstruct.org/Lenticulum.jl/}
}`
---

<Layout
  title="About · MathStruct"
  description="Who MathStruct is, where the projects came from, how we work, and why we use AI to move fast: an open-source research collective building tooling for mathematics, scientific computing and AI/ML."
  path="/about"
>
  <Nav />

  <main>
    <!-- ------------------------------------------------------------------ hero -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <span class="eyebrow reveal">About MathStruct</span>
          <h1 class="reveal" style="--d:.05s">
            One structure,<br /><span class="serif">taken seriously.</span>
          </h1>
          <p class="lede reveal" style="--d:.1s">
            MathStruct is an open-source research collective building tooling for mathematics,
            scientific computing and AI/ML. Our working bet is that all three keep producing the same
            thing: systems built from parts with typed interfaces, joined by composition. Category theory
            is the mathematics of exactly that, and taking it seriously gives tools that do more than
            their usual counterparts.
          </p>
          <div class="cta reveal" style="--d:.16s">
            <a class="btn btn--solid" href="#origins">Where this comes from <span class="arrow">→</span></a>
            <a class="btn" href="#ai">How we use AI</a>
            <a class="btn" href="#work">Work with us</a>
          </div>
        </div>

        <ol class="graphs reveal" style="--d:.1s" aria-label="The same structure in three projects">
          {graphs.map((g, i) => (
            <li>
              <a href={g.href}>
                <svg class="g-art" viewBox="0 0 64 40" aria-hidden="true">
                  {i === 0 && (
                    <g>
                      <line x1="10" y1="20" x2="32" y2="10" /><line x1="10" y1="20" x2="32" y2="30" />
                      <line x1="32" y1="10" x2="54" y2="20" /><line x1="32" y1="30" x2="54" y2="20" />
                      <circle cx="10" cy="20" r="4" /><circle cx="54" cy="20" r="4" />
                      <rect x="28.5" y="6.5" width="7" height="7" class="f" /><rect x="28.5" y="26.5" width="7" height="7" class="f" />
                    </g>
                  )}
                  {i === 1 && (
                    <g>
                      <line x1="32" y1="8" x2="14" y2="32" /><line x1="32" y1="8" x2="50" y2="32" /><line x1="32" y1="8" x2="32" y2="32" />
                      <circle cx="32" cy="8" r="4" /><circle cx="14" cy="32" r="4" /><circle cx="32" cy="32" r="4" /><circle cx="50" cy="32" r="4" class="f" />
                    </g>
                  )}
                  {i === 2 && (
                    <g>
                      <line x1="10" y1="12" x2="30" y2="28" /><line x1="30" y1="28" x2="54" y2="10" /><line x1="10" y1="12" x2="54" y2="10" /><line x1="30" y1="28" x2="50" y2="34" />
                      <circle cx="10" cy="12" r="4" /><circle cx="30" cy="28" r="4" class="f" /><circle cx="54" cy="10" r="4" /><circle cx="50" cy="34" r="3" />
                    </g>
                  )}
                </svg>
                <span class="g-text">
                  <span class="g-what">{g.what} is <span class="serif">{g.is}</span></span>
                  <span class="g-does mono">{g.project} · {g.does}</span>
                </span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ------------------------------------------------------------- origins -->
    <section class="section" id="origins">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Where this comes from · January 2025</span>
            <h2 class="reveal" style="--d:.05s">It started as <span class="serif">a pitch.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            MathStruct began as a startup idea: a new format for mathematical knowledge, a graph of
            definitions, statements and proofs that is at the same time a graph of code. It came from
            dissatisfaction with how mathematics is shared, and with how many better tools already
            existed and went unused.
          </p>
        </div>

        <ul class="gaps">
          {gaps.map((g, i) => (
            <li class="reveal" style={`--d:${0.04 * i}s`}>
              <span class="k mono">{g.k}</span>
              <h3>{g.t}</h3>
              <p>{g.d}</p>
            </li>
          ))}
        </ul>

        <div class="outcome reveal">
          <p>
            We wanted to build a platform around this. It did not get off the ground then; others have
            since gone after parts of the same picture, Axiom Math among them, with serious venture
            funding. The ideas stayed, and live on in
            <a class="il" href={links.sophia}>Sophia</a>, <a class="il" href={links.moonkale}>Moonkale</a> and
            the <a class="il" href={links.wiki}>Category Theory &amp; ML Wiki</a>.
          </p>
        </div>

        <h3 class="sub reveal" id="library">How the library came together</h3>
        <div class="lib">
        <div class="pieces-head">
          <p class="reveal">
            <a class="il" href={links.lenticulum}>Lenticulum.jl</a> has an older origin: a question that
            waited years for its answer, which arrived one piece at a time.
          </p>
          <p class="pieces-note mono reveal">From a sensor-fusion problem to a library, in six steps.</p>
        </div>
        <ol class="pieces">
          {pieces.map((p, i) => (
            <li class="reveal" style={`--d:${0.03 * i}s`}>
              <span class="dot" aria-hidden="true"></span>
              <span class="k mono">{p.k}</span>
              <h4>{p.t}</h4>
              <p>{p.d}</p>
              {p.href && <a class="src mono" href={p.href}>{p.src} ↗</a>}
            </li>
          ))}
          <li class="reveal pieces-end">
            <span class="dot" aria-hidden="true"></span>
            <span class="k mono">Assembled</span>
            <h4><a href={links.lenticulum}>Lenticulum.jl <span class="arrow">→</span></a></h4>
            <p>Relation learners on factor graphs, in Julia: learn relations, not functions.</p>
          </li>
        </ol>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------- statement -->
    <section class="statement" id="ai">
      <div class="wrap">
        <span class="eyebrow">Our motto</span>
        <p class="reveal">
          Move fast and break things. <span class="dim">Then write down what broke, and why.</span>
        </p>
      </div>
    </section>

    <!-- ---------------------------------------------------------------- stance -->
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">On AI</span>
            <h2 class="reveal" style="--d:.05s">Optimists, <span class="serif">with tests.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            We think the AI age is good news for research, and we would like to show how to do it well:
            fast, in the open, and checked.
          </p>
        </div>
        <ol class="stance">
          {stance.map((s, i) => (
            <li class="reveal" style={`--d:${0.04 * (i % 3)}s`}>
              <span class="n mono">{s.n}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>

        <div class="faq" id="slop">
          <div class="faq-q">
            <span class="eyebrow reveal">The obvious question</span>
            <h3 class="reveal" style="--d:.05s">“Isn’t this just <span class="serif">AI slop?</span>”</h3>
            <p class="reveal" style="--d:.1s">Fair question. Here is our answer.</p>
            <ul class="langs mono reveal" style="--d:.14s" aria-label="Languages we wrote before AI">
              {languages.map((l) => <li>{l}</li>)}
            </ul>
            <p class="langs-cap mono reveal" style="--d:.14s">written by hand, long before agents</p>
          </div>
          <ul class="faq-a">
            {slop.map((s, i) => (
              <li class="reveal" style={`--d:${0.04 * i}s`}>
                <h4>{s.t}</h4>
                <p>
                  {s.d}
                  {s.href && <> <a class="il" href={s.href}>{s.link} ↗</a></>}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ----------------------------------------------------------- how we work -->
    <section class="section" id="how">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">How we work</span>
            <h2 class="reveal" style="--d:.05s">Research, <span class="serif">written down.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            Fast does not mean careless about what we claim. Every project says what works, what does not,
            and what is planned.
          </p>
        </div>
        <ul class="principles">
          {principles.map((p, i) => (
            <li class="reveal" style={`--d:${0.04 * i}s`}>
              <span class="n mono">{String(i + 1).padStart(2, "0")}</span>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ------------------------------------------------------------ commercial -->
    <section class="section" id="work">
      <div class="wrap work">
        <div>
          <span class="eyebrow reveal">Work with us</span>
          <h2 class="reveal" style="--d:.05s">Have a problem? <span class="serif">Bring it.</span></h2>
        </div>
        <div>
          <p class="lede reveal" style="--d:.08s">
            Implicit learning, learning relations instead of functions, will take a while to become a
            familiar idea. If you want it applied to your problem, or suspect it fits but do not see how,
            talk to us: we can design and engineer a solution with you.
          </p>
          <ul class="apps mono reveal" style="--d:.12s">
            {applications.map((a) => <li>{a}</li>)}
          </ul>
          <p class="fine reveal" style="--d:.14s">
            The core projects are and will stay open source. Commercial products may be built downstream
            of them, by us or by others, without closing the core.
          </p>
          <div class="cta reveal" style="--d:.16s">
            <a class="btn btn--solid" href={links.discussions}>Start a conversation <span class="arrow">→</span></a>
            <a class="btn" href={links.lenticulum}>What Lenticulum.jl does</a>
          </div>
        </div>
      </div>
    </section>

    <!-- --------------------------------------------------- collaborate & cite -->
    <section class="cite-band" id="collaborate">
      <div class="wrap cite-grid">
        <div>
          <span class="eyebrow reveal">Collaborate</span>
          <h2 class="reveal" style="--d:.05s">Every level <span class="serif">counts.</span></h2>
          <p class="reveal" style="--d:.1s">
            A comment pointing out an error, a note, a test, a feature, a research question to work on
            together: all welcome. The best first step is a comment on the page in question, or a
            <a href={links.discussions}>discussion</a> on GitHub. Contributions are credited;
            <a href={links.contributing}>CONTRIBUTING.md</a> explains how, including authorship on
            releases.
          </p>
          <ul class="where reveal" style="--d:.14s">
            <li><a href={links.projects}><span>Projects</span><span class="mono">the software and the vaults</span></a></li>
            <li><a href={links.blog}><span>Blog</span><span class="mono">essays, results, releases</span></a></li>
            <li><a href={links.people}><span>People</span><span class="mono">who we are</span></a></li>
            <li><a href={links.authoring}><span>Authoring guide</span><span class="mono">write a page for this site</span></a></li>
          </ul>
        </div>
        <figure class="code reveal" style="--d:.08s">
          <figcaption class="mono">Cite us · concept DOI, always the latest release</figcaption>
          <pre><code>{bibtex}</code></pre>
        </figure>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ---------------------------------------------------------------- hero */
  .hero {
    padding: clamp(32px, 6vw, 72px) 0 clamp(56px, 8vw, 96px);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: -68px 0 0 0;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 65% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 65% 40%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .hero-copy {
    min-width: 0;
  }
  h1 {
    margin-top: 22px;
    font-size: clamp(46px, 7vw, 92px);
    letter-spacing: -0.05em;
    line-height: 0.96;
  }
  h1 .serif {
    letter-spacing: -0.03em;
  }
  .hero-copy .lede {
    margin-top: 26px;
    font-size: clamp(17px, 1.7vw, 20px);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .graphs {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: 0 30px 60px -40px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    min-width: 0;
  }
  .graphs li + li {
    border-top: 1px solid var(--line);
  }
  .graphs a {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 22px 22px;
    transition: background-color 0.2s var(--ease);
  }
  .graphs a:hover {
    background: var(--bg-sunken);
  }
  .g-art {
    width: 64px;
    height: 40px;
  }
  .g-art line {
    stroke: var(--line-strong);
    stroke-width: 1.4;
  }
  .g-art circle,
  .g-art rect {
    fill: var(--bg-raised);
    stroke: var(--fg);
    stroke-width: 1.4;
  }
  .g-art .f {
    fill: var(--fg);
  }
  .g-text {
    display: grid;
    gap: 4px;
    min-width: 0;
  }
  .g-what {
    font-size: 18px;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .g-what .serif {
    font-size: 1.12em;
  }
  .g-does {
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .graphs .arrow {
    color: var(--muted);
    transition: transform 0.25s var(--ease), color 0.2s var(--ease);
  }
  .graphs a:hover .arrow {
    color: var(--fg);
    transform: translateX(3px);
  }
  @media (max-width: 480px) {
    .graphs a {
      grid-template-columns: 1fr auto;
      padding: 18px;
    }
    .g-art {
      display: none;
    }
  }

  /* ------------------------------------------------------------- origins */
  .k {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .gaps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 720px) {
    .gaps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .gaps {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .gaps li {
    background: var(--bg);
    padding: 26px 22px 28px;
  }
  .gaps h3 {
    margin: 14px 0 10px;
    font-size: 19px;
  }
  .gaps p {
    margin: 0;
    font-size: 15px;
    color: var(--fg-2);
  }
  .outcome {
    margin-top: 32px;
    padding: 24px 26px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
  }
  .outcome p {
    margin: 0;
    max-width: 82ch;
    color: var(--fg-2);
  }

  .sub {
    margin-top: clamp(64px, 9vw, 104px);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-strong);
  }
  .lib {
    display: grid;
    gap: 8px;
  }
  @media (min-width: 960px) {
    .lib {
