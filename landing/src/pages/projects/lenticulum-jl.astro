---
// /projects/lenticulum-jl: the promotional page of Lenticulum.jl. It replaces the Quartz page
// built from content/projects/lenticulum-jl.md (which stays, for the site's search and link
// previews). Its facts come from the library's README and vault, as of 2026-11-24
// (MathStruct/Lenticulum.jl@7037623); update them from there, not from memory.
import Layout from "../../layouts/Layout.astro"
import Nav from "../../components/Nav.astro"
import Footer from "../../components/Footer.astro"
import FactorGraph from "../../components/FactorGraph.astro"
import RelationExplorer from "../../components/lenticulum/RelationExplorer.astro"
import HowItWorks from "../../components/lenticulum/HowItWorks.astro"
import FreeEnergy from "../../components/lenticulum/FreeEnergy.astro"
import { demos } from "../../lib/lenticulum-demos"

const links = {
  vault: "https://mathstruct.org/Lenticulum.jl/",
  api: "https://mathstruct.org/Lenticulum.jl/api/dev/",
  tutorials: "https://mathstruct.org/Lenticulum.jl/api/dev/tutorials/01_circle/",
  source: "https://github.com/MathStruct/Lenticulum.jl",
  doi: "https://doi.org/10.5281/zenodo.23314723",
  registry: "https://github.com/MathStruct/Registry",
}

// Projects and terms the page mentions, for readers who don't know them. In the arrays below,
// L(key, text) puts a link into a string that is rendered with set:html.
const ext: Record<string, string> = {
  julia: "https://julialang.org/",
  lux: "https://lux.csail.mit.edu/",
  luxcore: "https://github.com/LuxDL/Lux.jl/tree/main/lib/LuxCore",
  zygote: "https://github.com/FluxML/Zygote.jl",
  enzyme: "https://github.com/EnzymeAD/Enzyme.jl",
  forwarddiff: "https://github.com/JuliaDiff/ForwardDiff.jl",
  mooncake: "https://github.com/chalk-lab/Mooncake.jl",
  reactant: "https://github.com/EnzymeAD/Reactant.jl",
  optimisers: "https://github.com/FluxML/Optimisers.jl",
  rxinfer: "https://github.com/ReactiveBayes/RxInfer.jl",
  gtsam: "https://gtsam.org/",
  sciml: "https://sciml.ai/",
  deq: "https://docs.sciml.ai/DeepEquilibriumNetworks/stable/",
  diffeqflux: "https://docs.sciml.ai/DiffEqFlux/stable/",
  homotopy: "https://www.juliahomotopycontinuation.org/",
  general: "https://github.com/JuliaRegistries/General",
  deqpaper: "https://arxiv.org/abs/1909.01377",
  sde: "https://arxiv.org/abs/2011.13456",
  reddiff: "https://arxiv.org/abs/2305.04391",
  factorgraph: "https://en.wikipedia.org/wiki/Factor_graph",
  slam: "https://en.wikipedia.org/wiki/Simultaneous_localization_and_mapping",
  kalman: "https://en.wikipedia.org/wiki/Kalman_filter",
  bp: "https://en.wikipedia.org/wiki/Belief_propagation",
  elbo: "https://en.wikipedia.org/wiki/Evidence_lower_bound",
  em: "https://en.wikipedia.org/wiki/Expectation%E2%80%93maximization_algorithm",
  diffusion: "https://en.wikipedia.org/wiki/Diffusion_model",
  ad: "https://en.wikipedia.org/wiki/Automatic_differentiation",
  ift: "https://en.wikipedia.org/wiki/Implicit_function_theorem",
  variety: "https://en.wikipedia.org/wiki/Algebraic_variety",
  weierstrass: "https://en.wikipedia.org/wiki/Stone%E2%80%93Weierstrass_theorem",
  newton: "https://en.wikipedia.org/wiki/Newton%27s_method",
  meanshift: "https://en.wikipedia.org/wiki/Mean_shift",
  plates: "https://en.wikipedia.org/wiki/Plate_notation",
  evidence: "https://en.wikipedia.org/wiki/Marginal_likelihood",
  gan: "https://en.wikipedia.org/wiki/Generative_adversarial_network",
}
const L = (key: string, text: string) => `<a class="il" href="${ext[key]}">${text}</a>`

const analogy = [
  ["what is learned", "a function f : X → Y, like a polynomial", `a relation R ⊆ Z: the zero set of a polynomial, an ${L("variety", "algebraic variety")}`],
  ["answering a query", "one forward evaluation", "root finding: solve r(z) = 0 for the unknowns"],
  ["backpropagation", `reverse-mode ${L("ad", "automatic differentiation")}`, `the ${L("ift", "implicit function theorem")}`],
  ["what it can approximate", `any continuous function on a bounded, closed set (${L("weierstrass", "Weierstraß")})`, "any compact smooth manifold: a closed surface, a loop (Nash–Tognoli)"],
  ["how many answers", "always exactly one", "several, or none (then the closest point)"],
  ["direction", "fixed: input → output", "none: any coordinate can be the input"],
  ["cost of a query", "cheap", `expensive: an iterative solver (${L("newton", "Newton's method")}, …)`],
  ["wiring", "a directed acyclic graph, as in a neural network", "any graph, loops included"],
]

const paths = [
  {
    id: "A",
    title: "Gaussian factor graphs",
    body: `Exact state estimation and smoothing, as a ${L("kalman", "Kalman smoother")} does, on linear-Gaussian graphs; nonlinear measurements by linearisation; the free energy and its gradient. The graphs of ${L("gtsam", "GTSAM")}, with factors that can be learned.`,
    pkgs: ["LenticulumCore", "Mycelium", "Lenticulum"],
    link: { label: "Localisation tutorial", href: "https://mathstruct.org/Lenticulum.jl/api/dev/tutorials/08_localization/" },
  },
  {
    id: "B",
    title: "Relation learners",
    body: `A ${L("diffusion", "diffusion model")} queried in any direction by root finding, with gradients through the solver, a Gaussian error bar around each answer (the Laplace approximation) and conditional sampling.`,
    pkgs: ["VariationalDiffusion"],
    link: { label: "Implicit Diffusion Learners", href: "https://mathstruct.org/Lenticulum.jl/Relation-Learners/Implicit-Diffusion-Learners" },
  },
  {
    id: "C",
    title: "Structure and regimes",
    body: `Factors that switch between regimes, like a system with several operating modes; hierarchical models; ${L("em", "expectation maximisation")}; and search over model structures.`,
    pkgs: ["Lenticulum", "Mycelium", "MyceliumLearning"],
    link: { label: "Switching mixtures tutorial", href: "https://mathstruct.org/Lenticulum.jl/api/dev/tutorials/11_switching_mixtures/" },
  },
]

// Each body is rendered with set:html, so it can hold L(...) links.
const apiPkg = (slug: string) => `${links.api}packages/${slug}/`
const packages = [
  { name: "LenticulumCore", role: "the vocabulary", slug: "lenticulumcore", deps: ["LuxCore"],
    body: `What a factor is: its channels, polarities, energy and entropy. Also the belief types, the probability distributions a variable can carry (Gaussian, categorical, mixture, a point mass, samples), which convert to those of ${L("rxinfer", "RxInfer")}. It is to Lenticulum what ${L("luxcore", "LuxCore")} is to Lux: the interface, without the implementations.` },
  { name: "Mycelium", role: "inference", slug: "mycelium", deps: ["LenticulumCore"],
    body: `How factors are wired and in what order they talk: graphs, messages, schedules, ${L("plates", "plates")} (repeated copies of a subgraph), cluster nodes (variables handled jointly) and the free energy. Lux has no counterpart to this layer, because in a neural network the wiring is a directed acyclic graph and the order follows from it.` },
  { name: "MyceliumLearning", role: "learning", slug: "myceliumlearning", deps: ["Mycelium", "ImplicitSolvers"],
    body: `What changes the parameters, as opposed to what infers the beliefs: free-energy gradients, ${L("em", "expectation maximisation")} (EM) and the optimiser step.` },
  { name: "Lenticulum", role: "the factors", slug: "lenticulum", deps: ["Mycelium", "MyceliumLearning"],
    body: "The user-facing package: linear-Gaussian and nonlinear factors, linear constraints, switching and regime factors, likelihoods, and their closed-form M-steps (the update step of EM). The Gaussian factor doubles as the test oracle: everything it computes has a closed form, so the rest of the library is checked against it." },
  { name: "VariationalDiffusion", role: "relation learners", slug: "variationaldiffusion", deps: ["Mycelium", "ImplicitSolvers"],
    body: `${L("diffusion", "Diffusion models")} as relations: the ${L("sde", "variance-preserving SDE")} of DDPM-style models, implicit inference with gradients through the solver, answers as a Gaussian (Laplace) or a mixture of branches, conditional sampling, and two inverse-problem solvers, ${L("reddiff", "RED-Diff")} and ProxDM.` },
  { name: "ImplicitSolvers", role: "the numerics", slug: "implicitsolvers", deps: ["LinearAlgebra"],
    body: `The shared numerics: linear solves (dense, GMRES, MINRES), root finding (Picard, Broyden, ${L("newton", "Newton")}, trust region) and the linear systems that give gradients through the implicit function theorem. Every solve returns a report on how it converged.` },
]
const unreviewed = [
  { name: "ImplicitLayers", role: "equilibrium layers", slug: "implicitlayers", deps: ["MyceliumLearning", "ImplicitSolvers"],
    body: `${L("deq", "Deep equilibrium networks")} and ${L("diffeqflux", "neural ODEs")} from ${L("sciml", "SciML")}, wrapped as factors. Given the inner network rather than the finished layer, they can be queried in more than one direction.` },
  { name: "AlgebraicFactors", role: "discrete algebra", slug: "algebraicfactors", deps: ["Mycelium"],
    body: `Exact log-linear models of discrete data (toric models, in algebraic statistics), with optional multi-branch answers through ${L("homotopy", "homotopy continuation")}.` },
  { name: "AdversarialFactors", role: "generative models", slug: "adversarialfactors", deps: ["Mycelium"],
    body: `Implicit generative models, with the ${L("gan", "GAN")} read as a factor graph. A generator is a function with no residual behind it, so these factors run one way only.` },
]

// The tabs of the sublibraries section: the six core packages, then the three unreviewed ones.
const pkgTabs = [
  ...packages.map((k) => ({ ...k, reviewed: true })),
  ...unreviewed.map((k) => ({ ...k, reviewed: false })),
]
const pkgNames = new Set(pkgTabs.map((k) => k.name))

const works = [
  "Exact inference on linear-Gaussian graphs, checked on random trees against solving the whole joint Gaussian at once",
  "Switching chains, checked against enumerating every sequence of regimes",
  "Diffusion models as relations, queried in any direction; the learned field checked against the exact score (gradient of the log-density) of a Gaussian mixture",
  "Several answers per query: <code>implicit_roots</code> and <code>implicit_mixture</code> collect the branches, <code>implicit_sample</code> samples a query",
  `Training a relation through its own inference, with any of Julia's ${L("ad", "automatic differentiation")} libraries, chosen per model: ${L("zygote", "Zygote")}, ${L("enzyme", "Enzyme")}, ${L("forwarddiff", "ForwardDiff")}, ${L("mooncake", "Mooncake")} or ${L("reactant", "Reactant")}`,
  "Installable from the MathStruct registry, with eleven tutorials, the API documentation and a theory vault",
]
const limits = [
  "A multi-modal belief (a mixture) that reaches a Gaussian or constraint factor is replaced by one Gaussian with the same mean and covariance, unless the two share a cluster node",
  `Inference cost grows quadratically with the number of factors that have their own parameters (${L("plates", "plates")}, repeated copies with shared parameters, are not affected)`,
  "The diffusion learner finds the crest of a slightly blurred data density, not the exact set the data lies on, and every query returns a root, whether it lies on the relation or not",
  "Learned networks are small by design: a factor relates only a handful of coordinates",
]
const next = [
  { text: "The factor graph as a compiled program, with Sophia as its compiler backend", href: "/projects/sophia" },
  { text: "Factor graphs edited as diagrams in Moonkale, the graph-native editor", href: "/projects/moonkale" },
  { text: "Hyperparameters chosen by the evidence (the marginal likelihood), and incremental inference after a local change", href: links.vault },
  { text: "The whole library to the standard of SciML, Julia's scientific machine learning ecosystem: any AD library, any array type (GPUs included), parallel, benchmarked", href: links.vault },
]

const audiences = [
  { who: "Learn by running code", start: "The tutorials: the circle, a trained MLP, a robot arm, GTSAM-style localisation, switching mixtures, …", href: links.tutorials },
  { who: "From machine learning", start: "Implicit Diffusion Learners → Backpropagation through Implicit Inference", href: "https://mathstruct.org/Lenticulum.jl/Relation-Learners/Implicit-Diffusion-Learners" },
  { who: "From statistics or robotics", start: "The localisation tutorial → The Linear Gaussian Chain → Bethe Free Energy", href: "https://mathstruct.org/Lenticulum.jl/api/dev/tutorials/08_localization/" },
  { who: "From category theory", start: "Factors are Parameterized Statistical Games, with the CT-ML wiki as background", href: "https://mathstruct.org/Lenticulum.jl/Foundations/Factors-are-Parameterized-Statistical-Games" },
  { who: "Looking for an API", start: "The API documentation", href: links.api },
]

const install = `using Pkg
Pkg.Registry.add(RegistrySpec(url = "https://github.com/MathStruct/Registry.git"))   # once
Pkg.add("Lenticulum")             # paths A and C
Pkg.add("VariationalDiffusion")   # path B`

const example = `using VariationalDiffusion, LuxCore, Random
sched = VPSDE()
θ = range(0, 2π; length = 49)[1:48]
circle = NoisePredictor(GaussianMixtureEps(sched, vcat(cos.(θ)', sin.(θ)'); s = 0.05), sched)
ps, st = LuxCore.setup(Xoshiro(0), circle)            # a diffusion model of the unit circle
m = ImplicitDiffusion(circle, field_nodes(Xoshiro(1), 2; samples = 8))

up, _ = implicit_infer(m, [0.6,  0.5], [Inf, 0.0], ps, st)   # x clamped (∞), y free (0)
dn, _ = implicit_infer(m, [0.6, -0.5], [Inf, 0.0], ps, st)   # same query, other start
up.z[2], dn.z[2]                                              # ≈ (0.78, -0.78): two branches`

const bibtex = `@software{lenticulum,
  author    = {{MathStruct}},
  title     = {Lenticulum.jl},
  publisher = {Zenodo},
  doi       = {10.5281/zenodo.23314723},
  url       = {https://mathstruct.org/Lenticulum.jl/}
}`
---

<Layout
  title="Lenticulum.jl: learn relations, not functions · MathStruct"
  description="Lenticulum.jl learns relations instead of functions: one model, queried in any direction, composed on factor graphs, with uncertainty carried as beliefs. Open source, in Julia."
  path="/projects/lenticulum-jl"
>
  <Nav />

  <main>
    <!-- ------------------------------------------------------------------ hero -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <a class="crumb mono reveal" href="/#projects">← Projects · Models</a>
          <h1 class="reveal popover-hint" style="--d:.05s">
            Learn relations,<br /><span class="serif">not functions.</span>
          </h1>
          <p class="lede reveal popover-hint" style="--d:.1s">
            A neural network learns a function and runs one way. <strong>Lenticulum.jl</strong> learns
            a <em>relation</em> and decides at query time what is input and what is output. One trained
            model answers “given <em>x</em>, what is <em>y</em>?”, “given <em>y</em>, what is <em>x</em>?”
            and “fill in whatever is missing”.
          </p>
          <div class="cta reveal" style="--d:.16s">
            <a class="btn btn--solid" href="#get-started">Get started <span class="arrow">→</span></a>
            <a class="btn" href={links.source}>Source on GitHub</a>
          </div>
          <ul class="facts mono reveal" style="--d:.2s">
            <li><a href={ext.julia}>Julia</a></li>
            <li>MIT licence</li>
            <li>Research prototype</li>
            <li><a href={links.doi}>DOI 10.5281/zenodo.23314723</a></li>
          </ul>
        </div>
        <figure class="hero-art reveal" style="--d:.1s">
          <RelationExplorer mode="sweep" label="One model of a circle: as the clamped x moves, the answers for y follow it, two of them inside the circle and one past its edge" />
          <figcaption class="mono">
            one model of a circle · <span class="dash">- -</span> the clamped <em>x</em> · ● the answers for <em>y</em>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ----------------------------------------------------------- try it -->
    <section class="section" id="try">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Try it</span>
            <h2 class="reveal" style="--d:.05s">One model, <span class="serif">any direction.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            This is the example from the README, running in your browser: a model of points on a
            circle. The arrows show which way the model pushes a point to bring it onto the circle.
            A query holds some coordinates fixed (“clamps” them) and follows the arrows in the others
            until it stops. Given <em>x</em>, a circle has two values of <em>y</em>, or none: a
            function can't return either. A relation returns both.
          </p>
        </div>
        <div class="try reveal">
          <RelationExplorer mode="interactive" />
        </div>
        <p class="fineprint mono">
          The model drawn is a Gaussian mixture on 48 points of the unit circle, the closed form the
          README's example uses, a little more smoothed so that its field reads at this size. The
          browser follows the field by <a class="il" href={ext.meanshift}>mean shift</a>; Lenticulum
          solves for the same roots with <a class="il" href={ext.newton}>Newton's method</a>.
        </p>
      </div>
    </section>

    <!-- ------------------------------------------------------- how it works -->
    <section class="section" id="how">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">How it works</span>
            <h2 class="reveal" style="--d:.05s">Four ideas, <span class="serif">one library.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            Everything else follows from these. If you know
            <a href={ext.deqpaper}>deep equilibrium models</a> (networks whose output is the fixed
            point of a layer), steps 3 and 4 will look familiar. The difference is that the direction
            is not fixed, and each factor has an energy that reads as a negative log-probability.
          </p>
        </div>
        <HowItWorks />
      </div>
    </section>

    <!-- ----------------------------------------------------------- analogy -->
    <section class="section" id="analogy">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">The analogy behind it</span>
            <h2 class="reveal" style="--d:.05s">Polynomials <span class="serif">and varieties.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            A neural network is like a fitted polynomial <em>y</em> = <em>f</em><sub>θ</sub>(<em>x</em>).
            Lenticulum instead fits the set where a polynomial in all the coordinates is zero, as the
            circle is the zero set of <em>x</em>² + <em>y</em>² − 1. The polynomial case is the clean
            one, and it motivates every design choice:
          </p>
        </div>
        <div class="table-wrap reveal">
          <table class="compare">
            <thead>
              <tr><th></th><th>explicit</th><th>implicit · Lenticulum</th></tr>
            </thead>
            <tbody>
              {analogy.map(([k, a, b]) => (
                <tr><th scope="row">{k}</th><td set:html={a} /><td set:html={b} /></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ----------------------------------------------------------- compose -->
    <section class="section compose" id="compose">
      <div class="wrap compose-grid">
        <div>
          <span class="eyebrow reveal">Relations compose</span>
          <h2 class="reveal" style="--d:.05s">Wired into <span class="serif">factor graphs.</span></h2>
          <p class="lede reveal" style="--d:.1s">
            Larger models are <a href={ext.factorgraph}>factor graphs</a>: variables (circles) joined
            by factors (squares), the language of Kalman filters, robot mapping and probabilistic
            programming. Each factor is a learned or hand-written relation; each variable carries a
            belief, a probability distribution over its value. Inference is
            <a href={ext.bp}>message passing</a>: neighbours exchange beliefs until they agree. The
            training objective is the graph's free energy, the negative <a href={ext.elbo}>ELBO</a>
            of variational inference.
          </p>
          <ul class="ticks reveal" style="--d:.14s">
            <li><span>The same graphs and message passing as <a href={ext.gtsam}>GTSAM</a>, the library behind much of robot localisation and mapping (<a href={ext.slam}>SLAM</a>), generalised to learned, non-Gaussian factors</span></li>
            <li><span>Any model built with <a href={ext.lux}>Lux</a>, Julia's neural-network library, wraps as a factor</span></li>
            <li>Underneath, in the language of category theory, a factor is a Bayesian lens once a query picks its direction. You don't need any of that to use the code.</li>
          </ul>
        </div>
        <div class="compose-art reveal" style="--d:.1s">
          <FactorGraph />
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------- free energy -->
    <section class="section" id="free-energy">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Free energy</span>
            <h2 class="reveal" style="--d:.05s">Why it converges, <span class="serif">and when it does not.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            Inference, learning and, in active inference, acting are all descents on one number: the
            graph's free energy. Lenticulum.jl computes it on any graph as the Bethe free energy. Whether a
            descent arrives depends on the shape of the graph, on whether the beliefs carry their own
            motion, and on how the loops that do the descending are put together.
          </p>
        </div>
        <FreeEnergy />
      </div>
    </section>

    <!-- ------------------------------------------------------------- paths -->
    <section class="section" id="paths">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">What you can build</span>
            <h2 class="reveal" style="--d:.05s">Three paths <span class="serif">through it.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            The library is built around three uses, and work on them comes first. Each is its own
            set of packages; pick the one you need.
          </p>
        </div>
        <div class="paths">
          {paths.map((p, i) => (
            <article class="path reveal" style={`--d:${0.06 * i}s`}>
              <span class="path-id">{p.id}</span>
              <h3>{p.title}</h3>
              <p set:html={p.body} />
              <ul class="pkgs mono">{p.pkgs.map((k) => <li>{k}</li>)}</ul>
              <a class="more" href={p.link.href}>{p.link.label} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
        <p class="fineprint mono">
          Off the three paths are three more packages, not yet reviewed as the core was. They are
          listed with the others <a href="#packages">below</a>.
        </p>
      </div>
    </section>

    <!-- ---------------------------------------------------------- packages -->
    <section class="section" id="packages">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">The sublibraries</span>
            <h2 class="reveal" style="--d:.05s">Nine packages, <span class="serif">one stack.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            Lenticulum is split into small packages under <code>lib/</code>, each built on others;
            pick one to see what it does and what it builds on. All of them depend only on <a href={ext.luxcore}>LuxCore</a>, the
            small interface package of <a href={ext.lux}>Lux</a>, and not on Lux itself or on
            training libraries like <a href={ext.zygote}>Zygote</a> and
            <a href={ext.optimisers}>Optimisers</a>. Automatic differentiation and
            <a href={ext.reactant}>Reactant</a> (which compiles models for GPUs and TPUs) are
            switched on by package extensions, when you load them.
          </p>
        </div>
        <div class="pkg-tabs reveal" data-pkg-tabs>
          <div class="pkg-tablist" role="tablist" aria-label="Lenticulum packages" aria-orientation="vertical">
            {pkgTabs.map((k, i) => (
              <>
                {i === packages.length && (
                  <span class="pkg-group mono" role="presentation">Off the paths · not yet reviewed</span>
                )}
                <button
                  type="button"
                  role="tab"
                  id={`pkg-tab-${k.slug}`}
                  aria-controls={`pkg-panel-${k.slug}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  data-name={k.name}
                  class:list={["pkg-tab", { "pkg-tab--off": !k.reviewed }]}
                >
                  <span class="pkg-tab-name mono">{k.name}</span>
                  <span class="pkg-tab-role">{k.role}</span>
                </button>
              </>
            ))}
          </div>
          <div class="pkg-panels">
            {pkgTabs.map((k, i) => (
              <div
                class="pkg-panel"
                role="tabpanel"
                id={`pkg-panel-${k.slug}`}
                aria-labelledby={`pkg-tab-${k.slug}`}
                tabindex="0"
                hidden={i !== 0}
              >
                <div class="pkg-panel-head">
                  <h3 class="mono">{k.name}</h3>
