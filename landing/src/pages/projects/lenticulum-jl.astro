<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-pkg-tabs]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab
        t.setAttribute("aria-selected", String(on))
        t.tabIndex = on ? 0 : -1
        document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on
      }
      tab.scrollIntoView({ block: "nearest", inline: "nearest" })
      if (focus) tab.focus()
    }
    root.addEventListener("click", (e) => {
      const el = e.target as HTMLElement
      const tab = el.closest<HTMLButtonElement>('[role="tab"]')
      if (tab) return select(tab)
      const dep = el.closest<HTMLElement>("[data-goto]")
      if (dep) {
        const t = tabs.find((t) => t.dataset.name === dep.dataset.goto)
        if (t) select(t, true)
      }
    })
    root.addEventListener("keydown", (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement)
      if (i < 0) return
      const n = tabs.length
      const j =
        e.key === "ArrowDown" || e.key === "ArrowRight" ? (i + 1) % n
        : e.key === "ArrowUp" || e.key === "ArrowLeft" ? (i - 1 + n) % n
        : e.key === "Home" ? 0
        : e.key === "End" ? n - 1
        : -1
      if (j < 0) return
      e.preventDefault()
      select(tabs[j], true)
    })
  }
</script>

