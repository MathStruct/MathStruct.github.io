---
// /projects/lenticulumLM: the promotional page of LenticulumLM, in the style of /projects/lenticulum-jl,
// /projects/sophia and /projects/moonkale. LenticulumLM is not implemented: this page describes
// the plan and says so. What it says exists today is in Lenticulum.jl, Sophia and Moonkale, as of
// 2026-11-25; the plan's pieces that are already on Lenticulum.jl's backlog are cited by row
// (I10, O1–O5, L18) and its caveats come from the vault note Parked/Applications/Language Models.
// The Markdown note content/projects/lenticulumLM.md stays, for the site's search and previews.
import Layout from "../../layouts/Layout.astro"
import Nav from "../../components/Nav.astro"
import Footer from "../../components/Footer.astro"
import IsamText from "../../components/lenticulum-lm/IsamText.astro"
import DenoiseFront from "../../components/lenticulum-lm/DenoiseFront.astro"
import QueryDepth from "../../components/lenticulum-lm/QueryDepth.astro"

const links = {
  vault: "https://mathstruct.org/LenticulumLM/",
  discussions: "https://github.com/MathStruct/MathStruct.github.io/discussions",
  lenticulum: "/projects/lenticulum-jl",
  sophia: "/projects/sophia",
  moonkale: "/projects/moonkale",
  lmNote: "https://mathstruct.org/Lenticulum.jl/Parked/Applications/Language-Models",
  dynamic: "https://mathstruct.org/Lenticulum.jl/Gaussian-Graphs/Dynamic-Graphs",
  beliefs: "https://mathstruct.org/Lenticulum.jl/Gaussian-Graphs/Beliefs",
  isam2: "https://doi.org/10.1177/0278364911430419",
}

// ------------------------------------------------------------- hero picture
// many small factors, a sentence threading through them, and the messages it sends
let seed = 3
const rnd = () => {
  seed = (seed * 16807) % 2147483647
  return seed / 2147483647
}
const HW = 560
const HH = 460
const field: [number, number][] = []
for (let k = 0; field.length < 150 && k < 9000; k++) {
  const x = 14 + rnd() * (HW - 28)
  const y = 14 + rnd() * (HH - 28)
  if (field.every(([a, b]) => (a - x) ** 2 + (b - y) ** 2 > 30 ** 2)) field.push([x, y])
}
const words = ["every", "prime", "p", "is", "odd", "since", "2∣p", "▒▒", "░░"]
const path = words.map((w, i) => {
  const x = 46 + i * ((HW - 92) / (words.length - 1))
  const y = 250 + 46 * Math.sin(i * 0.8 + 0.4)
  return { w, x, y, noise: Math.max(0, (i - 5) / 3) }
})
// each word reaches its nearest factors
const reach = path.flatMap((p, i) =>
  field
    .map(([x, y], j) => ({ j, d: (x - p.x) ** 2 + (y - p.y) ** 2 }))
    .sort((a, b) => a.d - b.d)
    .slice(0, i < 7 ? 4 : 2)
    .map(({ j }) => ({ i, j })),
)
const hot = new Set(reach.map((r) => r.j))
const fieldEdges: [number, number][] = []
field.forEach(([x, y], i) => {
  field.forEach(([a, b], j) => {
    if (j > i && (a - x) ** 2 + (b - y) ** 2 < 52 ** 2) fieldEdges.push([i, j])
  })
})

// ---------------------------------------------------------------- the pitch
const compare: [string, string, string][] = [
  ["What the model is", "One fixed function: billions of parameters in one checkpoint", "A graph of thousands to tens of thousands of small relations (factors), kept in a store"],
  ["Adding knowledge", "Fine-tune or retrain the network, or paste it into the prompt", "Append factors, and train only those, against the graph around them"],
  ["Removing knowledge", "No reliable way: unlearning is an open problem", "Delete the factors: their contribution is gone"],
  ["Generating text", "Left to right, one committed token per forward pass", "Denoising beliefs at any positions; a token stays revisable until it settles"],
  ["Cost of a query", "The same for every query of a given length", "Set by the part of the graph the query reaches"],
  ["Uncertainty", "A softmax over the next token", "A belief on every position; the free energy says how much the factors disagree"],
  ["Hard constraints", "Mask logits, or check the output afterwards", "Constraint factors in the graph: a grammar, a type checker, a Lean 4 kernel"],
  ["Tools, retrieval, agent loop", "Code outside the model (the harness)", "Variables and factors inside the graph, edited like the rest"],
  ["Why this answer?", "Post-hoc attribution", "Per-factor energies: which factors pulled where"],
  ["Direction", "Prompt → continuation", "Any: continue, fill a gap, infer a premise from a conclusion"],
]

const slam: [string, string][] = [
  ["the pose xₜ of a robot", "the state of position t: a belief over its token"],
  ["an odometry factor between poses", "a local language relation between neighbouring positions"],
  ["a landmark", "a fact, a definition, a document from the store"],
  ["a loop closure", "a reference back: a name, a variable, a claim made earlier"],
  ["a GPS fix, a global constraint", "a verifier over a span: Lean 4, a type checker, a test"],
  ["the marginal covariance", "how settled a position is: its noise level"],
  ["iSAM2's incremental update", "the next token: re-solve only what the new factors reach"],
  ["relinearisation", "revising an earlier token when new evidence says it was wrong"],
]

const blocks = [
  { k: "Factors", t: "Small relation learners", d: "Diffusion models and EnergyNetworks from Lenticulum.jl, n-gram windows, small networks. Each is a relation, queried in any direction." },
  { k: "Beliefs", t: "A belief on every position", d: "Categorical over tokens, Gaussian over embeddings, a point for what is clamped, a mixture for several readings at once." },
  { k: "Belief algebra", t: "The wiring", d: "Pooling two beliefs is the product of their densities; for tokens, an elementwise product. Messages are exact where they can be and labelled approximate where not." },
  { k: "Store", t: "Factors in Sophia", d: "Content-addressed: a factor is keyed by the hash of its structure, versioned, and loaded only when a query reaches it." },
  { k: "Verifiers", t: "DSLs as factors", d: "A Lean 4 kernel, a type checker, a SQL engine, a JSON schema: hard factors, exact where they apply." },
  { k: "Learning", t: "Training along graphs", d: "Knowledge graphs and code graphs give the structure. A new fact or a new library version is a new factor, trained locally." },
  { k: "Harness", t: "The agent loop inside", d: "Retrieval, tool calls, plans and checks are subgraphs, edited in Moonkale like any other part of the model." },
  { k: "Budget", t: "Anytime inference", d: "The free energy measures disagreement: stop when it is low, reach further when it is high, abstain when it stays high." },
]

const exists = [
  { text: "Lenticulum.jl: factor graphs, message passing and free energies, checked against closed forms", href: links.lenticulum },
  { text: "Diffusion models and EnergyNetworks used as relations, queried in any direction by root finding", href: links.lenticulum },
  { text: "The belief algebra, with categorical beliefs and their exact product", href: links.beliefs },
  { text: "Sophia: a content-addressed store for code with a Datalog query language", href: links.sophia },
  { text: "Moonkale: a graph-native editor, with LLM agents behind an approval gate", href: links.moonkale },
]
const missing = [
  "LenticulumLM itself: no tokeniser, no language factors, no trained model",
  "Factors kept in a store and loaded where a query reaches (Lenticulum.jl backlog O1–O5)",
  "Incremental inference that reuses factorisations after an append (backlog I10)",
  "A GPU path for categorical beliefs; verifier factors; the harness as a graph",
]
const open = [
  "Adding the scores of diffusion models samples their product only at t = 0; along the trajectory it needs a correction, such as MCMC at each noise level (Du et al. 2023)",
  "Products of experts are hard to sample, and agreement tends to select bland text",
  "Message passing on loopy graphs need not converge; schedules matter",
  "The central bet, unmeasured: whether many small factors match one large network on fluency at equal compute",
]

const roadmap = [
  { n: "01", t: "An n-gram chain", d: "Window relations joined by separators, exact in every query direction. The smallest language model that is honestly a factor graph." },
  { n: "02", t: "Next token as an append", d: "Generation as incremental smoothing: each token appends factors, and only what they reach is re-solved." },
  { n: "03", t: "A store behind the graph", d: "Factors in Sophia, loaded lazily where a query reaches; training on a loaded subgraph, with parameters written back." },
  { n: "04", t: "Denoising over spans", d: "Diffusion and energy factors over spans of positions; several positions denoised at once; a sequence-level energy per step." },
  { n: "05", t: "Verifiers in the loop", d: "Lean 4 and type checkers as hard factors, so the parts they cover come out checked." },
  { n: "06", t: "The harness in the graph", d: "Retrieval, tools and agent loops as editable subgraphs in Moonkale; benchmarks against transformers at equal compute." },
]
---

<Layout
  title="LenticulumLM: a language model you can edit · MathStruct"
  description="LenticulumLM is a plan for a language model built as a factor graph of thousands of small models, wired by belief algebra: text generated as incremental smoothing, as iSAM2 does for SLAM; knowledge added and removed as factors; verifiers such as Lean 4 inside the model; cost set by query depth. Not implemented yet."
  path="/projects/lenticulumLM"
>
  <Nav />

  <main>
    <!-- ------------------------------------------------------------------ hero -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <a class="crumb mono reveal" href="/#projects">← Projects · Models</a>
          <h1 class="reveal" style="--d:.05s">
            A language model<br /><span class="serif">you can edit.</span>
          </h1>
          <p class="lede reveal" style="--d:.1s">
            A transformer is one frozen function. <strong>LenticulumLM</strong> is a plan for a
            language model built as a <em>factor graph</em>: thousands to tens of thousands of small
            models, each a relation between a few variables, wired together by the belief algebra of
            <a href={links.lenticulum}>Lenticulum.jl</a>. Factors are added, deleted and loaded from a
            store. Writing text becomes a problem roboticists already solve well, incremental
            smoothing, and the effort spent on a query grows with how deep the query reaches.
          </p>
          <div class="cta reveal" style="--d:.16s">
            <a class="btn btn--solid" href="#slam">See how it works <span class="arrow">→</span></a>
            <a class="btn" href="#status">What exists today</a>
          </div>
          <ul class="facts mono reveal" style="--d:.2s">
            <li>Julia</li>
            <li>On Lenticulum.jl · Sophia · Moonkale</li>
            <li class="fact-flag">Concept: not implemented yet</li>
          </ul>
        </div>
        <figure class="hero-art reveal" style="--d:.1s">
          <svg viewBox={`0 0 ${HW} ${HH}`} aria-label="Many small factors; a sentence runs through them, its earlier words clean and its last words still noise, each word exchanging messages with the factors nearest it">
            <g class="h-mesh">
              {fieldEdges.map(([a, b]) => (
                <line x1={field[a][0]} y1={field[a][1]} x2={field[b][0]} y2={field[b][1]} />
              ))}
            </g>
            <g class="h-reach">
              {reach.map(({ i, j }, k) => (
                <line
                  x1={path[i].x}
                  y1={path[i].y}
                  x2={field[j][0]}
                  y2={field[j][1]}
                  style={`animation-delay:${(-(k * 0.37) % 2.4).toFixed(2)}s`}
                />
              ))}
            </g>
            <g class="h-field">
              {field.map(([x, y], j) => (
                <rect x={x - 4} y={y - 4} width="8" height="8" class={hot.has(j) ? "hot" : ""} />
              ))}
            </g>
            <polyline class="h-path" points={path.map((p) => `${p.x},${p.y}`).join(" ")} />
            <g class="h-words">
              {path.map((p, i) => (
                <g style={`opacity:${(1 - 0.55 * p.noise).toFixed(2)}`}>
                  <circle cx={p.x} cy={p.y} r={7 + 9 * p.noise} class="h-halo" />
                  <circle cx={p.x} cy={p.y} r="6.5" class={p.noise > 0 ? "h-var noisy" : "h-var"} />
                  <text x={p.x} y={p.y + (i % 2 ? 30 : -18)}>{p.w}</text>
                </g>
              ))}
            </g>
          </svg>
          <figcaption class="mono">
            Squares are small models · circles are positions in the text · older words settled, newer ones still noise
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ------------------------------------------------------------ compare -->
    <section class="section" id="difference">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">The difference</span>
            <h2 class="reveal" style="--d:.05s">Not one network, <span class="serif">a graph of small ones.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            In statistical terms: a transformer is a single conditional distribution, fitted once.
            LenticulumLM is a <em>probabilistic graphical model</em> whose factors are learned
            relations, whose structure changes while it runs, and on which generation is
            inference. What that changes, row by row:
          </p>
        </div>
        <div class="table-wrap reveal">
          <table class="compare vs">
            <thead>
              <tr><th></th><th>a transformer LLM</th><th>LenticulumLM, the goal</th></tr>
            </thead>
            <tbody>
              {compare.map(([k, a, b]) => (
                <tr><th scope="row">{k}</th><td class="them">{a}</td><td>{b}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- --------------------------------------------------------------- slam -->
    <section class="section" id="slam">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Generation is SLAM</span>
            <h2 class="reveal" style="--d:.05s">Writing is mapping <span class="serif">while you move.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            A robot doing SLAM keeps a factor graph of where it has been and what it has seen, and
            adds to it at every step. <a href={links.isam2}>iSAM2</a> (Kaess et al., 2012) made
            that fast: it keeps the graph factorised and, when new factors arrive, re-solves only the
            variables they reach. Generating text has the same shape: each new token is a new pose,
            and a reference back to something said earlier is a loop closure.
          </p>
        </div>
        <div class="reveal">
          <IsamText />
        </div>
        <p class="fineprint mono">
          A toy, solved exactly in your browser. The halos are the marginal standard deviations of a
          small linear-Gaussian graph, recomputed at every step; the count of re-solved variables is
          iSAM2's for a graph eliminated in time order. In LenticulumLM the positions would carry
          beliefs over tokens, and the factors would be learned.
        </p>

        <div class="slam-map">
          <div class="slam-copy">
            <h3 class="reveal">The dictionary</h3>
            <p class="reveal" style="--d:.05s">
              Every piece of SLAM has a counterpart in text. Lenticulum.jl was built with
              <a class="il" href="https://gtsam.org/">GTSAM</a> as its inspiration, and its notes on
              <a class="il" href={links.dynamic}>dynamic graphs</a> already plan appends that touch
              only the newest factors, for SLAM and for next-token prediction alike (backlog I10, O4).
            </p>
          </div>
          <div class="table-wrap reveal" style="--d:.08s">
            <table class="compare">
              <thead>
                <tr><th>in SLAM</th><th>in LenticulumLM</th></tr>
              </thead>
              <tbody>
                {slam.map(([a, b]) => (
                  <tr><th scope="row">{a}</th><td>{b}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------ denoise -->
    <section class="section" id="denoise">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Denoising</span>
            <h2 class="reveal" style="--d:.05s">Text that settles, <span class="serif">not text that is committed.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            The factors can be diffusion models or energy networks, both of which Lenticulum.jl already
            queries as relations. Two ways to read generation with them. As a <em>stream</em>: older
            tokens carry little noise, newer ones a lot, and a front moves forward. Or as a
            <em>graph</em>: many positions are denoised at once, wherever the graph knows enough.
          </p>
        </div>
        <div class="reveal">
          <DenoiseFront />
        </div>
        <p class="fineprint mono">
          A schedule drawn in your browser, not a model. The stream reading is close to rolling
          diffusion (Ruhe et al., 2024) and diffusion forcing (Chen et al., 2024); masked diffusion
          language models (LLaDA, MDLM, SEDD) denoise all positions together. The graph reading lets
          the structure decide which positions go first.
        </p>
      </div>
    </section>

    <!-- -------------------------------------------------------------- depth -->
    <section class="section" id="depth">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Query depth is model size</span>
            <h2 class="reveal" style="--d:.05s">Pay for <span class="serif">what you ask.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            A transformer runs all of its weights for every token, whether the question is
            arithmetic or a proof. Here a query clamps the variables it mentions and loads only the
            factors connected to them through what is still unknown. A shallow question touches a
            few dozen factors; a deep one reaches far into the store. The model's size, for that
            query, is how far the query reaches.
          </p>
        </div>
        <div class="reveal">
          <QueryDepth />
        </div>
        <p class="fineprint mono">
          A random graph of a few hundred factors, drawn at build time. The presets are illustrative depths,
          not measurements. In the library this is the subgraph a query reaches by d-separation from
          its clamps, with a schedule restricted to it (Lenticulum.jl backlog O4).
        </p>
      </div>
    </section>

    <!-- ------------------------------------------------------------- verify -->
    <section class="section north" id="verified">
      <div class="wrap north-grid">
        <div>
          <span class="eyebrow reveal">Verified output</span>
          <h2 class="reveal" style="--d:.05s">A checker <span class="serif">is just a factor.</span></h2>
          <p class="lede reveal" style="--d:.1s">
            Any language with a checker can run inside the model as a factor: Lean 4, a type checker,
            a SQL engine, a JSON schema, a unit system. To the graph a checker is a hard constraint
            on the positions it covers, and it combines with the learned factors through the same
            belief algebra. The model can still propose something wrong, but in the parts a checker
            covers, nothing wrong comes out.
          </p>
          <ul class="ticks reveal" style="--d:.14s">
            <li><span>Constrained decoding already masks logits with a grammar. That is a categorical belief combined with a hard factor, done ad hoc. Here it is the general rule.</span></li>
            <li><span>A tool result (a compiler verdict, a query result, a retrieved document) is a clamped variable, and the rest is inferred around it.</span></li>
            <li><span>Lenticulum.jl marks every belief as exact or approximate. A checked span says exact; everything else says it is not.</span></li>
          </ul>
        </div>
        <figure class="code reveal" style="--d:.08s">
          <figcaption class="mono">A sketch of the intended API · none of this exists yet</figcaption>
          <pre><code><span class="c"># a model is a graph, backed by a store</span>
g = LMGraph(store = Sophia("factors"))

<span class="c"># the prompt is clamped</span>
prompt!(g, "Lemma: every prime p > 2 is odd.")

<span class="c"># retrieved facts become factors</span>
attach!(g, Retrieve(kind = :theorem, k = 8))

<span class="c"># a hard factor: the kernel must accept</span>
attach!(g, LeanFactor(span = :proof))

<span class="c"># denoise until the free energy is low,</span>
<span class="c"># or the budget runs out</span>
ans = denoise!(g; budget = :adaptive)

isexact(ans.proof)    <span class="c"># true: checked</span>
energies(ans)         <span class="c"># who pulled where</span></code></pre>
        </figure>
      </div>
    </section>

    <!-- ----------------------------------------------------------- learning -->
    <section class="section" id="learning">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Learning by insertion</span>
            <h2 class="reveal" style="--d:.05s">New knowledge, <span class="serif">new factors.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            Training runs along knowledge graphs and code graphs. Teaching the model a new library
            version, a new paper or a company's internal API means adding the factors that encode
            it and training those, against the graph around them. Nothing else is retrained.
          </p>
        </div>
        <div class="learn">
          <figure class="learn-art reveal" aria-label="A new fact enters as a new factor joined to the existing graph; only it and its neighbours are trained, the rest stays frozen">
            <svg viewBox="0 0 520 300">
              <g class="lg-old">
                <line x1="70" y1="80" x2="170" y2="60" /><line x1="170" y1="60" x2="250" y2="130" />
                <line x1="70" y1="80" x2="110" y2="190" /><line x1="110" y1="190" x2="250" y2="130" />
                <line x1="110" y1="190" x2="200" y2="250" /><line x1="250" y1="130" x2="200" y2="250" />
                <line x1="250" y1="130" x2="340" y2="90" />
              </g>
              <g class="lg-new">
                <line x1="340" y1="90" x2="430" y2="150" /><line x1="250" y1="130" x2="430" y2="150" />
                <line x1="430" y1="150" x2="400" y2="250" />
              </g>
              <g class="lg-nodes">
                <rect x="64" y="74" width="12" height="12" /><rect x="164" y="54" width="12" height="12" />
                <rect x="104" y="184" width="12" height="12" /><rect x="194" y="244" width="12" height="12" />
                <rect class="nb" x="244" y="124" width="12" height="12" /><rect class="nb" x="334" y="84" width="12" height="12" />
                <rect class="nb" x="394" y="244" width="12" height="12" />
                <rect class="nw" x="421" y="141" width="18" height="18" />
              </g>
              <text class="lbl" x="430" y="128">new fact</text>
              <text class="lbl" x="140" y="290">frozen</text>
              <text class="lbl" x="320" y="290">trained now</text>
            </svg>
          </figure>
          <ul class="ticks learn-ticks">
            <li class="reveal"><span><strong>Append.</strong> A fact, a definition, a function from the code graph: a new factor, keyed in Sophia by the hash of its structure, so the same definition is never stored twice.</span></li>
            <li class="reveal" style="--d:.04s"><span><strong>Train locally.</strong> Gradients are local to each factor's parameters, so a loaded subgraph trains as one block of coordinates and writes its parameters back (backlog O5).</span></li>
            <li class="reveal" style="--d:.08s"><span><strong>Delete.</strong> A factor removed is knowledge removed: for retracted facts, outdated APIs, and data that must be forgotten.</span></li>
            <li class="reveal" style="--d:.12s"><span><strong>Trace.</strong> Every answer comes with the factors that shaped it and their energies: provenance by construction.</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------ harness -->
    <section class="section" id="harness">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">The harness inside</span>
            <h2 class="reveal" style="--d:.05s">The agent loop <span class="serif">is part of the model.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            Around today's models sits a growing harness: prompts, retrieval, tool calls, agent
            chains, checks, all written outside the weights and invisible to them. In LenticulumLM
            they are subgraphs of the model itself: variables and factors that inference sees,
            training can tune, and a person can open and edit in <a href={links.moonkale}>Moonkale</a>.
          </p>
        </div>
        <div class="harness">
          <figure class="h-panel reveal">
            <figcaption class="mono">today</figcaption>
            <svg viewBox="0 0 420 260" aria-label="Today: a fixed model in the middle, and the harness around it as separate code">
              <rect class="hz-out" x="14" y="14" width="392" height="232" rx="14" />
              <text class="hz-k" x="30" y="40">harness: code outside the model</text>
              <rect class="hz-box solid" x="150" y="100" width="120" height="64" rx="10" />
              <text class="hz-t inv" x="210" y="128">LLM</text>
              <text class="hz-s inv" x="210" y="146">fixed weights</text>
              {[["prompt", 40, 70], ["retrieve", 300, 70], ["tools", 40, 200], ["check", 300, 200]].map(([t, x, y]) => (
                <g>
                  <rect class="hz-box" x={x as number} y={(y as number) - 16} width="80" height="30" rx="7" />
