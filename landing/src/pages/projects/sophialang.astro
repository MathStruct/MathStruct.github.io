---
// /projects/sophialang: the promotional page of sophialang, Sophia's own language, in the style of
// /projects/lenticulumLM. sophialang is planned and an experiment: its surface syntax, core
// calculus and name resolution exist (levels L1–L3) but nothing runs yet, and the page says so.
// Its facts come from Sophia's vault as of 2026-11-25 (MathStruct/Sophia@ec58583): SPEC-002
// Sophialang Principles, SPEC-003 Sophialang Core v0, the SophiaLang Overview, Backlog Sophialang
// and Milestones. Update them from there, not from memory.
// The Markdown note content/projects/sophialang.md stays, for the site's search and previews.
import Layout from "../../layouts/Layout.astro"
import Nav from "../../components/Nav.astro"
import Footer from "../../components/Footer.astro"
import Profiles from "../../components/sophialang/Profiles.astro"
import Levels from "../../components/sophialang/Levels.astro"
import Rebuild from "../../components/sophialang/Rebuild.astro"

const vault = "https://mathstruct.org/Sophia/"
const note = (path: string) => vault + path
const links = {
  vault,
  source: "https://github.com/MathStruct/Sophia",
  discussions: "https://github.com/MathStruct/MathStruct.github.io/discussions",
  overview: note("vault/Languages/SophiaLang/SophiaLang-Overview"),
  principles: note("vault/Specifications/SPEC-002-Sophialang-Principles"),
  core: note("vault/Specifications/SPEC-003-Sophialang-Core-v0"),
  precompile: note("vault/Design/Content-Addressed-Precompilation"),
  sp006: note("vault/Problems/SP-006-Open-method-tables-versus-content-addressing"),
  milestones: note("vault/Plans/Milestones"),
  risks: note("vault/Design/Open-Problems-and-Risks"),
  harper: "https://existentialtype.wordpress.com/2011/03/27/the-holy-trinity/",
  trinity: note("vault/Theory/Computational-Trinitarianism"),
  binaries: note("vault/Design/Minimal-Binaries"),
  query: note("vault/Languages/Sophia-Query/Sophia-Query-Overview"),
  compression: note("vault/Research/Compression-and-Canonical-Form"),
  llms: note("vault/Research/LLMs-and-Mixed-Language-Code"),
  sophia: "/projects/sophia",
  moonkale: "/projects/moonkale",
  lenticulum: "/projects/lenticulum-jl",
  unison: "https://www.unison-lang.org/",
}

// ---------------------------------------------------------------- the pitch
const compare: [string, string, string][] = [
  ["Getting started", "Pick the language by the hardest part of the program: dynamic and garbage-collected, or explicit and checked", "Write nothing about memory, threads or compilation; the system chooses, as Julia does"],
  ["Low-level control", "All or nothing per language: a borrow checker everywhere, or none anywhere", "Per section and per aspect: explicit memory in the hot loop, defaults everywhere else"],
  ["Guarantees", "What the language's one fixed checker can see", "Proofs where you write them, in a DSL per aspect, checked by a versioned checker"],
  ["The type system", "Fixed by the language", "Exchangeable: a dependent, refinement or other checker is something a build may require, never something the code generator needs"],
  ["Cost of types and proofs", "Zero in some languages, boxes and checks in others", "Erased: no run-time representation unless the program asks for one"],
  ["Runtime", "Always there (GC, JIT), or never", "Linked only for the aspects some section leaves to the system"],
  ["What a function is", "Text in a file, at a line", "A definition keyed by the hash of its normalised structure; names are labels on it"],
  ["After an edit", "Rebuild and re-test by file, crate or package", "Exactly the changed ids and what depends on them"],
]

// ---------------------------------------------------------------- a system, not a syntax
// From Compression and Canonical Form §1, SPEC-005 Rendering Profiles and LLMs and Mixed-Language
// Code §1, §4. Agents on the graph are planned; today models reach the store through a profile.
const system = [
  { k: "Stored", t: "Normalised and compressed", d: "No names, no variables, no whitespace: de Bruijn indices, references as 32-byte hashes, shared structure stored once. It is not meant to be read by anyone." },
  { k: "Shown", t: "In the syntax you choose", d: "Julia-like, Rust-like, Lean-like, Unison-like or one you configure: a profile is a setting, stored like any other. Two people can read one definition in two syntaxes and edit the same id." },
  { k: "Planned", t: "Agents on the graph", d: "Today models work through a profile, Julia-like text, and every write is parsed back. We want agents that work on the graph itself: core terms and mined abstractions, with no frontend language in between." },
]

// ---------------------------------------------------------------- the trinity
// Rows from Sophia's note Computational Trinitarianism §1; each row is a theorem about specific
// structures, not a claim that every logic is every type system.
const trinity: [string, string, string][] = [
  ["a proposition A", "a type A", "an object A"],
  ["a proof of A ⊢ B", "a program x : A ⊢ t : B", "a morphism A → B"],
  ["A ∧ B, A ∨ B", "a pair, a sum type", "a product, a coproduct"],
  ["A ⇒ B", "a function type A → B", "an exponential object"],
  ["a Horn clause", "a Datalog rule, a relation", "a relation in a regular category"],
]
const oneLanguage = [
  { k: "The typing language", d: "A specification is a type, stored as a definition like any other. Dependent, refinement or ownership types are sophialang, not a second notation bolted on." },
  { k: "The query language", d: "A query is a set of Horn clauses over the store's facts: logic programs, written as sophialang relation and rule definitions, hashed and named like functions." },
  { k: "The logic", d: "A proof is a term of the type it proves. It is stored, hashed, renamed and queried like code, and erased before the program runs." },
]

const exists = [
  { text: "A surface syntax with two editable profiles, Julia-flavoured and Rust-flavoured", href: links.overview },
  { text: "Round trip print → parse → same content id, tested on 20 000 random definitions", href: links.overview },
  { text: "The core calculus sophialang-core@0: de Bruijn binders, usages, holes, Unsafe marks, canonical encoding, SCC hashing", href: links.core },
  { text: "Name resolution against the store, and edits through Sophia's interface from Moonkale", href: links.sophia },
]
const missing = [
  "An interpreter over core terms: nothing runs yet (milestone M4)",
  "A type checker, dispatch resolution as stored facts, tests as cached facts (M4)",
  "Lowering to LLVM, minimal binaries, a JIT cache keyed by content id and argument types (M5)",
  "The proof DSLs for memory, concurrency and compilation",
  "A language for defining type systems: the third part of sophialang, not yet specified",
  "Self-hosting: sophialang written in sophialang (M6)",
]
const open = [
  "Open method tables against content addressing: generic functions must be nominal, and invalidation must be precise (SP-006)",
  "Relations need an identity of their own: two with the same signature and no rules would otherwise be one",
  "Whether the proof DSLs are something working programmers will write",
  "Whether Julia's semantics, zero overhead and optional dependent types fit in one language at all",
]

const levels: [string, string, boolean | null][] = [
  ["L1 · Parsed", "Two rendering profiles; a parser with limits and diagnostics", true],
  ["L2 · Normalised", "Core terms, canonical encoding, hashing; names never change ids", true],
  ["L3 · Resolved", "Locals, the store's names, built-ins and constructors", true],
  ["L4 · Lowered", "The target IR: other languages would lower into it", null],
  ["L5 · Executable", "No evaluator and no type checker yet", false],
  ["L6 · Verified", "Not yet", false],
]

const roadmap = [
  { n: "M4", t: "It runs", d: "An interpreter over core terms, a simple checker, dispatch resolution recorded as facts, and tests cached as facts." },
  { n: "M5", t: "It compiles", d: "Lowering through MLIR to LLVM, minimal binaries, and a JIT cache keyed by content id and argument types." },
  { n: "M6", t: "It hosts itself", d: "The printer in sophialang, then the compile DSL and the dependent checker; the Rust code becomes a small bootstrap kernel." },
  { n: "B-037", t: "Type systems as data", d: "A language for defining type systems, so a checker is a stored, versioned thing a build can ask for." },
  { n: "Later", t: "Agents on the graph", d: "Models that read and write core terms and mined abstractions directly, instead of working through a frontend language like Julia." },
  { n: "B-045", t: "In the browser", d: "sophialang compiled to WebAssembly, and Sophia's crates opened and queried in a browser." },
  { n: "P0 · 3", t: "Reproducible dispatch", d: "A method table changes, and an earlier world still reproduces the original calls. It passes in the store; end to end it needs M4's interpreter." },
]
---

<Layout
  title="sophialang: one language, from prototype to proof · MathStruct"
  description="sophialang is the planned language of the Sophia code store: Julia-flavoured, with multiple dispatch, erased dependent types as an exchangeable checker, and a principle of autoresolve → unsafe → safe for memory, concurrency and compilation, chosen per section of code. Its definitions are keyed by their structure, so an edit rebuilds and re-tests only what it can affect. An experiment: the syntax and core exist, nothing runs yet."
  path="/projects/sophialang"
>
  <Nav />

  <main>
    <!-- ------------------------------------------------------------------ hero -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <a class="crumb mono reveal" href="/#projects">← Projects · Code</a>
          <h1 class="reveal" style="--d:.05s">
            Write it like Julia.<br /><span class="serif">Prove it where it matters.</span>
          </h1>
          <p class="lede reveal" style="--d:.1s">
            <strong>sophialang</strong> is the planned language of the <a href={links.sophia}>Sophia</a>
            code store. You start with nothing specified, and the system chooses: garbage collection,
            a scheduler, compilation on demand. Where it matters, you take control of one aspect of one
            section, and it is marked <em>unsafe</em>. Add a proof, and it becomes <em>safe</em>. And
            because every definition is keyed by its structure, not its file, an edit rebuilds and
            re-tests only what it can affect.
          </p>
          <div class="cta reveal" style="--d:.16s">
            <a class="btn btn--solid" href="#levels">See why <span class="arrow">→</span></a>
            <a class="btn" href="#status">What exists today</a>
          </div>
          <ul class="facts mono reveal" style="--d:.2s">
            <li>Rust today, sophialang later</li>
            <li>Part of Sophia</li>
            <li class="fact-flag">Planned · an experiment</li>
          </ul>
        </div>
        <figure class="hero-art reveal" style="--d:.1s">
          <Profiles />
          <figcaption class="mono">
            Julia and Rust printed and parsed by sophialang-syntax today, Lean and Unison planned; ids from sophialang-core
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- -------------------------------------------------------------- banner -->
    <section class="band">
      <div class="wrap">
        <p class="band-text reveal">
          <span class="mono band-k">Status</span>
          sophialang is a plan with a first core. It can be written, printed, parsed and stored;
          it cannot run. Whether it can meet all of its specifications is what the experiment is for.
        </p>
      </div>
    </section>

    <!-- -------------------------------------------------------------- system -->
    <section class="section" id="system">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Not a text format</span>
            <h2 class="reveal" style="--d:.05s">A programming system, <span class="serif">not a programming language.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            sophialang is not stored as text, and it is not meant to be read. What the store holds is
            the normalised, compressed core term. What you read is a projection of it, in the syntax
            your configuration asks for. So sophialang is less a programming language than a
            programming system: one store of definitions, with as many surfaces as its users want.
            The idea is not ours alone: <a href={links.unison}>Unison</a> pioneered code stored by
            the hash of its structure, with names as labels and no source files, and Sophia builds
            on it.
          </p>
        </div>
        <ul class="features features--3 reveal">
          {system.map((f) => (
            <li class="feature">
              <span class="mono feature-k">{f.k}</span>
              <h3>{f.t}</h3>
              <p>{f.d}</p>
            </li>
          ))}
        </ul>
        <p class="fineprint mono">
          From Sophia's notes <a class="il" href={links.compression}>Compression and Canonical Form</a>
          and <a class="il" href={links.llms}>LLMs and Mixed-Language Code</a>. Compression here is
          structural sharing, which exists; mining a corpus for abstractions is planned, as a derived
          layer that never changes ids. Julia and Rust profiles exist; Lean and Unison are planned. Sophia's agent
          server already lets models query and read the store; agents that edit the graph directly
          are for the future.
        </p>
      </div>
    </section>

    <!-- -------------------------------------------------------------- levels -->
    <section class="section" id="levels">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">autoresolve → unsafe → safe</span>
            <h2 class="reveal" style="--d:.05s">Pay for control <span class="serif">only where you need it.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            Today the hardest part of a program picks the language for all of it. One hot loop that
            needs manual memory, and the whole codebase lives under a borrow checker; one prototype
            that needs to move fast, and nothing can ever be proved about it. sophialang makes the
            choice per <em>section</em> of code and per aspect (memory, concurrency, compilation),
            each on three levels.
          </p>
        </div>
        <div class="reveal">
          <Levels />
        </div>
        <p class="fineprint mono">
          An illustration of the rules in <a class="il" href={links.principles}>SPEC-002</a> §2–§3,
          drawn in your browser; nothing is compiled. A runtime library is linked only when some
          section leaves its aspect to the system; the audit is the query Rust's <code>unsafe</code>
          keyword makes possible, extended to memory, concurrency and compilation. “Mostly safe”, a
          proof with named assumptions, is recorded as such and never rounded up.
        </p>
      </div>
    </section>

    <!-- ------------------------------------------------------------- rebuild -->
    <section class="section" id="rebuild">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Keyed by structure</span>
            <h2 class="reveal" style="--d:.05s">Change one thing. <span class="serif">Rebuild one thing.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            In Sophia a definition's identity is the hash of its normalised structure, and so is
            every compiled specialisation and every test result. A rename changes no hash. A proof
            changes no hash. A real edit changes the hashes of exactly the definitions that refer
            to it. So the question “what must be recompiled, which tests must re-run?” has a
            precise answer, instead of “the package”.
          </p>
        </div>
        <div class="reveal">
          <Rebuild />
        </div>
        <p class="fineprint mono">
          A toy program; the rules are those of SPEC-002 §4 and §8. The Nat case is sophialang-core's
          own dependency test: changing Nat changes add and its test, but not double. Tools differ in
          how coarse they are today (Julia's package images, a crate, a file), and a precise cache is
          what <a class="il" href={links.precompile}>content-addressed precompilation</a> is about: the
          win is not caching, it is precision of invalidation. A test with effects that escape the
          store (files, network, clocks) is never cached. Content-addressed definitions, with names
          as labels, come from <a class="il" href={links.unison}>Unison</a>.
        </p>
      </div>
    </section>

    <!-- ------------------------------------------------------------ compare -->
    <section class="section" id="difference">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Why another language</span>
            <h2 class="reveal" style="--d:.05s">One language, <span class="serif">from prototype to proof.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            Julia showed that dynamism and performance can be reconciled by design. Rust showed
            that safety can be checked without a garbage collector. Lean and Idris showed that
            proofs and programs can be one thing, and Idris 2 that types can cost nothing at run
            time. <a href={links.unison}>Unison</a> showed that code can be identified by the hash of
            its structure rather than by its name or file. sophialang is the bet that these do not
            have to be five different languages.
          </p>
        </div>
        <div class="table-wrap reveal">
          <table class="compare vs">
            <thead>
              <tr><th></th><th>choosing a language today</th><th>sophialang, the goal</th></tr>
            </thead>
            <tbody>
              {compare.map(([k, a, b]) => (
                <tr><th scope="row">{k}</th><td class="them">{a}</td><td>{b}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------- trinity -->
    <section class="section" id="trinity">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Computational trinitarianism</span>
            <h2 class="reveal" style="--d:.05s">Three views of one subject. <span class="serif">One language.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            <a href={links.harper}>Computational trinitarianism</a> is Robert Harper's name for an
            old observation: logic, type theory and category theory are three views of one subject.
            A proposition is a type is an object; a proof is a program is a morphism. Each
            correspondence is a theorem, so what is found in one view holds in the other two.
          </p>
        </div>
        <div class="table-wrap reveal">
          <table class="compare tri">
            <thead>
              <tr><th>logic</th><th>type theory</th><th>category theory</th></tr>
            </thead>
            <tbody>
              {trinity.map(([l, t, c]) => (
                <tr><td>{l}</td><td>{t}</td><td>{c}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="tri-grid">
          <div>
            <h3 class="tri-h reveal">So sophialang is not three languages.</h3>
            <p class="reveal" style="--d:.05s">
              Most systems ship a type language, a query language and a proof language, each with
              its own syntax, its own semantics and its own tools. Under the trinity they are the
              same thing seen three ways, and sophialang treats them as one language over one
              store.
            </p>
            <ul class="ticks reveal" style="--d:.1s">
              {oneLanguage.map((o) => <li><span><strong>{o.k}.</strong> {o.d}</span></li>)}
            </ul>
          </div>
          <figure class="code reveal" style="--d:.08s">
            <figcaption class="mono">Compiling is a query · Sophia's query syntax</figcaption>
            <pre><code><span class="c"># everything main depends on, statically:</span>
<span class="c"># a graph walk over the store's refs</span>
query closure(main::Id)
    dep(a, b) = refs(a, b)
    dep(a, c) = refs(a, b) && dep(b, c)
    select d where dep(main, d)
end

<span class="c"># the binary is the compiled answer, plus the</span>
<span class="c"># methods dispatch can reach at pinned versions</span>
binary(main) = compile(closure(main) ∪ dispatch_closure(main))</code></pre>
          </figure>
        </div>

        <div class="tri-band reveal">
          <span class="eyebrow">An exact binary is a query</span>
          <p>
            Because a definition's id is the hash of its structure, the set of everything
            <code>main</code> needs is not a guess: it is the answer to a recursive query over the
            graph store. Compiling to a minimal binary is that query, compiled. No “include the
            whole package”, no heuristic tree shaking. Types, proofs, tests and the store itself
            are erased, and a GC, dispatcher or JIT is linked only when some section of the
            closure asks for it.
          </p>
        </div>

        <p class="fineprint mono">
          From Sophia's notes <a class="il" href={links.trinity}>Computational Trinitarianism</a>
          and <a class="il" href={links.binaries}>Minimal Binaries</a>; see also Harper,
          <a class="il" href={links.harper}><em>The Holy Trinity</em></a> (2011). Today Sophia's
          <a class="il" href={links.query}>query language</a> runs (it is the store's only language
          at L5) as its own crate on shared primitives; folding it into sophialang's relations is the
          design, not yet the code. The query above is in that syntax; <code>compile</code> and the
          dispatch closure need M5. The binary is exact under a closed-world contract: no
          <code>eval</code>, reflection or dynamic loading unless their runtime is linked.
        </p>
      </div>
    </section>

    <!-- -------------------------------------------------------------- erased -->
    <section class="section north" id="erased">
      <div class="wrap north-grid">
        <div>
          <span class="eyebrow reveal">Zero inherent overhead</span>
          <h2 class="reveal" style="--d:.05s">Types and proofs <span class="serif">cost nothing at run time.</span></h2>
          <p class="lede reveal" style="--d:.1s">
            sophialang may contain nothing that makes compiled code inherently slower than C++,
            Rust or Julia. When in doubt about behaviour, it does what Julia does: machine integers,
            IEEE floats, multiple dispatch, promotion as ordinary methods.
          </p>
          <ul class="ticks reveal" style="--d:.14s">
            <li><span><strong>Erased.</strong> Every binder carries a usage; usage-0 binders (types, proofs) have no run-time representation. The quantitative type theory of Atkey and Idris 2.</span></li>
            <li><span><strong>Exchangeable.</strong> The code generator needs only representation types and the types dispatch sees. A dependent or refinement checker changes what a build accepts, never what it generates.</span></li>
            <li><span><strong>Visible costs.</strong> Concrete types are unboxed. An abstract type is boxed because you asked for it, and the store records the fact.</span></li>
            <li><span><strong>No store in the hot path.</strong> Every identity is resolved at build time; the compiled program never queries the store.</span></li>
          </ul>
        </div>
        <figure class="code reveal" style="--d:.08s">
          <figcaption class="mono">A sketch of the intended surface · none of this runs yet</figcaption>
          <pre><code><span class="c"># autoresolve: GC, JIT, dynamic dispatch,</span>
<span class="c"># chosen for you and recorded as facts</span>
function mean(xs::Vector{"{"}Float64{"}"})::Float64
    sum(xs) / length(xs)
end

<span class="c"># unsafe: explicit memory, shown in every view</span>
function step!(w::World)
    unsafe(:memory) do
        buf = alloc(w.arena, Float64, w.n)
        <span class="c"># …</span>
    end
end

<span class="c"># safe: the same code, plus a checked proof;</span>
<span class="c"># step!'s content id does not change</span>
proves(:memory, step!, Ownership(w.arena))</code></pre>
        </figure>
      </div>
    </section>

    <!-- ------------------------------------------------------------ status -->
    <section class="section" id="status">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Where it stands</span>
            <h2 class="reveal" style="--d:.05s">An experiment, <span class="serif">with a first core.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            sophialang exists as specifications and two Rust crates, sophialang-core and
            sophialang-syntax. They are already what Moonkale edits through Sophia. Everything that
            makes it a language you can run is planned. We do not know yet whether all of it can
            be had at once; finding out is the point.
          </p>
        </div>

        <div class="table-wrap reveal">
          <table class="compare lvl">
            <thead>
              <tr><th>level</th><th>state</th><th></th></tr>
            </thead>
            <tbody>
              {levels.map(([k, d, ok]) => (
                <tr>
                  <th scope="row">{k}</th>
                  <td>{d}</td>
                  <td class="lvl-s mono"><span class:list={["pill", { yes: ok === true, no: ok === false }]}>{ok === true ? "exists" : ok === false ? "planned" : "by design"}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="status">
          <div class="col reveal">
            <h3 class="col-h mono">Exists today</h3>
            <ul class="ticks">{exists.map((n) => <li><a href={n.href}>{n.text}</a></li>)}</ul>
          </div>
          <div class="col reveal" style="--d:.06s">
            <h3 class="col-h mono">Not built yet</h3>
            <ul class="ticks ticks--next">{missing.map((w) => <li>{w}</li>)}</ul>
          </div>
          <div class="col reveal" style="--d:.12s">
            <h3 class="col-h mono">Open questions</h3>
            <ul class="ticks ticks--limit">{open.map((w) => <li>{w}</li>)}</ul>
          </div>
        </div>
        <p class="fineprint mono">
          From Sophia's vault: the <a class="il" href={links.overview}>SophiaLang overview</a>, the
          <a class="il" href={links.principles}>principles</a>, the
          <a class="il" href={links.core}>core calculus</a>,
          <a class="il" href={links.sp006}>SP-006</a> and the
          <a class="il" href={links.risks}>open problems and risks</a>.
        </p>

        <h3 class="sub reveal">The road</h3>
        <ol class="road">
          {roadmap.map((r, i) => (
            <li class="reveal" style={`--d:${0.04 * (i % 3)}s`}>
              <span class="road-n mono">{r.n}</span>
              <h4>{r.t}</h4>
              <p>{r.d}</p>
            </li>
          ))}
