---
// /projects/sophia: the promotional page of Sophia, in the style of /projects/lenticulum-jl. It
// replaces the Quartz page built from content/projects/sophia.md (which stays, for the site's
// search and link previews). Its facts come from Sophia's README and vault, as of 2026-11-21
// (MathStruct/Sophia@ec58583, tag v0.1.12); update them from there, not from memory.
import Layout from "../../layouts/Layout.astro"
import Nav from "../../components/Nav.astro"
import Footer from "../../components/Footer.astro"
import ContentId from "../../components/sophia/ContentId.astro"
import HowItWorks from "../../components/sophia/HowItWorks.astro"

const vault = "https://mathstruct.org/Sophia/"
const note = (path: string) => vault + path
const links = {
  vault,
  source: "https://github.com/MathStruct/Sophia",
  status: note("vault/Status"),
  milestones: note("vault/Plans/Milestones"),
  risks: note("vault/Design/Open-Problems-and-Risks"),
  equivalence: note("vault/Design/Equivalence-and-Witnesses"),
  hashing: note("vault/Design/Hashing-and-Identity"),
  languages: note("vault/Languages/Languages"),
  query: note("vault/Specifications/SPEC-007-Sophia-Query-Language"),
  metamath: note("vault/Languages/Metamath/Metamath-Overview"),
  contributing: "https://github.com/MathStruct/Sophia/blob/master/CONTRIBUTING.md",
}

// vault/Design/Equivalence and Witnesses.md, "The ladder of strength"
const ladder = [
  ["alpha", "identical after normalisation", "comparing hashes", true],
  ["defeq", "equal by definition, as a type checker decides", "the kernel, by normalisation", true],
  ["rewrite", "connected by a chain of trusted rewrite rules", "proof extraction from an e-graph", true],
  ["observational", "no context can tell them apart, for a stated observation", "a proof term", true],
  ["tested", "agree on a test suite or on property fuzzing", "running the tests", false],
  ["asserted", "a person said so", "a signature", false],
] as const

// README "Languages" and vault/Languages/Languages.md: ● yes · ◐ partly · ○ no
const levels = ["parsed", "normalised", "resolved", "lowered", "runs", "verified"]
const support: { lang: string; cells: string[]; note: string }[] = [
  { lang: "sophialang", cells: ["●", "●", "●", "●", "○", "○"], note: "the store's own language; it is the core" },
  { lang: "Sophia queries", cells: ["●", "●", "●", "●", "●", "○"], note: "runs on four backends; checked by differential tests" },
  { lang: "Metamath", cells: ["●", "●", "●", "◐", "○", "◐"], note: "dependency analysis checked against metamath.exe" },
  { lang: "Julia", cells: ["●", "●", "◐", "○", "○", "○"], note: "module scope; 95.1 % agreement with Julia's own method table" },
  { lang: "Python", cells: ["●", "●", "◐", "○", "○", "○"], note: "names resolved within one file" },
  { lang: "Rust", cells: ["●", "◐", "◐", "○", "○", "○"], note: "for, match, closures, while let and let-else are refused" },
]

const milestones = [
  { id: "M0", title: "Identity", state: "done" },
  { id: "M1", title: "The store", state: "done" },
  { id: "M2", title: "Moonkale interface", state: "done" },
  { id: "M3a", title: "Query language", state: "first form" },
  { id: "M3b", title: "Tools for agents (MCP)", state: "" },
  { id: "M4", title: "Running code", state: "" },
  { id: "M5", title: "Compiling to LLVM", state: "" },
  { id: "M6", title: "Self-hosting starts", state: "" },
  { id: "M7", title: "More languages", state: "" },
]

const works = [
  "Content ids on four database backends (SQLite, redb, LMDB, DuckDB) behind one interface, with one conformance suite and benchmarks",
  "sophialang printed and parsed back Julia-flavoured or Rust-flavoured, round-trip tested on 20 000 random definitions",
  "A Datalog query language with its own content ids, run natively on every backend and translated to SQL on SQLite",
  "The code store of the Moonkale editor: replaying 130 commits of Lenticulum.jl and 471 of Moonkale gives 0 differences from a fresh build",
  "Julia, Rust and Python read through the normaliser shared with Moonkale, so a definition has the same id in both tools",
]
const limits = [
  "Nothing runs or compiles yet: no interpreter, no lowering through MLIR or LLVM",
  "Equivalence edges are designed, not built",
  "Sophia stores proofs and walks their references; it does not check them",
  "A store is about ten times the size of its source, most of it derivable",
  "Open risks, written down: reading a compiler's state back from a database may cost more than recomputing it; a normaliser that is too coarse would merge different programs silently; Julia has no formal semantics for cross-language claims to rest on",
]
const next = [
  { text: "An MCP server, so agents can query the store (M3b)", href: links.milestones },
  { text: "Running code: an interpreter, dispatch facts, cached test results (M4)", href: links.milestones },
  { text: "Compiling through LLVM to minimal binaries (M5)", href: links.milestones },
  { text: "Lenticulum models stored, and compiled, in Sophia", href: "/projects/lenticulum-jl" },
]

const audiences = [
  { who: "New to the idea", start: "The Original Idea → Design Overview", href: note("vault/The-Original-Idea") },
  { who: "From programming languages", start: "Hashing and Identity → Core Calculus → Naming and Change Propagation", href: links.hashing },
  { who: "From databases", start: "The query language (SPEC-007) → Database Comparison", href: links.query },
  { who: "From proofs and formal methods", start: "Equivalence and Witnesses → Metamath in Sophia", href: links.equivalence },
  { who: "From category theory", start: "Track F of the CT-ML wiki: categorical semantics, e-graphs, Datalog", href: "https://mathstruct.org/CategoryTheory-ML-Wiki/Start-Here" },
  { who: "Sceptical", start: "Open Problems and Risks: what could sink this", href: links.risks },
]

const build = `git clone https://github.com/MathStruct/Sophia && cd Sophia
nix develop                                     # Rust, sqlite3, metamath, Julia
cargo test --workspace
cargo run -p sophia-cli -- sample               # a sample program into .sophia/store.sqlite
cargo run -p sophia-cli -- text sample.add      # printed Julia-flavoured
cargo run -p sophia-cli -- profile rust         # the same code, Rust-flavoured`

const query = `query transitive_dependants(target::Id)
    # direct and transitive users of \`target\`
    dep(a, b) = refs(a, b)
    dep(a, c) = refs(a, b) && dep(b, c)
    select a where dep(a, target)
end

select k, count(d) where def(d, k)

# names under core. that nothing refers to
select p where name(p, d) && startswith(p, "core.") && !refs(_, d)`

const axioms = ["ax-mp", "ax-1", "ax-2", "ax-3", "ax-4", "ax-5", "ax-6", "ax-7", "ax-8", "ax-9", "ax-gen", "ax-ext", "ax-1cn", "ax-addcl", "ax-addass"]
---

<Layout
  title="Sophia: code, keyed by its structure · MathStruct"
  description="Sophia stores code by its structure: every definition under the hash of its normalised form, names as labels, tests and proofs as facts attached to it, and a query language over all of it. An open research project, in Rust."
  path="/projects/sophia"
>
  <Nav />

  <main>
    <!-- ------------------------------------------------------------------ hero -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <a class="crumb mono reveal" href="/#projects">← Projects · Code</a>
          <h1 class="reveal popover-hint" style="--d:.05s">
            Code, keyed<br /><span class="serif">by its structure.</span>
          </h1>
          <p class="lede reveal popover-hint" style="--d:.1s">
            A file system knows code as text at a path. <strong>Sophia</strong> stores every
            definition under the hash of its normalised structure: rename it, reformat it, print it in
            another syntax, and it keeps its id; change what it computes, and it gets a new one. Names
            become labels, tests and proofs become facts attached to the code, and every question
            about the code is a query.
          </p>
          <div class="cta reveal" style="--d:.16s">
            <a class="btn btn--solid" href="#try">Try the idea <span class="arrow">→</span></a>
            <a class="btn" href={links.vault}>Read the vault</a>
            <a class="btn" href={links.source}>Source on GitHub</a>
          </div>
          <ul class="facts mono reveal" style="--d:.2s">
            <li>Rust</li>
            <li>MIT licence</li>
            <li>Early research</li>
            <li>v0.1.12</li>
            <li><a href="/projects/moonkale">Moonkale's code store</a></li>
          </ul>
        </div>
        <figure class="hero-art reveal" style="--d:.1s">
          <ContentId mode="cycle" />
          <figcaption class="mono">
            one definition, rewritten · the id changes only when the computation does
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ----------------------------------------------------------- try it -->
    <section class="section" id="try">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Try it</span>
            <h2 class="reveal" style="--d:.05s">Same code, <span class="serif">same id.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            Two definitions, each normalised and hashed in your browser. Pick an example or edit
            either side, and watch what reaches the id and what does not. Swapping the operands is
            the instructive one.
          </p>
        </div>
        <div class="try reveal">
          <ContentId mode="interactive" />
        </div>
        <p class="fineprint mono">
          A toy, written for this page: one-line arithmetic definitions, normalised the way Sophia
          normalises (names out, parameters as positions, layout and comments gone, structure and
          operand order kept) and hashed with SHA-256. Sophia's normalisers read full languages,
          refer to other definitions by their ids rather than their names, and hash with BLAKE3.
        </p>
      </div>
    </section>

    <!-- ------------------------------------------------------- how it works -->
    <section class="section" id="how">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">How it works</span>
            <h2 class="reveal" style="--d:.05s">Four ideas, <span class="serif">one store.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            The first two are borrowed from <a href="https://www.unison-lang.org/">Unison</a>, which
            content-addresses code by its syntax tree, and are known to work. The last is new, and
            is the part most likely to fail.
          </p>
        </div>
        <HowItWorks />
      </div>
    </section>

    <!-- ------------------------------------------------------------ ladder -->
    <section class="section" id="ladder">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">The novel part</span>
            <h2 class="reveal" style="--d:.05s">Same, <span class="serif">but how sure?</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            Code from different languages is meant to work together not through a foreign-function
            interface, but through stored claims that two definitions are equivalent. A claim is only
            as good as its evidence, so every equivalence edge carries a level, and only the top four
            let the compiler substitute one definition for the other.
          </p>
        </div>
        <div class="table-wrap reveal">
          <table class="compare">
            <thead>
              <tr><th>level</th><th>means</th><th>decided by</th><th>substitutable</th></tr>
            </thead>
            <tbody>
              {ladder.map(([k, means, by, sub]) => (
                <tr class:list={{ weak: !sub }}>
                  <th scope="row">{k}</th>
                  <td>{means}</td>
                  <td>{by}</td>
                  <td class="mono">{sub ? "yes" : "only by explicit policy"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="aside-grid">
          <p class="reveal">
            <strong>Most equivalence is free.</strong> Two definitions that normalise to the same term
            get the same hash: one node, no edge, nothing to prove.
          </p>
          <p class="reveal" style="--d:.06s">
            <strong>No claim is absolute.</strong> Each edge names what it ignores: allocations,
            timing, floating-point reassociation, which exception is thrown. Chaining claims unions
            these, so chains are kept short.
          </p>
          <p class="reveal" style="--d:.12s">
            <strong>Designed, not built.</strong> This is the riskiest of Sophia's claims, and the
            vault <a href={links.risks}>says why</a>: few people will write proofs, so most edges in
            practice would be tested or asserted.
          </p>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------ layers -->
    <section class="section layers" id="layers">
      <div class="wrap layers-grid">
        <div>
          <span class="eyebrow reveal">Where it is going</span>
          <h2 class="reveal" style="--d:.05s">Many languages, <span class="serif">one core.</span></h2>
          <p class="lede reveal" style="--d:.1s">
            Source languages are to be elaborated into one small core calculus, and the core lowered
            through MLIR to LLVM IR. Every arrow in the picture is a stored relation, not a step
            inside a compiler process: run it twice on the same input and nothing new is written.
            A compiler becomes a set of queries over the store.
          </p>
          <p class="lede reveal" style="--d:.14s">
            Today languages are read up to their content ids; support is stated
            <a href={links.languages}>by level, per language</a>, each level with the tests behind
            it, never as a percentage of code that got an id.
          </p>
        </div>
        <figure class="layers-art reveal" style="--d:.1s" aria-label="Julia, Rust, Python and sophialang flow into the sophialang core, which lowers to MLIR, then LLVM IR, then machine code; sophialang's arrow is solid, the others are planned">
          <svg viewBox="0 0 400 330">
            <g class="lang">
              <rect x="6" y="8" width="88" height="34" rx="8"></rect><text x="50" y="30">Julia</text>
              <rect x="106" y="8" width="88" height="34" rx="8"></rect><text x="150" y="30">Rust</text>
              <rect x="206" y="8" width="88" height="34" rx="8"></rect><text x="250" y="30">Python</text>
              <rect class="solid-box" x="306" y="8" width="88" height="34" rx="8"></rect><text x="350" y="30">sophialang</text>
            </g>
            <path class="plan" d="M50 42 C 50 80, 170 74, 186 100"></path>
            <path class="plan" d="M150 42 C 150 70, 190 78, 196 100"></path>
            <path class="plan" d="M250 42 C 250 70, 210 78, 204 100"></path>
            <path class="done" d="M350 42 C 350 80, 230 74, 214 100"></path>
            <rect class="core" x="120" y="100" width="160" height="40" rx="10"></rect>
            <text class="core-t" x="200" y="125">sophialang core</text>
            <path class="plan" d="M200 140 V178"></path>
            <rect class="later" x="140" y="178" width="120" height="34" rx="8"></rect><text x="200" y="200">MLIR</text>
            <path class="plan" d="M200 212 V240"></path>
            <rect class="later" x="140" y="240" width="120" height="34" rx="8"></rect><text x="200" y="262">LLVM IR</text>
            <path class="plan" d="M200 274 V296"></path>
            <text class="mc" x="200" y="316">machine code</text>
            <g class="legend">
              <path class="done" d="M6 296 H34"></path><text x="40" y="300">works</text>
              <path class="plan" d="M6 316 H34"></path><text x="40" y="320">planned</text>
            </g>
          </svg>
        </figure>
      </div>
      <div class="wrap">
        <div class="table-wrap reveal">
          <table class="compare levels">
            <thead>
              <tr>
                <th>language</th>
                {levels.map((l, i) => <th class="lv">L{i + 1} {l}</th>)}
                <th class="lv-note"></th>
              </tr>
            </thead>
            <tbody>
              {support.map((s) => (
                <tr>
                  <th scope="row">{s.lang}</th>
                  {s.cells.map((c) => {
                    const v = c === "●" ? "yes" : c === "◐" ? "partly" : "no"
                    return <td class="dot"><span class={`lv-dot lv-dot--${v}`} role="img" aria-label={v}></span></td>
                  })}
                  <td class="lv-note">{s.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fineprint mono"><span class="lv-dot lv-dot--yes"></span> yes · <span class="lv-dot lv-dot--partly"></span> partly · <span class="lv-dot lv-dot--no"></span> no. From Sophia's README and Languages note, 2026-11-21.</p>
      </div>
    </section>

    <!-- ------------------------------------------------------------- query -->
    <section class="section" id="query">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Ask the store</span>
            <h2 class="reveal" style="--d:.05s">Questions <span class="serif">as queries.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            Sophia has its own query language: Datalog, with a Julia-flavoured syntax. A query is
            itself stored as a definition with a content id, and a result is identified by the query,
            a snapshot of the store and its parameters. It runs natively on every backend, and as
            translated SQL on SQLite.
          </p>
        </div>
        <div class="query-grid">
          <figure class="code reveal">
            <figcaption class="mono">Sophia's query language · examples from its specification</figcaption>
            <pre><code>{query}</code></pre>
          </figure>
          <article class="result reveal" style="--d:.08s">
            <span class="eyebrow">On a real corpus</span>
            <h3>
              What does <span class="serif">2 + 2 = 4</span> rest on?
            </h3>
            <p>
              Metamath's set.mm proves arithmetic from axioms. Read into Sophia, the question is a
              closure over the proof's references. The answer: 15 axioms and 29 definitions.
            </p>
            <ul class="pkgs mono">{axioms.map((a) => <li>{a}</li>)}</ul>
            <p class="small">
              Asked for every theorem of set.mm and iset.mm, 64 566 of them, Sophia's answer agrees
              with metamath.exe's on every one.
            </p>
            <a class="more" href={links.metamath}>Metamath in Sophia <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------ status -->
    <section class="section" id="status">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Where it stands</span>
            <h2 class="reveal" style="--d:.05s">An experiment, <span class="serif">said so.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            The store runs, with tests and benchmarks, and an editor depends on it. Everything past
            the query language is design. Whether sophialang can meet all of its specifications is
            still to be found out.
          </p>
        </div>
        <ol class="road reveal">
          {milestones.map((m) => (
            <li class:list={["mile", { done: m.state === "done", partial: m.state === "first form" }]}>
              <span class="mile-dot" aria-hidden="true"></span>
              <span class="mile-id mono">{m.id}</span>
              <span class="mile-t">{m.title}</span>
              <span class="mile-s mono">{m.state || "open"}</span>
            </li>
          ))}
        </ol>
        <div class="status">
          <div class="col reveal">
            <h3 class="col-h mono">Works today</h3>
            <ul class="ticks">{works.map((w) => <li>{w}</li>)}</ul>
          </div>
          <div class="col reveal" style="--d:.06s">
            <h3 class="col-h mono">Known limits</h3>
            <ul class="ticks ticks--limit">{limits.map((w) => <li>{w}</li>)}</ul>
          </div>
          <div class="col reveal" style="--d:.12s">
            <h3 class="col-h mono">Next, planned</h3>
            <ul class="ticks ticks--next">{next.map((n) => <li><a href={n.href}>{n.text}</a></li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------- get started -->
    <section class="section" id="get-started">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">Get started</span>
            <h2 class="reveal" style="--d:.05s">Read first, <span class="serif">then build.</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            The repository is an Obsidian vault: every Rust file has a note of the same name
            explaining it, next to the requirements, specifications, decisions and benchmarks. The
            <a href={links.vault}>whole vault is online</a>.
          </p>
        </div>
        <div class="code-grid">
          <figure class="code reveal">
            <figcaption class="mono">Build and try the CLI · tools from flake.nix</figcaption>
            <pre><code>{build}</code></pre>
          </figure>
        </div>

        <h3 class="sub reveal">Where to start, by background</h3>
        <ul class="audiences">
          {audiences.map((a, i) => (
            <li class="reveal" style={`--d:${0.04 * i}s`}>
              <a href={a.href}>
                <span class="who">{a.who}</span>
                <span class="start">{a.start}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ---------------------------------------------------------- together -->
    <section class="cite-band">
      <div class="wrap cite-grid">
        <div>
          <span class="eyebrow reveal">Feedback welcome</span>
          <h2 class="reveal" style="--d:.05s">Disagree, <span class="serif">and migrate.</span></h2>
          <p class="reveal" style="--d:.1s">
            The store is content-addressed, so it does not have to be trusted: any node can be checked
            again by hashing it again. And if you dislike the schema, write a different normaliser and
            migrate the store to it: a supported operation, not a fork. If you have thoughts on an
            undertaking like this one, send a message, or read
            <a href={links.contributing}>CONTRIBUTING.md</a>.
          </p>
          <div class="cta reveal" style="--d:.14s">
            <a class="btn btn--solid" href={links.status}>Current status <span class="arrow">→</span></a>
            <a class="btn" href={links.source}>Source on GitHub</a>
          </div>
          <p class="sister reveal" style="--d:.18s">
            Please don't train any AI on this project's material.
          </p>
        </div>
        <div class="siblings">
          <a class="sib reveal" href="/projects/moonkale" style="--d:.06s">
            <span class="mono sib-k">Interface · uses Sophia today</span>
            <span class="sib-t">Moonkale</span>
            <span class="sib-d">The graph-native editor. Sophia is its code-graph store, one store per folder, with the same content ids in both tools.</span>
          </a>
          <a class="sib reveal" href="/projects/lenticulum-jl" style="--d:.12s">
            <span class="mono sib-k">Models · later</span>
            <span class="sib-t">Lenticulum.jl</span>
            <span class="sib-d">Relations learned on factor graphs. Sophia is to store its models, and later compile them.</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ---------------------------------------------------------------- hero */
  .hero {
    padding: clamp(32px, 6vw, 72px) 0 clamp(56px, 8vw, 96px);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: -68px 0 0 0;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 65% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 65% 40%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .crumb {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .crumb:hover {
    color: var(--fg);
  }
  h1 {
