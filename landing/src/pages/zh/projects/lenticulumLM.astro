---
// /zh/projects/lenticulumLM：LenticulumLM 推广页的中文版，与 ../../projects/lenticulumLM.astro
// 保持一致；链接指向中文页面（尚无中文版的保持英文链接）。
import Layout from "../../../layouts/Layout.astro"
import Nav from "../../../components/Nav.astro"
import Footer from "../../../components/Footer.astro"
import IsamText from "../../../components/lenticulum-lm/IsamText.astro"
import DenoiseFront from "../../../components/lenticulum-lm/DenoiseFront.astro"
import QueryDepth from "../../../components/lenticulum-lm/QueryDepth.astro"

const links = {
  vault: "https://mathstruct.org/LenticulumLM/",
  discussions: "https://github.com/MathStruct/MathStruct.github.io/discussions",
  lenticulum: "/zh/projects/lenticulum-jl",
  sophia: "/zh/projects/sophia",
  moonkale: "/zh/projects/moonkale",
  lmNote: "https://mathstruct.org/Lenticulum.jl/Parked/Applications/Language-Models",
  dynamic: "https://mathstruct.org/Lenticulum.jl/Gaussian-Graphs/Dynamic-Graphs",
  beliefs: "https://mathstruct.org/Lenticulum.jl/Gaussian-Graphs/Beliefs",
  isam2: "https://doi.org/10.1177/0278364911430419",
}

// ------------------------------------------------------------- 首屏示意图
// 许多小因子，一句话穿行其间，以及它发出的消息
let seed = 3
const rnd = () => {
  seed = (seed * 16807) % 2147483647
  return seed / 2147483647
}
const HW = 560
const HH = 460
const field: [number, number][] = []
for (let k = 0; field.length < 150 && k < 9000; k++) {
  const x = 14 + rnd() * (HW - 28)
  const y = 14 + rnd() * (HH - 28)
  if (field.every(([a, b]) => (a - x) ** 2 + (b - y) ** 2 > 30 ** 2)) field.push([x, y])
}
const words = ["every", "prime", "p", "is", "odd", "since", "2∣p", "▓▓", "░░"]
const path = words.map((w, i) => {
  const x = 46 + i * ((HW - 92) / (words.length - 1))
  const y = 250 + 46 * Math.sin(i * 0.8 + 0.4)
  return { w, x, y, noise: Math.max(0, (i - 5) / 3) }
})
// 每个词触达离它最近的因子
const reach = path.flatMap((p, i) =>
  field
    .map(([x, y], j) => ({ j, d: (x - p.x) ** 2 + (y - p.y) ** 2 }))
    .sort((a, b) => a.d - b.d)
    .slice(0, i < 7 ? 4 : 2)
    .map(({ j }) => ({ i, j })),
)
const hot = new Set(reach.map((r) => r.j))
const fieldEdges: [number, number][] = []
field.forEach(([x, y], i) => {
  field.forEach(([a, b], j) => {
    if (j > i && (a - x) ** 2 + (b - y) ** 2 < 52 ** 2) fieldEdges.push([i, j])
  })
})

// ---------------------------------------------------------------- 核心主张
const compare: [string, string, string][] = [
  ["模型是什么", "一个固定的函数：一个检查点里的几十亿参数", "成千上万个小型关系（因子）构成的图，保存在存储里"],
  ["增添知识", "微调或重训网络，或把它粘进提示词", "追加因子，只训练这些因子，对照它周围的图"],
  ["移除知识", "没有可靠的办法：机器遗忘是公开难题", "删掉因子：它的贡献随之消失"],
  ["生成文本", "从左到右，每次前向计算提交一个词元", "在任意位置去噪信念；一个词元在安定之前始终可修改"],
  ["一次查询的代价", "同样长度的查询代价相同", "由查询触及的图的那部分决定"],
  ["不确定性", "下一个词元上的 softmax", "每个位置上都有信念；自由能说明因子间分歧多大"],
  ["硬约束", "遮蔽 logits，或事后检查输出", "图中的约束因子：一个语法、一个类型检查器、一个 Lean 4 内核"],
  ["工具、检索、代理循环", "模型之外的代码（脚手架）", "图内的变量与因子，与其余部分一样可编辑"],
  ["为什么是这个答案？", "事后归因", "逐因子的能量：哪些因子往哪里拉"],
  ["方向", "提示 → 续写", "任意：续写、补空、由结论反推前提"],
]

const slam: [string, string][] = [
  ["机器人的位姿 xₜ", "位置 t 的状态：其词元上的一个信念"],
  ["两个位姿间的里程计因子", "相邻位置之间的局部语言关系"],
  ["一个路标", "一条事实、一个定义、存储里的一份文档"],
  ["一次回环检测", "一处回指：一个名字、一个变量、先前做出的断言"],
  ["一次 GPS 修正、一个全局约束", "覆盖一段文本的校验器：Lean 4、类型检查器、一个测试"],
  ["边际协方差", "一个位置有多安定：它的噪声水平"],
  ["iSAM2 的增量更新", "下一个词元：只重新求解新因子触及的部分"],
  ["重新线性化", "新证据说早先的词元错了时，修改它"],
]

const blocks = [
  { k: "因子", t: "小型关系学习器", d: "Lenticulum.jl 的扩散模型与 EnergyNetworks、n-gram 窗口、小型网络。每一个都是关系，可向任意方向查询。" },
  { k: "信念", t: "每个位置上都有信念", d: "词元上的类别分布、嵌入上的高斯、被钉住位置的点质量、多种读法并存的混合。" },
  { k: "信念代数", t: "连线", d: "合并两个信念是它们密度的乘积；对词元是逐元素乘积。消息能精确处精确，不能精确处标注为近似。" },
  { k: "存储", t: "因子放进 Sophia", d: "内容寻址：一个因子以结构的哈希为键、有版本，只在查询触及它时才加载。" },
  { k: "校验器", t: "DSL 即因子", d: "Lean 4 内核、类型检查器、SQL 引擎、JSON schema：硬因子，在其管辖范围内精确。" },
  { k: "学习", t: "沿图训练", d: "知识图与代码图给出结构。一条新事实或一个新库版本就是一个新因子，就地训练。" },
  { k: "脚手架", t: "代理循环放进图里", d: "检索、工具调用、计划与检查都是子图，像模型的其他部分一样在 Moonkale 里编辑。" },
  { k: "预算", t: "随时可停的推断", d: "自由能量度分歧：低则停，高则够得更远，持续高则弃答。" },
]

const exists = [
  { text: "Lenticulum.jl：因子图、消息传递与自由能，均与解析形式核对", href: links.lenticulum },
  { text: "扩散模型与 EnergyNetworks 作为关系使用，通过求根向任意方向查询", href: links.lenticulum },
  { text: "信念代数，含类别信念及其精确乘积", href: links.beliefs },
  { text: "Sophia：带 Datalog 查询语言的内容寻址代码存储", href: links.sophia },
  { text: "Moonkale：图原生编辑器，带审批门槛后的 LLM 代理", href: links.moonkale },
]
const missing = [
  "LenticulumLM 本身：没有分词器、没有语言因子、没有训练好的模型",
  "因子保存在存储中、查询触及时才加载（Lenticulum.jl 待办 O1–O5）",
  "追加后复用分解的增量推断（待办 I10）",
  "类别信念的 GPU 路径；校验器因子；作为图的脚手架",
]
const open = [
  "扩散模型的分数相加只在 t = 0 处采样到它们的乘积；沿轨迹需要一个修正，如每个噪声层各做一次 MCMC（Du 等，2023）",
  "专家乘积难以采样，且一致性倾向于选出平淡的文本",
  "有环图上的消息传递未必收敛；调度表很要紧",
  "核心赌注尚无测量：同等算力下，许多小因子能否在一个大网络上比拼流畅性",
]

const roadmap = [
  { n: "01", t: "n-gram 链", d: "由分隔符连接的窗口关系，向任意方向查询都精确。是最小的一个诚实的因子图语言模型。" },
  { n: "02", t: "下一个词元即一次追加", d: "生成即增量平滑：每个词元追加因子，只有它们触及的部分被重新求解。" },
  { n: "03", t: "图背后的存储", d: "因子放进 Sophia，查询触及时惰性加载；在加载出的子图上训练，参数写回。" },
  { n: "04", t: "跨区段去噪", d: "覆盖位置区段的扩散与能量因子；多个位置同时去噪；每步一个序列级能量。" },
  { n: "05", t: "校验器入环", d: "Lean 4 与类型检查器作为硬因子，它们覆盖的部分出来时就是检查过的。" },
  { n: "06", t: "脚手架进图", d: "检索、工具与代理循环作为 Moonkale 里可编辑的子图；在同等算力下与变换器做基准对比。" },
]
---

<Layout
  title="LenticulumLM：可以编辑的语言模型 · MathStruct"
  description="LenticulumLM 是一个计划中的语言模型：由成千上万个小模型组成的因子图，用信念代数连线；文本生成即增量平滑，如 iSAM2 之于 SLAM；知识作为因子增删；Lean 4 等校验器在模型之内；代价由查询深度决定。尚未实现。"
  path="/zh/projects/lenticulumLM"
  lang="zh"
>
  <Nav />

  <main>
    <!-- ------------------------------------------------------------------ hero -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <a class="crumb mono reveal" href="/zh/#projects">← 项目 · 模型</a>
          <h1 class="reveal" style="--d:.05s">
            一个可以<br /><span class="serif">编辑的语言模型。</span>
          </h1>
          <p class="lede reveal" style="--d:.1s">
            变换器是一个冻住的函数。<strong>LenticulumLM</strong> 是一个计划中的语言模型，构建为一张<em>因子图</em>：成千上万个各自连接少数几个变量的小模型，由
            <a href={links.lenticulum}>Lenticulum.jl</a> 的信念代数连线。因子从存储里追加、删除、加载。写文本变成机器人学家早已擅长的问题——增量平滑——而一次查询所费的功夫随它触及的深度增长。
          </p>
          <div class="cta reveal" style="--d:.16s">
            <a class="btn btn--solid" href="#slam">看它如何工作 <span class="arrow">→</span></a>
            <a class="btn" href="#status">如今已有什么</a>
          </div>
          <ul class="facts mono reveal" style="--d:.2s">
            <li>Julia</li>
            <li>基于 Lenticulum.jl · Sophia · Moonkale</li>
            <li class="fact-flag">概念：尚未实现</li>
          </ul>
        </div>
        <figure class="hero-art reveal" style="--d:.1s">
          <svg viewBox={`0 0 ${HW} ${HH}`} aria-label="许多小因子；一句话穿行其间，较早的词已干净，最后的词仍是噪声，每个词与离它最近的因子交换消息">
            <g class="h-mesh">
              {fieldEdges.map(([a, b]) => (
                <line x1={field[a][0]} y1={field[a][1]} x2={field[b][0]} y2={field[b][1]} />
              ))}
            </g>
            <g class="h-reach">
              {reach.map(({ i, j }, k) => (
                <line
                  x1={path[i].x}
                  y1={path[i].y}
                  x2={field[j][0]}
                  y2={field[j][1]}
                  style={`animation-delay:${(-(k * 0.37) % 2.4).toFixed(2)}s`}
                />
              ))}
            </g>
            <g class="h-field">
              {field.map(([x, y], j) => (
                <rect x={x - 4} y={y - 4} width="8" height="8" class={hot.has(j) ? "hot" : ""} />
              ))}
            </g>
            <polyline class="h-path" points={path.map((p) => `${p.x},${p.y}`).join(" ")} />
            <g class="h-words">
              {path.map((p, i) => (
                <g style={`opacity:${(1 - 0.55 * p.noise).toFixed(2)}`}>
                  <circle cx={p.x} cy={p.y} r={7 + 9 * p.noise} class="h-halo" />
                  <circle cx={p.x} cy={p.y} r="6.5" class={p.noise > 0 ? "h-var noisy" : "h-var"} />
                  <text x={p.x} y={p.y + (i % 2 ? 30 : -18)}>{p.w}</text>
                </g>
              ))}
            </g>
          </svg>
          <figcaption class="mono">
            方块是小模型 · 圆是文本中的位置 · 较早的词已安定，较新的仍是噪声
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ------------------------------------------------------------ compare -->
    <section class="section" id="difference">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">不同之处</span>
            <h2 class="reveal" style="--d:.05s">不是一个网络，<span class="serif">而是一张小网络的图。</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            用统计的话说：变换器是拟合一次的单一条件分布。LenticulumLM 是一个<em>概率图模型</em>，其因子是习得的关系，其结构在运行中变化，生成即推断。逐行看这改变了什么：
          </p>
        </div>
        <div class="table-wrap reveal">
          <table class="compare vs">
            <thead>
              <tr><th></th><th>变换器 LLM</th><th>LenticulumLM，目标</th></tr>
            </thead>
            <tbody>
              {compare.map(([k, a, b]) => (
                <tr><th scope="row">{k}</th><td class="them">{a}</td><td>{b}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- --------------------------------------------------------------- slam -->
    <section class="section" id="slam">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">生成即 SLAM</span>
            <h2 class="reveal" style="--d:.05s">写作是<span class="serif">边走边建图。</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            做 SLAM 的机器人维护一张“到过哪里、见过什么”的因子图，每走一步都往里加。<a href={links.isam2}>iSAM2</a>（Kaess 等，2012）让这变得很快：保持图的分解，新因子到来时只重新求解它们触及的变量。生成文本形状相同：每个新词元是一个新位姿，对早先说过的话的回指是一次回环。
          </p>
        </div>
        <div class="reveal">
          <IsamText />
        </div>
        <p class="fineprint mono">
          一个玩具，在你的浏览器里精确求解。光晕是一个小型线性-高斯图的边际标准差，每步重算；重新求解变量的计数是 iSAM2 对按时间消元的图给出的。在 LenticulumLM 中，位置上携带词元信念，因子则是习得的。
        </p>

        <div class="slam-map">
          <div class="slam-copy">
            <h3 class="reveal">对照表</h3>
            <p class="reveal" style="--d:.05s">
              SLAM 的每一件东西在文本里都有对应物。Lenticulum.jl 以
              <a class="il" href="https://gtsam.org/">GTSAM</a> 为师而建，它关于
              <a class="il" href={links.dynamic}>动态图</a>的笔记已计划让追加只触及最新的因子，对 SLAM 与下一个词元预测一视同仁（待办 I10、O4）。
            </p>
          </div>
          <div class="table-wrap reveal" style="--d:.08s">
            <table class="compare">
              <thead>
                <tr><th>SLAM 里</th><th>LenticulumLM 里</th></tr>
              </thead>
              <tbody>
                {slam.map(([a, b]) => (
                  <tr><th scope="row">{a}</th><td>{b}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------ denoise -->
    <section class="section" id="denoise">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">去噪</span>
            <h2 class="reveal" style="--d:.05s">会安定的文本，<span class="serif">而非一锤定音的文本。</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            因子可以是扩散模型或能量网络，两者 Lenticulum.jl 都已能作为关系查询。用它们读生成有两种方式。作为<em>流</em>：较早的词元噪声小、较新的大，一道锋面向前推进。或作为<em>图</em>：许多位置同时去噪，只要图知道得够多。
          </p>
        </div>
        <div class="reveal">
          <DenoiseFront />
        </div>
        <p class="fineprint mono">
          一段画在你浏览器里的调度，不是一个模型。流的读法接近滚动扩散（Ruhe 等，2024）与 diffusion forcing（Chen 等，2024）；掩码扩散语言模型（LLaDA、MDLM、SEDD）同时去噪所有位置。图的读法让结构决定哪些位置先走。
        </p>
      </div>
    </section>

    <!-- -------------------------------------------------------------- depth -->
    <section class="section" id="depth">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">查询深度即模型大小</span>
            <h2 class="reveal" style="--d:.05s">问什么，<span class="serif">付什么。</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            变换器对每个词元都跑全部权重，无论问题是算术还是证明。这里一次查询钉住它提到的变量，只加载经未定部分与它们相连的因子。浅问题触及几十个因子；深问题伸进存储深处。就这次查询而言，模型的大小就是查询触及的远近。
          </p>
        </div>
        <div class="reveal">
          <QueryDepth />
        </div>
        <p class="fineprint mono">
          一张几百个因子的随机图，构建时画出。预设是示意性的深度，不是测量。在库里，这是查询从钉住的变量经 d-分离触及的子图，调度表限定其中（Lenticulum.jl 待办 O4）。
        </p>
      </div>
    </section>

    <!-- ------------------------------------------------------------- verify -->
    <section class="section north" id="verified">
      <div class="wrap north-grid">
        <div>
          <span class="eyebrow reveal">经过校验的输出</span>
          <h2 class="reveal" style="--d:.05s">校验器<span class="serif">也只是一个因子。</span></h2>
          <p class="lede reveal" style="--d:.1s">
            任何带校验器的语言都可以作为因子在模型内运行：Lean 4、类型检查器、SQL 引擎、JSON schema、单位制。对图而言，校验器是它覆盖位置上的硬约束，与习得的因子经同一套信念代数结合。模型仍可能提出错的东西，但在校验器覆盖的部分，错的东西出不来。
          </p>
          <ul class="ticks reveal" style="--d:.14s">
            <li><span>受限解码早已用语法遮蔽 logits。那不过是一个类别信念与硬因子的结合，做得零散。在这里它是通则。</span></li>
            <li><span>工具结果（编译器裁定、查询结果、检索到的文档）是被钉住的变量，其余围绕它推断。</span></li>
            <li><span>Lenticulum.jl 把每个信念标为精确或近似。检查过的区段标精确；其余的都自称不精确。</span></li>
          </ul>
        </div>
        <figure class="code reveal" style="--d:.08s">
          <figcaption class="mono">设想的 API 草图 · 这些都还不存在</figcaption>
          <pre><code><span class="c"># 模型是一张图，背后是一个存储</span>
g = LMGraph(store = Sophia("factors"))

<span class="c"># 提示词被钉住</span>
prompt!(g, "Lemma: every prime p > 2 is odd.")

<span class="c"># 检索到的事实成为因子</span>
attach!(g, Retrieve(kind = :theorem, k = 8))

<span class="c"># 一个硬因子：内核必须接受</span>
attach!(g, LeanFactor(span = :proof))

<span class="c"># 去噪直到自由能足够低，</span>
<span class="c"># 或预算用尽</span>
ans = denoise!(g; budget = :adaptive)

isexact(ans.proof)    <span class="c"># true：检查过</span>
energies(ans)         <span class="c"># 谁往哪里拉</span></code></pre>
        </figure>
      </div>
    </section>

    <!-- ----------------------------------------------------------- learning -->
    <section class="section" id="learning">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">以插入来学习</span>
