// vault/Design/Equivalence and Witnesses.md 的“强度阶梯”
const ladder = [
  ["alpha", "规范化后完全相同", "比较哈希", true],
  ["defeq", "依定义相等，由类型检查器裁定", "内核，经规范化", true],
  ["rewrite", "由一条受信任的重写规则链相连", "从 e-graph 中提取证明", true],
  ["observational", "就声明的观测而言，任何上下文都无法区分", "一个证明项", true],
  ["tested", "在测试套件或性质模糊测试上一致", "运行测试", false],
  ["asserted", "有人断言如此", "一个签名", false],
] as const

// README 的 "Languages" 与 vault/Languages/Languages.md：● 是 · ◐ 部分 · ○ 否
const levels = ["解析", "规范化", "解析引用", "降级", "运行", "已验证"]
const support: { lang: string; cells: string[]; note: string }[] = [
  { lang: "sophialang", cells: ["●", "●", "●", "●", "○", "○"], note: "存储自身的语言；它是核心" },
  { lang: "Sophia 查询", cells: ["●", "●", "●", "●", "●", "○"], note: "跑在四个后端上；由差分测试核对" },
  { lang: "Metamath", cells: ["●", "●", "●", "◐", "○", "◐"], note: "依赖分析与 metamath.exe 核对" },
  { lang: "Julia", cells: ["●", "●", "◐", "○", "○", "○"], note: "模块作用域；与 Julia 自身的方法表 95.1% 一致" },
  { lang: "Python", cells: ["●", "●", "◐", "○", "○", "○"], note: "名字在单文件内解析" },
  { lang: "Rust", cells: ["●", "◐", "◐", "○", "○", "○"], note: "for、match、闭包、while let 与 let-else 被拒绝" },
]

const milestones = [
  { id: "M0", title: "身份", state: "done" },
  { id: "M1", title: "存储", state: "done" },
  { id: "M2", title: "Moonkale 界面", state: "done" },
  { id: "M3a", title: "查询语言", state: "first form" },
  { id: "M3b", title: "面向代理的工具（MCP）", state: "" },
  { id: "M4", title: "运行代码", state: "" },
  { id: "M5", title: "编译到 LLVM", state: "" },
  { id: "M6", title: "自举开始", state: "" },
  { id: "M7", title: "更多语言", state: "" },
]
const zhState: Record<string, string> = { done: "完成", "first form": "初形", "": "未开始" }

const works = [
  "四个数据库后端（SQLite、redb、LMDB、DuckDB）上的内容 id，藏在同一接口之后，附一个一致性测试套件与基准测试",
  "sophialang 可以按 Julia 风格或 Rust 风格打印并解析回来，在两万个随机定义上做过往返测试",
  "自带内容 id 的 Datalog 查询语言，在每个后端上原生运行，在 SQLite 上翻译成 SQL",
  "Moonkale 编辑器的代码存储：重放 Lenticulum.jl 的 130 个提交与 Moonkale 的 471 个提交，与全新构建零差异",
  "Julia、Rust 与 Python 经由与 Moonkale 共享的规范化器读入，同一定义在两个工具中得到同一个 id",
]
const limits = [
  "尚无任何东西能运行或编译：没有解释器，没有经 MLIR 或 LLVM 的降级",
  "等价边是设计出来的，尚未构建",
  "Sophia 存储证明并遍历其引用；它不检查证明",
  "存储约为源码大小的十倍，其中多数是可推导的",
  "已写下公开的风险：从数据库读回编译器状态可能比重新计算更贵；过于粗糙的规范化器会把不同的程序悄悄合并；Julia 没有可供跨语言断言立足的形式语义",
]
const next = [
  { text: "一个 MCP 服务器，让代理能查询存储（M3b）", href: links.milestones },
  { text: "运行代码：解释器、分派事实、缓存的测试结果（M4）", href: links.milestones },
  { text: "经 LLVM 编译出最小二进制（M5）", href: links.milestones },
  { text: "Lenticulum 模型存进 Sophia，并在其中编译", href: "/zh/projects/lenticulum-jl" },
]

const audiences = [
  { who: "初次接触这个想法", start: "The Original Idea → Design Overview", href: note("vault/The-Original-Idea") },
  { who: "来自编程语言", start: "Hashing and Identity → Core Calculus → Naming and Change Propagation", href: links.hashing },
  { who: "来自数据库", start: "查询语言（SPEC-007）→ Database Comparison", href: links.query },
  { who: "来自证明与形式化方法", start: "Equivalence and Witnesses → Metamath in Sophia", href: links.equivalence },
  { who: "来自范畴论", start: "范畴论与机器学习维基的 Track F：范畴语义、e-graph、Datalog", href: "https://mathstruct.org/CategoryTheory-ML-Wiki/Start-Here" },
  { who: "持怀疑态度", start: "Open Problems and Risks：什么可能让这一切沉没", href: links.risks },
]

const build = `git clone https://github.com/MathStruct/Sophia && cd Sophia
nix develop                                     # Rust, sqlite3, metamath, Julia
cargo test --workspace
cargo run -p sophia-cli -- sample               # 示例程序写入 .sophia/store.sqlite
cargo run -p sophia-cli -- text sample.add      # 按 Julia 风格打印
cargo run -p sophia-cli -- profile rust         # 同一段代码，Rust 风格`

const query = `query transitive_dependants(target::Id)
    # target 的直接与间接使用者
    dep(a, b) = refs(a, b)
    dep(a, c) = refs(a, b) && dep(b, c)
    select a where dep(a, target)
end

select k, count(d) where def(d, k)

# core. 之下无任何东西引用的名字
select p where name(p, d) && startswith(p, "core.") && !refs(_, d)`

const axioms = ["ax-mp", "ax-1", "ax-2", "ax-3", "ax-4", "ax-5", "ax-6", "ax-7", "ax-8", "ax-9", "ax-gen", "ax-ext", "ax-1cn", "ax-addcl", "ax-addass"]
---

<Layout
  title="Sophia：以结构为键的代码 · MathStruct"
  description="Sophia 按结构存储代码：每个定义都在其规范化形式的哈希之下，名字是标签，测试与证明是附在代码上的事实，再加上覆盖这一切的查询语言。一个开源研究项目，Rust 实现。"
  path="/zh/projects/sophia"
  lang="zh"
>
  <Nav />

  <main>
    <!-- ------------------------------------------------------------------ hero -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <a class="crumb mono reveal" href="/zh/#projects">← 项目 · 代码</a>
          <h1 class="reveal popover-hint" style="--d:.05s">
            代码，以<br /><span class="serif">结构为键。</span>
          </h1>
          <p class="lede reveal popover-hint" style="--d:.1s">
            文件系统把代码当作路径上的文本。<strong>Sophia</strong> 把每个定义存放在其规范化结构的哈希之下：改名、重排版式、换成另一种语法打印，id 不变；改了它计算的东西，id 就变。名字成了标签，测试与证明成了附在代码上的事实，关于代码的每个问题都是一次查询。
          </p>
          <div class="cta reveal" style="--d:.16s">
            <a class="btn btn--solid" href="#try">试试这个想法 <span class="arrow">→</span></a>
            <a class="btn" href={links.vault}>阅读笔记库</a>
            <a class="btn" href={links.source}>GitHub 源码</a>
          </div>
          <ul class="facts mono reveal" style="--d:.2s">
            <li>Rust</li>
            <li>MIT 许可</li>
            <li>早期研究</li>
            <li>v0.1.12</li>
            <li><a href="/zh/projects/moonkale">Moonkale 的代码存储</a></li>
          </ul>
        </div>
        <figure class="hero-art reveal" style="--d:.1s">
          <ContentId mode="cycle" />
          <figcaption class="mono">
            同一个定义，被改写 · 只有计算变了，id 才变
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ----------------------------------------------------------- try it -->
    <section class="section" id="try">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">试一试</span>
            <h2 class="reveal" style="--d:.05s">同样的代码，<span class="serif">同样的 id。</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            两个定义，各自在你的浏览器里规范化并哈希。选一个示例或编辑任何一边，看看什么会进入 id，什么不会。交换操作数最能说明问题。
          </p>
        </div>
        <div class="try reveal">
          <ContentId mode="interactive" />
        </div>
        <p class="fineprint mono">
          一个为本页写的玩具：单行算术定义，按 Sophia 的方式规范化（名字去掉、参数变位置、版式与注释消失、结构与操作数顺序保留），用 SHA-256 哈希。Sophia 的规范化器读取完整语言、以 id 而非名字引用其他定义、用 BLAKE3 哈希。
        </p>
      </div>
    </section>

    <!-- ------------------------------------------------------- how it works -->
    <section class="section" id="how">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">工作原理</span>
            <h2 class="reveal" style="--d:.05s">四个想法，<span class="serif">一个存储。</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            前两个借自 <a href="https://www.unison-lang.org/">Unison</a>——它按语法树对代码做内容寻址——并被证明可行。最后一个是新的，也是最可能失败的部分。
          </p>
        </div>
        <HowItWorks />
      </div>
    </section>

    <!-- ------------------------------------------------------ why it matters -->
    <section class="section" id="why">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">为什么重要</span>
            <h2 class="reveal" style="--d:.05s">没有边界，<span class="serif">只有一个库。</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            今天的代码被命名空间、仓库和 crate 切割开来。这些边界说明的是代码在哪里写成、如何发布，而不是它计算什么。当一个定义按它是什么被找到时，这些边界就不再是墙。
          </p>
        </div>
        <div class="aside-grid aside-grid--four">
          <p class="reveal">
            <strong>没有任意的边界。</strong>命名空间、仓库、crate 和包都是有些任意的界线：它们决定谁能看到谁、什么必须一起发布。在 Sophia 中，每个定义都以自己的 id 存放在同一个存储里。命名空间只是覆盖其上的一组名字，所以代码可以跨越过去的包边界被复用，无需包装或复制进来。
          </p>
          <p class="reveal" style="--d:.06s">
            <strong>另一种版本与依赖管理。</strong>依赖指向一个 id，而不是一个包加一个版本范围，所以它不会漂移，也不会冲突：一个函数的两个版本就是并存的两个 id。一次发布是一组命名绑定，而一次改动属于补丁、次版本还是主版本，是<a href={links.naming}>由证据推导出来的</a>，而不是人为声明的。
          </p>
          <p class="reveal" style="--d:.12s">
            <strong>对抗 AI 带来的代码膨胀。</strong>编程智能体往往会写一个新的辅助函数，而不是找到已有的那个，于是库里堆满了名字不同、内容相同的副本。在按结构寻址的存储中，完全相同的副本会得到原定义的 id 并与之合并；近似副本则需要下文的等价边。智能体还可以在动手之前先问存储：这个东西是否已经存在（MCP 服务器，M3b，计划中）。
          </p>
          <p class="reveal" style="--d:.18s">
            <strong>复用，而非重写。</strong>AI 让重写别人的代码变得廉价，但重写会丢掉旧代码积累下来的测试、证明和信任。我们的意图正相反：找到已有的库，连同附着在它上面的事实，然后使用它。
          </p>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------ ladder -->
    <section class="section" id="ladder">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">新颖之处</span>
            <h2 class="reveal" style="--d:.05s">相同，<span class="serif">但有多确定？</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            不同语言的代码要协同工作，靠的不是外部函数接口，而是存储起来的“两个定义等价”的断言。断言的可信度取决于它的证据，所以每条等价边都带一个级别，只有最高的四级允许编译器把一个定义替换成另一个。
          </p>
        </div>
        <div class="table-wrap reveal">
          <table class="compare">
            <thead>
              <tr><th>级别</th><th>含义</th><th>由谁裁定</th><th>可替换</th></tr>
            </thead>
            <tbody>
              {ladder.map(([k, means, by, sub]) => (
                <tr class:list={{ weak: !sub }}>
                  <th scope="row">{k}</th>
                  <td>{means}</td>
                  <td>{by}</td>
                  <td class="mono">{sub ? "是" : "仅在显式策略下"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="aside-grid">
          <p class="reveal">
            <strong>多数等价是免费的。</strong>规范化到同一项的两个定义得到同一个哈希：一个节点，没有边，无需证明。
          </p>
          <p class="reveal" style="--d:.06s">
            <strong>没有断言是绝对的。</strong>每条边都写明它忽略了什么：内存分配、时序、浮点重结合、抛出哪个异常。断言链把这些取并集，所以链都保持得很短。
          </p>
          <p class="reveal" style="--d:.12s">
            <strong>设计出来，尚未构建。</strong>这是 Sophia 最冒险的断言，笔记库里<a href={links.risks}>说明了原因</a>：会写证明的人很少，实践中多数边恐怕只是 tested 或 asserted。
          </p>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------ layers -->
    <section class="section layers" id="layers">
      <div class="wrap layers-grid">
        <div>
          <span class="eyebrow reveal">去向</span>
          <h2 class="reveal" style="--d:.05s">多种语言，<span class="serif">一个核心。</span></h2>
          <p class="lede reveal" style="--d:.1s">
            源语言将被精化成一个小小的核心演算，再经 MLIR 降到 LLVM IR。图中的每支箭头都是一条存储起来的关系，而不是编译器进程里的一步：对同一输入跑两遍，不会写入任何新东西。编译器变成一组对存储的查询。
          </p>
          <p class="lede reveal" style="--d:.14s">
            今天，各语言的读取已到内容 id 一级；支持程度<a href={links.languages}>按语言、按级别</a>陈述，每个级别都有背后的测试，绝不以“拿到 id 的代码百分比”来陈述。
          </p>
        </div>
        <figure class="layers-art reveal" style="--d:.1s" aria-label="Julia、Rust、Python 与 sophialang 汇入 sophialang 核心，再降到 MLIR、LLVM IR 与机器码；sophialang 的箭头是实线，其余是计划">
          <svg viewBox="0 0 400 330">
            <g class="lang">
              <rect x="6" y="8" width="88" height="34" rx="8"></rect><text x="50" y="30">Julia</text>
              <rect x="106" y="8" width="88" height="34" rx="8"></rect><text x="150" y="30">Rust</text>
              <rect x="206" y="8" width="88" height="34" rx="8"></rect><text x="250" y="30">Python</text>
              <rect class="solid-box" x="306" y="8" width="88" height="34" rx="8"></rect><text x="350" y="30">sophialang</text>
            </g>
            <path class="plan" d="M50 42 C 50 80, 170 74, 186 100"></path>
            <path class="plan" d="M150 42 C 150 70, 190 78, 196 100"></path>
            <path class="plan" d="M250 42 C 250 70, 210 78, 204 100"></path>
            <path class="done" d="M350 42 C 350 80, 230 74, 214 100"></path>
            <rect class="core" x="120" y="100" width="160" height="40" rx="10"></rect>
            <text class="core-t" x="200" y="125">sophialang 核心</text>
            <path class="plan" d="M200 140 V178"></path>
            <rect class="later" x="140" y="178" width="120" height="34" rx="8"></rect><text x="200" y="200">MLIR</text>
            <path class="plan" d="M200 212 V240"></path>
            <rect class="later" x="140" y="240" width="120" height="34" rx="8"></rect><text x="200" y="262">LLVM IR</text>
            <path class="plan" d="M200 274 V296"></path>
            <text class="mc" x="200" y="316">机器码</text>
            <g class="legend">
              <path class="done" d="M6 296 H34"></path><text x="40" y="300">可用</text>
              <path class="plan" d="M6 316 H34"></path><text x="40" y="320">计划</text>
            </g>
          </svg>
        </figure>
      </div>
      <div class="wrap">
        <div class="table-wrap reveal">
          <table class="compare levels">
            <thead>
              <tr>
                <th>语言</th>
                {levels.map((l, i) => <th class="lv">L{i + 1} {l}</th>)}
                <th class="lv-note"></th>
              </tr>
            </thead>
            <tbody>
              {support.map((s) => (
                <tr>
                  <th scope="row">{s.lang}</th>
                  {s.cells.map((c) => {
                    const v = c === "●" ? "yes" : c === "◐" ? "partly" : "no"
                    return <td class="dot"><span class={`lv-dot lv-dot--${v}`} role="img" aria-label={v}></span></td>
                  })}
                  <td class="lv-note">{s.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fineprint mono"><span class="lv-dot lv-dot--yes"></span> 是 · <span class="lv-dot lv-dot--partly"></span> 部分 · <span class="lv-dot lv-dot--no"></span> 否。取自 Sophia 的 README 与 Languages 笔记，2026-11-21。</p>
      </div>
    </section>

    <!-- ------------------------------------------------------------- query -->
    <section class="section" id="query">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow reveal">询问存储</span>
            <h2 class="reveal" style="--d:.05s">问题<span class="serif">即查询。</span></h2>
          </div>
          <p class="lede reveal" style="--d:.1s">
            Sophia 有自己的查询语言：Datalog，配 Julia 风格的语法。查询本身也作为带内容 id 的定义存储，一个结果由查询、存储快照与参数共同标识。它在每个后端上都原生运行，在 SQLite 上则以翻译出的 SQL 运行。
          </p>
        </div>
        <div class="query-grid">
          <figure class="code reveal">
            <figcaption class="mono">Sophia 的查询语言 · 示例来自其规格说明</figcaption>
            <pre><code>{query}</code></pre>
          </figure>
          <article class="result reveal" style="--d:.08s">
            <span class="eyebrow">在真实语料上</span>
            <h3>
              <span class="serif">2 + 2 = 4</span> 站在什么之上？
            </h3>
            <p>
              Metamath 的 set.mm 从公理证明算术。读入 Sophia 之后，这个问题是对证明引用的一次闭包。答案：15 条公理，29 个定义。
            </p>
